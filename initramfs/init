#!/bin/sh
# PICO 4 Linux POC - /init (PID 1)
#
# Runs from the boot image's ramdisk on top of the stock PICO kernel
# (4.19, Qualcomm downstream). It never writes to the headset's flash: every
# block device is switched to read-only as soon as it shows up.
#
#   1. pseudo filesystems, /dev via mdev (the stock kernel has no devtmpfs)
#   2. logging to kmsg/pstore, status LED, CPU power management
#   3. USB gadget: NCM network 172.16.42.1 (+ read-only log drive)
#   4. hand over to pico4-init, which keeps telnetd/sshd/httpd running

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022

# The stock kernel usually has no console. Point stdio at the kernel log so
# every message lands in dmesg and in pstore's console-ramoops.
exec </dev/null >/dev/kmsg 2>&1

mount -t proc -o nosuid,nodev,noexec proc /proc
mount -t sysfs -o nosuid,nodev,noexec sysfs /sys
mount -t tmpfs -o nosuid,nodev,mode=0755 tmpfs /run
mount -t tmpfs -o nosuid,nodev,mode=1777 tmpfs /tmp
echo on > /proc/sys/kernel/printk_devkmsg 2>/dev/null

. /usr/libexec/pico4-poc/lib.sh
mkdir -p "$POC_RUN"
log "starting on $(uname -r) $(uname -m), cmdline: $(cat /proc/cmdline)"

# -- /dev ---------------------------------------------------------------------
if [ "$(poc_arg devtmpfs 1)" = 1 ] && mount -t devtmpfs -o mode=0755,nosuid devtmpfs /dev 2>/dev/null; then
	log "/dev: devtmpfs"
else
	log "/dev: no devtmpfs in this kernel, populating with mdev"
fi
mkdir -p /dev/pts /dev/shm
mount -t devpts -o gid=5,mode=0620,ptmxmode=0666 devpts /dev/pts
mount -t tmpfs -o nosuid,nodev,mode=1777 tmpfs /dev/shm
[ -e /dev/fd ] || ln -s /proc/self/fd /dev/fd
[ -e /dev/stdin ] || ln -s fd/0 /dev/stdin
[ -e /dev/stdout ] || ln -s fd/1 /dev/stdout
[ -e /dev/stderr ] || ln -s fd/2 /dev/stderr

# Firmware requests fall back to userspace on this kernel; fail them fast
# instead of letting drivers wait 60 s for an Android ueventd that is absent.
echo 5 > /sys/class/firmware/timeout 2>/dev/null
# mdev -d: initial scan + netlink daemon for hotplug (new devices, firmware).
# Block devices go through block-hotplug (read-only + /dev/block/by-name).
mdev -d || { log "mdev -d failed, falling back to a one-shot scan"; mdev -s; }
[ -e /dev/ptmx ] || ln -s pts/ptmx /dev/ptmx

mount -t configfs configfs /sys/kernel/config 2>/dev/null
mount -t pstore pstore /sys/fs/pstore 2>/dev/null
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null

# Belt and braces: anything mdev may have missed becomes read-only too.
"$POC_LIB/block-hotplug" sweep

hostname -F /etc/hostname 2>/dev/null
ip link set lo up 2>/dev/null
led boot

# Kernel modules from the stock first-stage ramdisk, in Android's order.
if [ -f /lib/modules/modules.load ] && [ "$(poc_arg modules 1)" = 1 ]; then
	while read -r m; do
		[ -n "$m" ] || continue
		insmod "/lib/modules/$m" 2>/dev/null || log "insmod $m failed"
	done < /lib/modules/modules.load
fi

# -- USB, power management, probe ---------------------------------------------
"$POC_LIB/usb-gadget" &
"$POC_LIB/power" &
if [ "$(poc_arg probe 1)" = 1 ]; then
	( wait_for "$POC_RUN/usb.done" 120; sleep "$(poc_arg probe_delay 15)"; pico4-probe --boot ) &
fi
if [ "$(poc_arg selftest 0)" = 1 ]; then
	"$POC_LIB/selftest" &
fi
# QEMU userspace test: pico4poc.userspace_payload=<partition>:<bytes>:<sha256>
# unpacks the step-4 userspace from that partition and switches to it.
payload=$(poc_arg userspace_payload "")
if [ -n "$payload" ]; then
	(
		wait_for "$POC_RUN/usb.done" 120
		IFS=: read -r part bytes sha <<-EOF
		$payload
		EOF
		pico4-userspace receive --from "/dev/block/by-name/$part" --bytes "$bytes" --sha256 "$sha" &&
			pico4-userspace switch
	) &
fi

log "handing over to pico4-init"
exec /usr/libexec/pico4-poc/pico4-init
