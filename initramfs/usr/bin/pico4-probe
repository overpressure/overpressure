#!/bin/sh
# pico4-probe - collect a hardware/software inventory of the headset.
#
# Read-only and deliberately conservative: it reads procfs, sysfs and device
# tree data only. Things known to crash Qualcomm devices (debugfs GPIO/clock
# dumps, PCIe config space reads, poking audio DSP mixer controls) are left
# out; run those tools by hand if you need them.
#
# Output: /run/pico4-poc/report/ and /run/pico4-poc/report.tar.gz, also on
# http://172.16.42.1/ and on the USB log drive.
. /usr/libexec/pico4-poc/lib.sh

OUT=$POC_RUN/report
rm -rf "$OUT" "$POC_RUN/probe.done"
mkdir -p "$OUT"

# Progress goes to pstore too, so a crash in the middle can be pinpointed.
step() { log "probe: $1"; }

# run FILE CMD...: append "$ CMD" and its output (30 s timeout) to FILE.
run() {
	local f="$OUT/$1"
	shift
	{
		echo "\$ $*"
		timeout 30 "$@" 2>&1
		echo
	} >> "$f"
}

# attrs FILE GLOB ATTR...: "path: attr=value ..." for every match.
attrs() {
	local f="$OUT/$1" glob=$2 d a v line
	shift 2
	for d in $glob; do
		[ -d "$d" ] || continue
		line="${d}:"
		for a in "$@"; do
			v=$(head -c 300 "$d/$a" 2>/dev/null | tr '\n' ' ')
			[ -n "$v" ] && line="$line $a=$v"
		done
		echo "$line" >> "$f"
	done
}

step "system"
run system.txt uname -a
run system.txt cat /proc/version /proc/cmdline
run system.txt cat /etc/pico4-poc/build-info
run system.txt free -m
run system.txt cat /proc/meminfo
run system.txt uptime
attrs system.txt "/sys/devices/soc0" machine family soc_id revision serial_number hw_platform platform_subtype platform_version foundry_id pmic_model chip_family raw_device_family
cp /proc/config.gz "$OUT/kernel-config.gz" 2>/dev/null

step "cpu"
run cpu.txt cat /proc/cpuinfo
attrs cpu.txt "/sys/devices/system/cpu/cpufreq/policy*" affected_cpus scaling_governor scaling_cur_freq cpuinfo_min_freq cpuinfo_max_freq scaling_available_frequencies
run cpu.txt cat /sys/module/lpm_levels/parameters/sleep_disabled

step "device tree"
cp /sys/firmware/fdt "$OUT/devicetree.dtb" 2>/dev/null
run devicetree.txt cat /proc/device-tree/model
run devicetree.txt sh -c 'tr "\0" " " < /proc/device-tree/compatible'
timeout 60 dtc -q -I dtb -O dts -o "$OUT/devicetree.dts" /sys/firmware/fdt 2>/dev/null

step "kernel state"
dmesg > "$OUT/dmesg.txt" 2>&1
for f in interrupts iomem devices misc filesystems modules mounts swaps partitions; do
	cat "/proc/$f" > "$OUT/proc-$f.txt" 2>&1
done
cat /sys/kernel/debug/devices_deferred > "$OUT/devices-deferred.txt" 2>/dev/null
for d in /sys/bus/platform/devices/*; do
	drv=$(readlink "$d/driver" 2>/dev/null)
	echo "${d##*/} ${drv:+-> ${drv##*/}}"
done > "$OUT/platform-devices.txt"
for b in /sys/bus/*/drivers; do
	echo "== ${b%/drivers}"
	ls "$b"
done > "$OUT/drivers.txt" 2>&1

step "storage"
for d in /sys/class/block/*; do
	n=${d##*/}
	sz=$(cat "$d/size" 2>/dev/null)
	[ "${sz:-0}" -gt 0 ] || continue  # unused loop/nbd/ram devices
	echo "$n size=$(( sz / 2048 ))MiB ro=$(cat "$d/ro" 2>/dev/null) $(grep -E '^(PARTNAME|DEVTYPE)=' "$d/uevent" 2>/dev/null | tr '\n' ' ')"
done > "$OUT/storage.txt"
run storage.txt lsblk -o NAME,SIZE,RO,TYPE,PARTLABEL
attrs storage.txt "/sys/class/scsi_disk/*/device" vendor model rev

step "display"
attrs display.txt "/sys/class/drm/*" status enabled dpms modes
attrs display.txt "/sys/class/backlight/*" brightness max_brightness actual_brightness bl_power
attrs display.txt "/sys/class/graphics/fb*" name modes virtual_size bits_per_pixel
[ -e /dev/dri/card0 ] && run display.txt drm_info

step "input, sensors, hid"
run input.txt cat /proc/bus/input/devices
attrs input.txt "/sys/bus/hid/devices/*" uevent
attrs sensors.txt "/sys/bus/iio/devices/iio:device*" name
attrs sensors.txt "/sys/class/hwmon/hwmon*" name
attrs sensors.txt "/sys/class/sensors/*" name vendor type

step "power, thermal, leds"
attrs power.txt "/sys/class/power_supply/*" uevent
attrs thermal.txt "/sys/class/thermal/thermal_zone*" type temp mode
attrs thermal.txt "/sys/class/thermal/cooling_device*" type cur_state max_state
attrs leds.txt "/sys/class/leds/*" max_brightness brightness trigger

step "usb"
attrs usb.txt "/sys/class/udc/*" state current_speed maximum_speed function
attrs usb.txt "/sys/class/extcon/*" name state
attrs usb.txt "/sys/class/typec/*" data_role power_role orientation
attrs usb.txt "/sys/class/dual_role_usb/*" mode data_role power_role
find /sys/kernel/config/usb_gadget -maxdepth 3 > "$OUT/usb-gadget-tree.txt" 2>/dev/null
run usb.txt lsusb

step "connectivity, multimedia, remote processors"
run net.txt ip addr
attrs net.txt "/sys/class/bluetooth/*" uevent
attrs pci.txt "/sys/bus/pci/devices/*" vendor device class
run sound.txt cat /proc/asound/cards /proc/asound/pcm
attrs video.txt "/sys/class/video4linux/*" name
attrs remoteproc.txt "/sys/class/remoteproc/*" name state firmware
attrs remoteproc.txt "/sys/bus/msm_subsys/devices/*" name state restart_level
attrs gpu.txt "/sys/class/kgsl/kgsl-3d0" gpu_model gpuclk max_gpuclk freq_table_mhz
attrs i2c-spi.txt "/sys/bus/i2c/devices/*" name
attrs i2c-spi.txt "/sys/bus/spi/devices/*" modalias
run firmware.txt cat /sys/module/firmware_class/parameters/path

step "pstore"
if [ -n "$(ls /sys/fs/pstore 2>/dev/null)" ]; then
	mkdir -p "$OUT/pstore"
	cp /sys/fs/pstore/* "$OUT/pstore/" 2>/dev/null
fi

cp "$POC_LOG" "$OUT/boot.log"
for f in "$POC_RUN"/svc-*.log; do
	[ -s "$f" ] && cp "$f" "$OUT/"
done

# Short summary for humans.
{
	echo "model      : $(tr -d '\0' < /proc/device-tree/model 2>/dev/null)"
	echo "kernel     : $(uname -r)"
	echo "soc        : $(cat /sys/devices/soc0/machine 2>/dev/null) id=$(cat /sys/devices/soc0/soc_id 2>/dev/null) rev=$(cat /sys/devices/soc0/revision 2>/dev/null)"
	echo "memory     : $(awk '/MemTotal/ {printf "%d MiB", $2/1024}' /proc/meminfo)"
	echo "cpus       : $(grep -c ^processor /proc/cpuinfo)"
	echo "disks      : $(for d in /sys/block/sd* /sys/block/mmcblk*; do [ -e "$d" ] && printf '%s(%dMiB) ' "${d##*/}" $(( $(cat "$d/size") / 2048 )); done)"
	echo "partitions : $(ls /dev/block/by-name 2>/dev/null | wc -l) named"
	echo "drm        : $(for d in /sys/class/drm/card*-*; do [ -e "$d" ] && printf '%s=%s ' "${d##*/}" "$(cat "$d/status" 2>/dev/null)"; done)"
	echo "framebuffer: $(cat /sys/class/graphics/fb*/name 2>/dev/null | tr '\n' ' ')"
	echo "backlight  : $(ls /sys/class/backlight 2>/dev/null | tr '\n' ' ')"
	echo "leds       : $(ls /sys/class/leds 2>/dev/null | tr '\n' ' ')"
	echo "input      : $(grep '^N: Name=' /proc/bus/input/devices 2>/dev/null | cut -d'"' -f2 | tr '\n' ',' )"
	echo "iio        : $(cat /sys/bus/iio/devices/iio:device*/name 2>/dev/null | tr '\n' ' ')"
	echo "video4linux: $(ls /sys/class/video4linux 2>/dev/null | wc -l) nodes"
	echo "sound      : $(grep -c . /proc/asound/cards 2>/dev/null) lines in /proc/asound/cards"
	echo "battery    : $(cat /sys/class/power_supply/battery/capacity 2>/dev/null)% $(cat /sys/class/power_supply/battery/status 2>/dev/null)"
	echo "gpu        : $(cat /sys/class/kgsl/kgsl-3d0/gpu_model 2>/dev/null)"
	echo "usb        : $(cat /sys/class/udc/*/state 2>/dev/null) $(cat /sys/class/udc/*/current_speed 2>/dev/null)"
	echo "deferred   : $(grep -c . "$OUT/devices-deferred.txt" 2>/dev/null) devices waiting on dependencies"
} > "$OUT/summary.txt" 2>&1

# Index page for the web server.
{
	echo "<!doctype html><meta charset=utf-8><title>pico4-probe report</title><pre>"
	sed 's/&/\&amp;/g; s/</\&lt;/g' "$OUT/summary.txt"
	echo "</pre><ul>"
	for f in "$OUT"/*; do
		n=${f##*/}
		[ "$n" = index.html ] || echo "<li><a href=\"$n\">$n</a></li>"
	done
	echo "</ul>"
} > "$OUT/index.html"

tar -czf "$POC_RUN/report.tar.gz.new" -C "$POC_RUN" report && mv -f "$POC_RUN/report.tar.gz.new" "$POC_RUN/report.tar.gz"
touch "$POC_RUN/probe.done"
step "done, $(du -sk "$OUT" | cut -f1) KiB in $OUT"
"$POC_LIB/logdisk" refresh

[ "$1" = --boot ] || cat "$OUT/summary.txt"
exit 0
