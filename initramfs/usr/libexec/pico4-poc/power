#!/bin/sh
# CPU power management that PICO OS's post-boot script would normally do.
#
# The stock kernel boots with the "performance" cpufreq governor and with deep
# CPU idle states disabled (lpm_levels.sleep_disabled=1 on the command line);
# Android relaxes both once it is up. Without that every core would sit at its
# maximum clock. Knobs: pico4poc.cpugov=<governor|keep>, pico4poc.lpm=0|1.
. /usr/libexec/pico4-poc/lib.sh

gov=$(poc_arg cpugov schedutil)
if [ "$gov" != keep ]; then
	for p in /sys/devices/system/cpu/cpufreq/policy*; do
		[ -e "$p/scaling_governor" ] || continue
		if grep -qw "$gov" "$p/scaling_available_governors" 2>/dev/null; then
			write "$gov" "$p/scaling_governor" && log "cpufreq ${p##*/}: governor $gov"
		else
			log "cpufreq ${p##*/}: governor $gov not available ($(cat "$p/scaling_available_governors" 2>/dev/null))"
		fi
	done
fi

lpm=/sys/module/lpm_levels/parameters/sleep_disabled
if [ "$(poc_arg lpm 1)" = 1 ] && [ -e "$lpm" ]; then
	sleep "$(poc_arg lpm_delay 30)"
	write N "$lpm" && log "CPU low-power idle states enabled"
fi
exit 0
