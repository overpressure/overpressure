#!/bin/sh
# USB gadget for the PICO 4 Linux POC (configfs).
#
#   usb-gadget         set up the gadget and the network (run once by /init)
#   usb-gadget watch   follow the link state: log, status LED, auto-reboot
#
# Functions, first one the kernel provides wins (pico4poc.usbnet / usbserial):
#   network : ncm (built into the stock PICO kernel), rndis, ecm
#   serial  : acm (not in the stock PICO kernel), gser only on request
#   logdisk : read-only FAT drive with boot logs + hardware report, so the
#             logs are reachable even if the PC has no driver for the network
. /usr/libexec/pico4-poc/lib.sh

G=/sys/kernel/config/usb_gadget/pico4
C=$G/configs/c.1

find_udc() {
	local i=0 timeout
	timeout=$(poc_arg udc_timeout 60)
	while [ "$i" -lt "$timeout" ]; do
		if [ -d /sys/kernel/config/usb_gadget ]; then
			UDC=$(ls /sys/class/udc 2>/dev/null | head -n 1)
			[ -n "$UDC" ] && return 0
		fi
		sleep 1
		i=$((i + 1))
	done
	return 1
}

# Stable, locally administered MAC addresses derived from the serial number,
# so the PC sees the same network adapter on every boot.
mac_from() {
	echo "$1" | md5sum | sed "s/^\(..\)\(..\)\(..\)\(..\)\(..\).*/$2:\1:\2:\3:\4:\5/"
}

link_fn() {
	ln -s "$G/functions/$1" "$C/" || { log "could not link function $1"; return 1; }
}

unlink_fn() {
	rm -f "$C/$1" 2>/dev/null
	rmdir "$G/functions/$1" 2>/dev/null
}

bind() {
	echo "$UDC" > "$G/UDC" 2>/dev/null
}

setup() {
	echo starting > "$POC_RUN/usb.state"
	if ! find_udc; then
		log "USB: no device controller (/sys/class/udc) or configfs - giving up"
		echo "no-udc" > "$POC_RUN/usb.state"
		led error
		touch "$POC_RUN/usb.done"
		return 1
	fi
	log "USB: device controller $UDC"

	serial=$(device_serial)
	dev_mac=$(mac_from "$serial" 02)
	host_mac=$(mac_from "$serial" 06)

	mkdir -p "$G" || { log "USB: cannot create gadget"; touch "$POC_RUN/usb.done"; return 1; }
	write 0x1d6b "$G/idVendor"      # Linux Foundation
	write 0x0104 "$G/idProduct"     # Multifunction Composite Gadget
	write 0x0100 "$G/bcdDevice"
	write 0xEF "$G/bDeviceClass"    # composite device with IADs (Windows)
	write 0x02 "$G/bDeviceSubClass"
	write 0x01 "$G/bDeviceProtocol"
	mkdir -p "$G/strings/0x409" "$C/strings/0x409"
	write "$serial" "$G/strings/0x409/serialnumber"
	write "pico4-poc" "$G/strings/0x409/manufacturer"
	write "PICO 4 Linux POC" "$G/strings/0x409/product"
	write "pico4-poc" "$C/strings/0x409/configuration"
	write 500 "$C/MaxPower"

	# -- network ---------------------------------------------------------------
	net_fn=""
	for f in $(poc_arg usbnet ncm,rndis,ecm | tr , ' '); do
		if mkdir "$G/functions/$f.usb0" 2>/dev/null; then
			net_fn=$f.usb0
			break
		fi
		log "USB: no $f function in this kernel"
	done
	use_os_desc=0
	if [ -n "$net_fn" ]; then
		write "$dev_mac" "$G/functions/$net_fn/dev_addr"
		write "$host_mac" "$G/functions/$net_fn/host_addr"
		# Windows only binds RNDIS (and, on newer kernels, NCM) automatically
		# when the function announces itself through MS OS descriptors.
		osd=$G/functions/$net_fn/os_desc
		if [ -d "$osd/interface.rndis" ]; then
			write RNDIS "$osd/interface.rndis/compatible_id" && write 5162001 "$osd/interface.rndis/sub_compatible_id" && use_os_desc=1
		elif [ -d "$osd/interface.ncm" ]; then
			write WINNCM "$osd/interface.ncm/compatible_id" && use_os_desc=1
		fi
		link_fn "$net_fn"
	else
		log "USB: no network function available"
	fi

	# -- read-only log drive -------------------------------------------------
	ms_fn=""
	if [ "$(poc_arg logdisk 1)" = 1 ] && "$POC_LIB/logdisk" build && mkdir "$G/functions/mass_storage.0" 2>/dev/null; then
		lun=$G/functions/mass_storage.0/lun.0
		write 1 "$lun/removable"
		write 1 "$lun/ro"
		write 0 "$lun/cdrom" 2>/dev/null
		write 0 "$lun/nofua" 2>/dev/null
		if write "$POC_RUN/logdisk.img" "$lun/file"; then
			link_fn mass_storage.0 && ms_fn=mass_storage.0
		fi
	fi

	# -- serial shell -------------------------------------------------------------
	ser_fn=""
	for f in $(poc_arg usbserial acm | tr , ' '); do
		[ "$f" = none ] && break
		if mkdir "$G/functions/$f.usb0" 2>/dev/null; then
			ser_fn=$f.usb0
			link_fn "$ser_fn"
			break
		fi
		log "USB: no $f function in this kernel"
	done

	if [ "$use_os_desc" = 1 ]; then
		write 1 "$G/os_desc/use"
		write 0xcd "$G/os_desc/b_vendor_code"
		write MSFT100 "$G/os_desc/qw_sign"
		ln -s "$C" "$G/os_desc/" 2>/dev/null
	fi

	# Bind. If the controller rejects the combination, drop extras one by one.
	if ! bind; then
		log "USB: bind with [$net_fn $ms_fn $ser_fn] failed, retrying without serial"
		[ -n "$ser_fn" ] && unlink_fn "$ser_fn" && ser_fn=""
		if ! bind; then
			log "USB: retrying without the log drive"
			[ -n "$ms_fn" ] && unlink_fn "$ms_fn" && ms_fn=""
			if ! bind; then
				log "USB: binding the gadget to $UDC failed"
				echo "bind-failed" > "$POC_RUN/usb.state"
				led error
				touch "$POC_RUN/usb.done"
				return 1
			fi
		fi
	fi
	log "USB: gadget bound to $UDC with [${net_fn:-no network} ${ms_fn} ${ser_fn}] serial=$serial"
	echo bound > "$POC_RUN/usb.state"
	led waiting

	if [ -n "$ser_fn" ]; then
		port=$(cat "$G/functions/$ser_fn/port_num" 2>/dev/null)
		echo "TTY=ttyGS${port:-0}" > "$POC_RUN/serial.env"
	else
		echo "TTY=" > "$POC_RUN/serial.env"
	fi

	# -- IP configuration -------------------------------------------------------
	if [ -n "$net_fn" ]; then
		iface=$(cat "$G/functions/$net_fn/ifname" 2>/dev/null)
		if [ ! -e "/sys/class/net/$iface" ]; then
			iface=""
			for n in /sys/class/net/usb* /sys/class/net/ncm* /sys/class/net/rndis*; do
				[ -e "$n" ] && iface=${n##*/} && break
			done
		fi
		ip=$(poc_arg ip "$POC_IP")
		host_ip=$(poc_arg host_ip "$POC_HOST_IP")
		if [ -n "$iface" ] && ip addr add "$ip/$POC_PREFIX" dev "$iface" && ip link set "$iface" up; then
			log "USB: network $iface up, headset $ip, PC gets $host_ip via DHCP (dev $dev_mac host $host_mac)"
			{
				echo "IFACE=$iface"
				echo "IP=$ip"
				echo "HOST_IP=$host_ip"
				echo "NETMASK=255.255.255.0"
			} > "$POC_RUN/net.env"
		else
			log "USB: could not configure the network interface (ifname='$iface')"
			echo "IFACE=" > "$POC_RUN/net.env"
		fi
	else
		echo "IFACE=" > "$POC_RUN/net.env"
	fi
	{
		echo "UDC=$UDC"
		echo "NET_FN=$net_fn"
	} > "$POC_RUN/usb.env"
	touch "$POC_RUN/usb.done"
}

# Re-plug the USB device: unbind the gadget from the controller and bind it
# again. This is what Android's init does every time it switches USB
# functions, so it is the best-exercised path on the stock kernel (toggling
# the UDC's soft_connect instead left the QEMU test controller unable to
# enumerate the device at all).
replug() {
	echo "" > "$G/UDC" 2>/dev/null
	sleep 1
	if ! echo "$UDC" > "$G/UDC" 2>/dev/null; then
		log "USB: re-plug: binding to $UDC failed"
		led error
		return 1
	fi
	# The network interface may have been re-created: re-apply the address
	# and restart udhcpd (busybox init respawns it with the new name).
	[ -n "$NET_FN" ] || return 0
	iface=$(cat "$G/functions/$NET_FN/ifname" 2>/dev/null)
	[ -e "/sys/class/net/$iface" ] || return 0
	ip addr add "$IP/$POC_PREFIX" dev "$iface" 2>/dev/null
	ip link set "$iface" up
	if [ "$iface" != "$IFACE" ]; then
		sed -i "s/^IFACE=.*/IFACE=$iface/" "$POC_RUN/net.env"
		IFACE=$iface
	fi
	killall udhcpd 2>/dev/null
	return 0
}

# Follow the controller state. The LED turns green once a PC has configured
# the device. If no PC ever does (no configured state, no network carrier, no
# login) within pico4poc.autoreboot seconds (default 300, 0 = never), reboot
# into fastboot so the headset is not left stranded with a black screen; the
# log survives in pstore.
give_up_later() {
	# USB never came up: nobody can reach the headset, so return to fastboot
	# after the auto-reboot delay unless that is disabled.
	limit=$(poc_arg autoreboot 300)
	[ "$limit" -gt 0 ] || exec sleep 2147483647
	while [ "$(cut -d. -f1 /proc/uptime)" -lt "$limit" ]; do
		sleep 5
	done
	[ -e "$POC_RUN/no-autoreboot" ] && exec sleep 2147483647
	log "USB: setup failed ($(cat "$POC_RUN/usb.state" 2>/dev/null)), rebooting to fastboot (pico4poc.autoreboot=0 disables)"
	sync
	sleep 2
	pico4-reboot bootloader
}

watch() {
	wait_for "$POC_RUN/usb.done"
	. "$POC_RUN/usb.env" 2>/dev/null
	. "$POC_RUN/net.env" 2>/dev/null
	if [ -z "$UDC" ]; then
		give_up_later
		exec sleep 2147483647
	fi
	limit=$(poc_arg autoreboot 300)
	kick_after=$(poc_arg usbkick 20)
	last=""
	seen=0
	kicks=0
	quiet_since=""
	while :; do
		state=$(cat "/sys/class/udc/$UDC/state" 2>/dev/null)
		if [ "$state" != "$last" ]; then
			log "USB: link state $state"
			echo "$state" > "$POC_RUN/usb.link"
			case "$state" in
			configured) led ready; seen=1 ;;
			*) [ "$seen" = 1 ] && led waiting ;;
			esac
			last=$state
		fi
		if [ "$seen" = 0 ]; then
			if [ -e "$POC_RUN/no-autoreboot" ] ||
				[ "$(cat "/sys/class/net/$IFACE/carrier" 2>/dev/null)" = 1 ]; then
				seen=1
			fi
		fi
		# A PC whose side of the NCM link is up sends packets at once (DHCP,
		# IPv6 router solicitations, ...). If the link is configured but
		# nothing has arrived for a while, the PC most likely missed the NCM
		# "connected" notification and shows the adapter as unplugged; a
		# software re-plug makes it enumerate again. At most twice per boot,
		# never once traffic has been seen (pico4poc.usbkick=0 disables).
		if [ "$kick_after" -gt 0 ] && [ "$kicks" -lt 2 ] && [ -n "$IFACE" ]; then
			rx=$(cat "/sys/class/net/$IFACE/statistics/rx_packets" 2>/dev/null)
			if [ "${rx:-0}" -gt 0 ]; then
				kicks=2
			elif [ "$state" = configured ]; then
				now=$(cut -d. -f1 /proc/uptime)
				[ -n "$quiet_since" ] || quiet_since=$now
				if [ $((now - quiet_since)) -ge "$kick_after" ]; then
					kicks=$((kicks + 1))
					log "USB: no packets from the PC for ${kick_after}s, re-plugging the USB device ($kicks/2)"
					replug
					quiet_since=""
				fi
			else
				quiet_since=""
			fi
		fi
		if [ "$seen" = 0 ] && [ "$limit" -gt 0 ]; then
			up=$(cut -d. -f1 /proc/uptime)
			if [ "$up" -ge "$limit" ]; then
				log "USB: no PC configured the gadget within ${limit}s, rebooting to fastboot (pico4poc.autoreboot=0 disables)"
				sync
				sleep 2
				pico4-reboot bootloader
			fi
		fi
		sleep 2
	done
}

case "$1" in
watch) watch ;;
*) setup ;;
esac
