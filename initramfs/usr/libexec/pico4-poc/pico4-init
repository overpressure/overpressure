#!/bin/sh
# Stage-1 PID 1 of the PICO 4 Linux POC, in place of busybox init.
#
# Runs the ::respawn: and ::shutdown: entries of /etc/inittab like busybox
# init, with one deliberate difference: stopping signals user processes only.
# busybox init stops everything with kill(-1), which also reaches the kernel's
# USB mass-storage thread (f_mass_storage accepts SIGTERM/SIGKILL and exits).
# The PC then resets the composite USB device and the NCM network dies, which
# broke the step-4 userspace handoff on the headset (see docs/userspace.md).
#
#   SIGQUIT  stop, then exec the ::restart: entry (pico4-userspace switch)
#   SIGTERM  stop, reboot            SIGUSR1 / SIGUSR2  stop, halt / power off
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
. /usr/libexec/pico4-poc/lib.sh

entries() { sed -n "s/^::$1://p" /etc/inittab; }

# User processes: kernel threads have no executable (/proc/PID/exe does not
# resolve) and are never signalled. (/proc files always report size 0, so the
# cmdline cannot be tested with -s.)
user_pids() {
	local d
	for d in /proc/[0-9]*; do
		[ "${d#/proc/}" = 1 ] && continue
		readlink "$d/exe" >/dev/null 2>&1 && echo "${d#/proc/}"
	done
}

stop_all() {
	local cmd
	trap '' QUIT TERM USR1 USR2
	entries shutdown > /tmp/pico4-init.shutdown
	while read -r cmd; do sh -c "$cmd" </dev/null; done < /tmp/pico4-init.shutdown
	log "pico4-init: stopping user processes (kernel threads untouched)"
	kill -TERM $(user_pids) 2>/dev/null
	sleep 1
	kill -KILL $(user_pids) 2>/dev/null
	sync
}

restart() {
	stop_all
	exec $(entries restart | head -n 1)
	log "pico4-init: restart entry failed; rebooting to fastboot"
	exec pico4-reboot bootloader
}

trap restart QUIT
trap 'stop_all; exec reboot -f' TERM
trap 'stop_all; exec halt -f' USR1
trap 'stop_all; exec poweroff -f' USR2

entries respawn > /tmp/pico4-init.respawn
while read -r cmd; do
	# Each service in its own loop; svc rate-limits restarts itself.
	( trap - QUIT TERM USR1 USR2; while :; do sh -c "exec $cmd" </dev/null; sleep 1; done ) &
done < /tmp/pico4-init.respawn

# wait reaps every child, including orphans re-parented to PID 1, and returns
# early when a trapped signal arrives.
while :; do
	wait
	sleep 1
done
