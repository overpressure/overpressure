#!/bin/sh
# Independent of USB setup: even a hung setup or a configured but unusable
# network must leave a route back to the bootloader.
. /usr/libexec/pico4-poc/lib.sh
. /usr/libexec/pico4-poc/recovery-policy.sh

test_mode=0
connect_limit=$(poc_arg autoreboot 300)
test_limit=900
if [ -s /etc/pico4-poc/test-run ]; then
	test_mode=1
	connect_limit=$(cat /etc/pico4-poc/test-connect-timeout)
	test_limit=$(cat /etc/pico4-poc/test-timeout)
fi
reachable=0
while :; do
	if [ -e "$POC_RUN/no-autoreboot" ]; then
		reachable=1
	elif [ -f "$POC_RUN/net.env" ]; then
		. "$POC_RUN/net.env"
		if [ -n "$IFACE" ]; then
			rx=$(cat "/sys/class/net/$IFACE/statistics/rx_packets" 2>/dev/null)
			[ "${rx:-0}" -gt 0 ] && reachable=1
		fi
	fi
	acknowledged=0
	[ -e "$POC_RUN/test-authenticated" ] && acknowledged=1
	reason=$(recovery_reason "$(cut -d. -f1 /proc/uptime)" "$connect_limit" \
		"$test_limit" "$test_mode" "$reachable" "$acknowledged")
	if [ -n "$reason" ]; then
		log "Recovery: $reason; rebooting to fastboot"
		sync
		sleep 2
		pico4-reboot bootloader
	fi
	sleep 2
done
