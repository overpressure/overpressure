# Settings of overpressure's headset commands. Copy this file to .env and fill it in. .env
# stays out of Git: it describes particular headsets. Each headset's keys have its own prefix.

# The headset the tool works on when there are several (python -m overpressure devices).
OVERPRESSURE_DEVICE=

# --- PICO 4 (phoenix): python -m overpressure dev / cycle ---

# Serials: "adb devices", "fastboot devices", and "Serial Number" in edl-ng's output.
PICO4_ADB_SERIAL=
PICO4_FASTBOOT_SERIAL=
PICO4_EDL_SERIAL=

# The headset's records (devices/phoenix/docs/device-preparation.md): identity and verified EDL backup.
PICO4_IDENTITY=backup/device.json
PICO4_BACKUP=backup/stock

# From PICO's public downloads: python -m overpressure device fetch-unlock-files. Empty hash: the known file's.
PICO4_LOADER=assets/firehose.elf
PICO4_ENGINEERING_ABL=assets/engineering-abl.elf
PICO4_ENGINEERING_ABL_SHA256=
# Empty: the edl-ng that python -m overpressure tools fetches (pinned, hash-checked).
PICO4_EDL=

# The firmware entry of devices/phoenix/tooling/firmware.json that matches the headset
# (python -m overpressure match).
PICO4_FIRMWARE=5.13.7-global-seko

# SSH on the installed system takes keys only (USB and Wi-Fi). python -m overpressure dev image makes
# this PC's key (out/dev/id_ed25519) and enrolls it; this file adds your own public key too.
PICO4_SSH_PUBLIC_KEY=

# Windows: a Python with pyusb and libusb-package (pyproject.toml) initializes the NCM link.
# Empty: the Python that runs overpressure, which has them.
PICO4_NCM_PYTHON=

# Programs: your own adb and fastboot folder (empty: the platform-tools that python -m
# overpressure tools fetches, else PATH), ssh and ssh-keygen.
PICO4_PLATFORM_TOOLS=
PICO4_SSH=ssh
PICO4_SSH_KEYGEN=ssh-keygen
