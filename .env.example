# A developer's overrides in a checkout (docs/tool.md#settings): nothing writes .env, and nothing needs it.
# overpressure records what it finds out (out/records.json) and the app keeps the owner's settings
# (settings.json); a key here, or in the environment, takes precedence over both. Each headset's keys
# have its own prefix (devices/<codename>/env.example). .env stays out of Git.

# The headset the tool works on when there are several (python -m overpressure devices).
OVERPRESSURE_DEVICE=

# Words that never belong in the repository, comma-separated (private host names, names):
# scripts/check-private.py searches for them and never prints them.
OVERPRESSURE_PRIVATE_WORDS=
