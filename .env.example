# Settings of overpressure's headset commands. A new .env starts as this file and each headset's
# devices/<codename>/env.example (python -m overpressure writes it), or copy them yourself. .env stays
# out of Git: it describes particular headsets. Each headset's keys have its own prefix.

# The headset the tool works on when there are several (python -m overpressure devices).
OVERPRESSURE_DEVICE=

# Words that never belong in the repository, comma-separated (private host names, names):
# scripts/check-private.py searches for them and never prints them.
OVERPRESSURE_PRIVATE_WORDS=
