# Settings of overpressure's headset commands. Copy this file to .env and fill it in. .env
# stays out of Git: it describes particular headsets. Each headset's keys have its own prefix.

# The headset the tool works on when there are several (python -m overpressure devices).
OVERPRESSURE_DEVICE=

# --- PICO 4 (phoenix): python -m overpressure dev / cycle ---

# Serials: "adb devices", "fastboot devices", and "Serial Number" in edl-ng's output.
PICO4_ADB_SERIAL=
PICO4_FASTBOOT_SERIAL=
PICO4_EDL_SERIAL=

# The headset's records (docs/device-preparation.md): identity and verified EDL backup.
PICO4_IDENTITY=backup/device.json
PICO4_BACKUP=backup/stock

# Independently obtained files: the signed Firehose loader and the engineering ABL.
PICO4_LOADER=assets/firehose.elf
PICO4_ENGINEERING_ABL=assets/engineering-abl.elf
PICO4_ENGINEERING_ABL_SHA256=
PICO4_EDL=cache/edl-ng/edl-ng.exe

# The firmware entry of devices/phoenix/tooling/firmware.json that matches the headset
# (python -m overpressure match).
PICO4_FIRMWARE=5.13.8-global-sek

# Windows: a Python with the windows-ncm extra (pyproject.toml) initializes the NCM link.
PICO4_NCM_PYTHON=

# Programs that are not on PATH: the folder with adb and fastboot, ssh and ssh-keygen.
PICO4_PLATFORM_TOOLS=
PICO4_SSH=ssh
PICO4_SSH_KEYGEN=ssh-keygen
