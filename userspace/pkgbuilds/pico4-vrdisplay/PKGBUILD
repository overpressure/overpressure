# The PICO 4 panels as a Vulkan direct-mode display for SteamVR's compositor
# (docs/session.md). vrcompositor drives a headset through VK_KHR_display and its
# acquire, counter and event extensions; Turnip's KGSL backend has no display,
# and msm_drm needs the vendor fence contract and six colour layers
# (docs/graphics.md). This implicit Vulkan layer (enabled by PICO4_VRDISPLAY=1)
# implements those entry points with the same atomic commits as pico4-monado's
# KMS target. It also emulates the OPAQUE_FD timeline semaphores SteamVR shares
# between processes, which neither the driver nor the stock kernel can provide
# (pico4-vrsync.c). pico4-vrdisplay-test drives the display the way
# vrcompositor does; pico4-vrsync-test shares a semaphore between two processes.
# Sources are this project's own files, copied in by build-userspace.sh.
pkgname=pico4-vrdisplay
pkgver=1
pkgrel=2
arch=(aarch64)
url="https://registry.khronos.org/vulkan/specs/latest/man/html/VK_KHR_display.html"
license=(BSL-1.0)
depends=(glibc libdrm vulkan-icd-loader)
makedepends=(vulkan-headers)
source=(pico4-vrdisplay.c pico4-vrsync.c pico4-vrsync.h pico4-vrdisplay-test.c pico4-vrsync-test.c
        VkLayer_PICO4_vrdisplay.json)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP)

build() {
  # Vulkan entry points leave many parameters unused.
  ${CC:-cc} $CFLAGS -std=c11 -Wall -Wextra -Wno-unused-parameter -Werror -fPIC -shared -fvisibility=hidden \
    -I/usr/include/libdrm $LDFLAGS -o libVkLayer_PICO4_vrdisplay.so pico4-vrdisplay.c pico4-vrsync.c \
    -ldrm -lpthread -lm
  ${CC:-cc} $CFLAGS -std=c11 -Wall -Wextra -Werror -I/usr/include/libdrm $LDFLAGS -o pico4-vrdisplay-test \
    pico4-vrdisplay-test.c -lvulkan -ldrm -lpthread
  ${CC:-cc} $CFLAGS -std=c11 -Wall -Wextra -Werror $LDFLAGS -o pico4-vrsync-test pico4-vrsync-test.c -lvulkan
}

package() {
  install -Dm755 libVkLayer_PICO4_vrdisplay.so -t "$pkgdir/usr/lib"
  install -Dm644 VkLayer_PICO4_vrdisplay.json -t "$pkgdir/usr/share/vulkan/implicit_layer.d"
  install -Dm755 pico4-vrdisplay-test pico4-vrsync-test -t "$pkgdir/usr/bin"
}
