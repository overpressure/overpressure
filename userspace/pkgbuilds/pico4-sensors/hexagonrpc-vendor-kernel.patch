diff --git a/include/libhexagonrpc/downstream.h b/include/libhexagonrpc/downstream.h
new file mode 100644
index 0000000..f86cc08
--- /dev/null
+++ b/include/libhexagonrpc/downstream.h
@@ -0,0 +1,39 @@
+/*
+ * Downstream (msm-4.x "adsprpc") FastRPC ioctl translation
+ *
+ * This file is part of sensh.
+ *
+ * Sensh is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef LIBHEXAGONRPC_DOWNSTREAM_H
+#define LIBHEXAGONRPC_DOWNSTREAM_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <misc/fastrpc.h>
+
+/* Map "adsp", "mdsp", "sdsp", "cdsp" to the downstream channel id, or -1. */
+int hexagonrpc_downstream_domain(const char *name);
+
+/*
+ * Select the DSP channel and attach to its guest OS (or sensors) process.
+ * After a successful attach, every call on fd uses the downstream ABI.
+ */
+int hexagonrpc_downstream_attach(int fd, int domain, bool sensors);
+
+bool hexagonrpc_is_downstream(int fd);
+
+/* args: one upstream-format entry per buffer/handle described by sc. */
+int hexagonrpc_downstream_invoke(int fd, uint32_t handle, uint32_t sc,
+				 const struct fastrpc_invoke_args *args);
+
+int hexagonrpc_downstream_mmap(int fd, struct fastrpc_req_mmap *req);
+
+/* For tests: replace the ioctl() system call. */
+void hexagonrpc_downstream_set_ioctl(long (*fn)(int, unsigned long, void *));
+
+#endif
diff --git a/libhexagonrpc/downstream.c b/libhexagonrpc/downstream.c
new file mode 100644
index 0000000..9eab34a
--- /dev/null
+++ b/libhexagonrpc/downstream.c
@@ -0,0 +1,238 @@
+/*
+ * Downstream (msm-4.x "adsprpc") FastRPC ioctl translation
+ *
+ * Android vendor kernels expose FastRPC as /dev/adsprpc-smd with an older
+ * ioctl ABI than the upstream misc/fastrpc.h driver: the DSP is selected with
+ * FASTRPC_IOCTL_GETINFO after open(), a process attaches with
+ * FASTRPC_IOCTL_INIT_ATTRS, and invocations pass 16-byte remote_arg entries
+ * instead of 24-byte fastrpc_invoke_args. The remote protocol on the DSP is
+ * the same, so only the ioctl layer is translated here.
+ *
+ * Upstream and downstream ioctl numbers overlap with different meanings (the
+ * upstream INVOKE number is the downstream MUNMAP), so a descriptor is only
+ * ever driven with one ABI: the one it was attached with.
+ *
+ * This file is part of sensh.
+ *
+ * Sensh is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+
+#include <libhexagonrpc/downstream.h>
+
+struct ds_remote_buf {
+	void *pv;
+	size_t len;
+};
+
+struct ds_remote_dma_handle {
+	int fd;
+	uint32_t offset;
+};
+
+union ds_remote_arg {
+	struct ds_remote_buf buf;
+	struct ds_remote_dma_handle dma;
+	uint32_t h;
+};
+
+struct ds_ioctl_invoke {
+	uint32_t handle;
+	uint32_t sc;
+	union ds_remote_arg *pra;
+};
+
+struct ds_ioctl_invoke_fd {
+	struct ds_ioctl_invoke inv;
+	int *fds;
+};
+
+struct ds_ioctl_init {
+	uint32_t flags;
+	uintptr_t file;
+	uint32_t filelen;
+	int32_t filefd;
+	uintptr_t mem;
+	uint32_t memlen;
+	int32_t memfd;
+};
+
+struct ds_ioctl_init_attrs {
+	struct ds_ioctl_init init;
+	int attrs;
+	unsigned int siglen;
+};
+
+struct ds_ioctl_mmap {
+	int fd;
+	uint32_t flags;
+	uintptr_t vaddrin;
+	size_t size;
+	uintptr_t vaddrout;
+};
+
+#define DS_IOCTL_INVOKE		_IOWR('R', 1, struct ds_ioctl_invoke)
+#define DS_IOCTL_MMAP		_IOWR('R', 2, struct ds_ioctl_mmap)
+#define DS_IOCTL_INVOKE_FD	_IOWR('R', 4, struct ds_ioctl_invoke_fd)
+#define DS_IOCTL_GETINFO	_IOWR('R', 8, uint32_t)
+#define DS_IOCTL_INIT_ATTRS	_IOWR('R', 10, struct ds_ioctl_init_attrs)
+
+#define DS_INIT_ATTACH		0
+#define DS_INIT_ATTACH_SENSORS	3
+
+#define DS_MAX_FDS 64
+
+/* Small fixed table: hexagonrpcd drives one or two descriptors. */
+static int ds_fds[DS_MAX_FDS];
+static int ds_n_fds;
+
+static long (*ds_ioctl)(int fd, unsigned long req, void *arg) = NULL;
+
+static long ds_sys_ioctl(int fd, unsigned long req, void *arg)
+{
+	return ioctl(fd, req, arg);
+}
+
+void hexagonrpc_downstream_set_ioctl(long (*fn)(int, unsigned long, void *))
+{
+	ds_ioctl = fn;
+}
+
+static long ds_call(int fd, unsigned long req, void *arg)
+{
+	return (ds_ioctl ? ds_ioctl : ds_sys_ioctl)(fd, req, arg);
+}
+
+bool hexagonrpc_is_downstream(int fd)
+{
+	int i;
+
+	for (i = 0; i < ds_n_fds; i++) {
+		if (ds_fds[i] == fd)
+			return true;
+	}
+
+	return false;
+}
+
+int hexagonrpc_downstream_domain(const char *name)
+{
+	static const char *const names[] = { "adsp", "mdsp", "sdsp", "cdsp" };
+	size_t i;
+
+	if (name == NULL)
+		return -1;
+
+	for (i = 0; i < sizeof(names) / sizeof(*names); i++) {
+		if (!strcmp(name, names[i]))
+			return (int) i;
+	}
+
+	return -1;
+}
+
+int hexagonrpc_downstream_attach(int fd, int domain, bool sensors)
+{
+	struct ds_ioctl_init_attrs init;
+	uint32_t info;
+	long ret;
+
+	if (domain < 0 || ds_n_fds >= DS_MAX_FDS) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	/* Selects the DSP channel and allocates the session. */
+	info = (uint32_t) domain;
+	ret = ds_call(fd, DS_IOCTL_GETINFO, &info);
+	if (ret)
+		return (int) ret;
+
+	memset(&init, 0, sizeof(init));
+	init.init.flags = sensors ? DS_INIT_ATTACH_SENSORS : DS_INIT_ATTACH;
+	init.init.filefd = -1;
+	init.init.memfd = -1;
+
+	ret = ds_call(fd, DS_IOCTL_INIT_ATTRS, &init);
+	if (ret)
+		return (int) ret;
+
+	ds_fds[ds_n_fds++] = fd;
+	return 0;
+}
+
+int hexagonrpc_downstream_invoke(int fd, uint32_t handle, uint32_t sc,
+				 const struct fastrpc_invoke_args *args)
+{
+	struct ds_ioctl_invoke_fd inv;
+	union ds_remote_arg *pra;
+	int *fds;
+	bool any_fd = false;
+	size_t n, i;
+	long ret;
+
+	n = ((sc >> 16) & 0xff) + ((sc >> 8) & 0xff)
+	  + ((sc >> 4) & 0x0f) + (sc & 0x0f);
+
+	pra = calloc(n ? n : 1, sizeof(*pra));
+	fds = calloc(n ? n : 1, sizeof(*fds));
+	if (pra == NULL || fds == NULL) {
+		free(pra);
+		free(fds);
+		errno = ENOMEM;
+		return -1;
+	}
+
+	for (i = 0; i < n; i++) {
+		pra[i].buf.pv = (void *) (uintptr_t) args[i].ptr;
+		pra[i].buf.len = (size_t) args[i].length;
+		fds[i] = args[i].fd;
+		if (args[i].fd != -1)
+			any_fd = true;
+	}
+
+	memset(&inv, 0, sizeof(inv));
+	inv.inv.handle = handle;
+	inv.inv.sc = sc;
+	inv.inv.pra = pra;
+
+	if (any_fd) {
+		inv.fds = fds;
+		ret = ds_call(fd, DS_IOCTL_INVOKE_FD, &inv);
+	} else {
+		ret = ds_call(fd, DS_IOCTL_INVOKE, &inv.inv);
+	}
+
+	free(pra);
+	free(fds);
+	return (int) ret;
+}
+
+int hexagonrpc_downstream_mmap(int fd, struct fastrpc_req_mmap *req)
+{
+	struct ds_ioctl_mmap mmap;
+	long ret;
+
+	memset(&mmap, 0, sizeof(mmap));
+	mmap.fd = req->fd;
+	mmap.flags = req->flags;
+	mmap.vaddrin = (uintptr_t) req->vaddrin;
+	mmap.size = (size_t) req->size;
+
+	ret = ds_call(fd, DS_IOCTL_MMAP, &mmap);
+	if (ret)
+		return (int) ret;
+
+	req->vaddrout = mmap.vaddrout;
+	return 0;
+}
