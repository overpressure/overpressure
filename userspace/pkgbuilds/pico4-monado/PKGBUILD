# Monado (OpenXR runtime) with a driver for the original PICO 4 on its stock
# kernel (docs/xr.md): head orientation from the ICM-42688 behind the sensor DSP,
# through the same Qualcomm Sensor Core client protocol as pico4-imu, and 6DoF
# from the four OV7251 tracking cameras (Spectra CSL, frame sync from the
# controller radio) through Monado's SLAM tracker with Basalt (pico4-basalt),
# plus the two controllers (inputs, 3DoF) from the radio's packets.
# Upstream Monado, pinned by commit, plus this project's driver files and a
# patch that registers them. Built as a service (monado-service owns the
# hardware for clients of any user, docs/session.md; the runtime library is its IPC
# client) and as a SteamVR driver plugin (driver_monado, the headset driver of
# Valve's VR session). The main compositor shows frames on the two panels
# through the stock msm_drm KMS driver (comp_window_pico4_kms.c, the fenced
# path of docs/graphics.md); the null compositor serves headless clients. The
# acceptance clients read the head pose (pico4-openxr-pose) and render frames
# (pico4-openxr-display) through the OpenXR loader; pico4-cam checks the
# tracking cameras on their own; pico4-ctrack-replay runs the controller LED
# tracker over pico4-cam's recordings; pico4-roomview hands the forward cameras to
# SteamVR's room view (docs/xr.md#passthrough).
pkgname=pico4-monado
pkgver=25.1.0
pkgrel=9
arch=(aarch64)
url="https://monado.freedesktop.org"
license=(BSL-1.0)
depends=(openxr vulkan-icd-loader libusb systemd-libs dbus libcap libdrm libffi libx11 libxau libxcb
         libxdmcp wayland gcc-libs glibc opencv libbsd)
makedepends=(git cmake ninja eigen vulkan-headers glslang python)
# Loaded at runtime (VIT); without it the HMD stays on 3DoF.
optdepends=('pico4-basalt: 6DoF head tracking')
provides=(openxr-runtime)
_commit=3b450e37b624f5edea366492ee2d267d673a35aa # v25.1.0
# Spectra camera UAPI (CAF LA.UM.9.12 kona, the closest public match of the stock kernel).
_camuapi=https://raw.githubusercontent.com/LineageOS/android_kernel_xiaomi_sm8250/f3d39dae3253e7f8bb623eb83a146088f3174148/techpack/camera/include/uapi/media
_camheaders=(cam_cpas.h cam_defs.h cam_isp.h cam_isp_ife.h cam_isp_vfe.h cam_req_mgr.h cam_sensor.h cam_sync.h)
source=("monado::git+https://gitlab.freedesktop.org/monado/monado.git#commit=$_commit"
        "${_camheaders[@]/#/$_camuapi/}"
        monado-pico4-driver.patch monado-steamvr-pico4.patch monado-service-sigterm.patch
        monado-slam-prediction.patch monado-steamvr-battery.patch monado-vk-mutex-init-failure.patch
        monado-steamvr-presence.patch monado-steamvr-camera.patch monado-steamvr-room.patch
        pico4_interface.h pico4_hmd.c pico4_ssc.h pico4_ssc.c test_pico4_ssc.c
        pico4_lens.h pico4_lens.c pico4_ipd.h pico4_ipd.c test_pico4_lens.c
        pico4_cam.h pico4_cam.c pico4_station.h pico4_station.c pico4_tcam.h pico4_tcam.c
        pico4_passthrough.h pico4_passthrough.c pico4_roomview.h pico4-roomview.c
        pico4_slam.h pico4_slam.c pico4_slam_feed.h pico4_blemcu.h pico4_blemcu.c pico4_controller.h pico4_controller.c
        pico4_fusion.h pico4_fusion.c test_pico4_tracking.c test_pico4_fusion.c
        comp_window_pico4_kms.c pico4-openxr-pose.c pico4-openxr-display.c pico4-cam.c
        pico4_retire.h test_pico4_retire.c
        pico4_ctrack_types.hpp pico4_ctrack_model.hpp pico4_ctrack_model.cpp pico4_ctrack_solve.hpp
        pico4_ctrack_solve.cpp pico4_ctrack_init.hpp pico4_ctrack_init.cpp pico4_ctrack_blob.hpp
        pico4_ctrack_blob.cpp pico4_ctrack_imu.hpp pico4_ctrack_imu.cpp pico4_ctrack_engine.hpp
        pico4_ctrack_engine.cpp test_pico4_ctrack_solve.cpp test_pico4_ctrack_init.cpp
        test_pico4_ctrack_blob.cpp test_pico4_ctrack_imu.cpp test_pico4_ctrack_engine.cpp
        pico4-ctrack-replay.cpp pico4_ctrack.h pico4_ctrack.cpp pico4_ctrack_calib.hpp pico4_ctrack_calib.cpp
        pico4_ctrack_runner.hpp pico4_ctrack_runner.cpp test_pico4_ctrack_runner.cpp test_pico4_ctrack_world.hpp
        pico4_aimgrip.h test_pico4_aimgrip.c
        pico4-vrcompositor-bindings.json)
# Project files (src/monado, src/xr) are SKIP: build-userspace.sh copies them in.
sha256sums=(SKIP
