prepare() {
  patch -d monado -p1 < monado-pico4-driver.patch
  patch -d monado -p1 < monado-steamvr-pico4.patch
  patch -d monado -p1 < monado-service-sigterm.patch
  patch -d monado -p1 < monado-slam-prediction.patch
  patch -d monado -p1 < monado-steamvr-battery.patch
  # A compositor whose init failed before Vulkan (the panels taken) must not abort on teardown.
  patch -d monado -p1 < monado-vk-mutex-init-failure.patch
  # The headset's wear sensor as SteamVR's user presence (/proximity).
  patch -d monado -p1 < monado-steamvr-presence.patch
  # SteamVR's camera (room view) from the forward tracking cameras.
  patch -d monado -p1 < monado-steamvr-camera.patch
  # A tracking universe per room (the tracker's map).
  patch -d monado -p1 < monado-steamvr-room.patch
  # PICO's kernel allows four links per session where the CAF header says two.
  install -Dm644 -t monado/src/xrt/drivers/pico4/include/media "${_camheaders[@]}"
  sed -i -E 's/^(#define MAX_LINKS_PER_SESSION[[:space:]]+)2$/\14/' \
    monado/src/xrt/drivers/pico4/include/media/cam_req_mgr.h
  grep -q '^#define MAX_LINKS_PER_SESSION[[:space:]]*4$' monado/src/xrt/drivers/pico4/include/media/cam_req_mgr.h
}

build() {
  # The project's files go in here rather than in prepare(): an incremental build
  # (makepkg -e, build-userspace.sh) then recompiles only what changed, because
  # install -C leaves unchanged files and their timestamps alone.
  install -C -Dm644 -t monado/src/xrt/drivers/pico4 pico4_interface.h pico4_hmd.c pico4_ssc.h pico4_ssc.c \
    pico4_lens.h pico4_lens.c pico4_ipd.h pico4_ipd.c pico4_cam.h pico4_cam.c pico4_station.h pico4_station.c \
    pico4_tcam.h pico4_tcam.c pico4_passthrough.h pico4_passthrough.c pico4_roomview.h pico4_slam.h pico4_slam.c pico4_slam_feed.h pico4_blemcu.h pico4_blemcu.c pico4_controller.h \
    pico4_controller.c pico4_fusion.h pico4_fusion.c pico4_ctrack.h pico4_ctrack.cpp pico4_ctrack_types.hpp \
    pico4_ctrack_model.hpp pico4_ctrack_model.cpp pico4_ctrack_solve.hpp pico4_ctrack_solve.cpp \
    pico4_ctrack_init.hpp pico4_ctrack_init.cpp pico4_ctrack_blob.hpp pico4_ctrack_blob.cpp pico4_ctrack_imu.hpp \
    pico4_ctrack_imu.cpp pico4_ctrack_engine.hpp pico4_ctrack_engine.cpp pico4_ctrack_runner.hpp \
    pico4_ctrack_runner.cpp pico4_ctrack_calib.hpp pico4_ctrack_calib.cpp pico4_aimgrip.h
  install -C -Dm644 -t monado/src/xrt/compositor/main comp_window_pico4_kms.c pico4_retire.h

  # The protocol and model tests run here because build-userspace.sh uses --nocheck.
  ${CC:-cc} -std=c11 -D_GNU_SOURCE -O1 -Wall -Wextra -Werror -o test_pico4_ssc test_pico4_ssc.c pico4_ssc.c
  ./test_pico4_ssc
  ${CC:-cc} -std=c11 -D_GNU_SOURCE -O1 -Wall -Wextra -Werror -Imonado/src/external/cjson -o test_pico4_lens \
    test_pico4_lens.c pico4_lens.c pico4_ipd.c monado/src/external/cjson/cjson/cJSON.c -lm
  ./test_pico4_lens
  ${CC:-cc} -std=c11 -D_GNU_SOURCE -O1 -Wall -Wextra -Werror -Imonado/src/xrt/include -Imonado/src/external/cjson \
    -o test_pico4_aimgrip test_pico4_aimgrip.c monado/src/external/cjson/cjson/cJSON.c -lm
  ./test_pico4_aimgrip
  ${CC:-cc} -std=c11 -D_GNU_SOURCE -O1 -Wall -Wextra -Werror -o test_pico4_tracking test_pico4_tracking.c \
    pico4_station.c pico4_tcam.c pico4_blemcu.c pico4_passthrough.c -lm -lpthread
  ./test_pico4_tracking
  ${CC:-cc} -std=c11 -O1 -Wall -Wextra -Werror -Imonado/src/xrt/include -o test_pico4_fusion test_pico4_fusion.c \
    pico4_fusion.c -lm
  ./test_pico4_fusion
  ${CC:-cc} -std=c11 -D_GNU_SOURCE -O1 -Wall -Wextra -Werror -o test_pico4_retire test_pico4_retire.c -lpthread
  ./test_pico4_retire
  # The controller tracker (C++17, Eigen), compiled once for its tests and the replay tool.
  ${CC:-cc} -std=c11 -O2 -Wall -Wextra -Werror -c pico4_tcam.c pico4_blemcu.c
  local ctrack=(model solve init blob imu engine runner calib) objs=(pico4_tcam.o) m t
  for m in "${ctrack[@]}"; do
    ${CXX:-c++} -std=c++17 -O2 -ffp-contract=off -Wall -Wextra -Werror -isystem /usr/include/eigen3 -c -o ctrack_$m.o \
      pico4_ctrack_$m.cpp
    objs+=(ctrack_$m.o)
  done
  for t in solve init blob imu engine runner; do
    ${CXX:-c++} -std=c++17 -O1 -Wall -Wextra -Werror -isystem /usr/include/eigen3 -o test_pico4_ctrack_$t \
      test_pico4_ctrack_$t.cpp "${objs[@]}" -lpthread
    ./test_pico4_ctrack_$t
  done

  # Configured once per build tree; ninja reruns CMake when its inputs change.
  if [[ ! -f build/build.ninja ]]; then
    # Only the PICO 4 driver and the simulated HMD (headless fallback).
    local off
    off=$(sed -n '/^\tAVAILABLE_DRIVERS$/,/^\t)$/p' monado/CMakeLists.txt | grep -o '"[A-Z0-9_]*"' | tr -d '"' |
      grep -vx 'PICO4\|SIMULATED' | sed 's/^/-DXRT_BUILD_DRIVER_/; s/$/=OFF/')
    [[ -n "$off" ]]
    # shellcheck disable=SC2086
    cmake -S monado -B build -G Ninja -DCMAKE_BUILD_TYPE=None -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_INSTALL_LIBDIR=lib -DXRT_BUILD_DRIVER_PICO4=ON -DXRT_BUILD_DRIVER_SIMULATED=ON $off \
      -DXRT_FEATURE_SERVICE=ON -DXRT_HAVE_SYSTEMD=ON -DXRT_FEATURE_SERVICE_SYSTEMD=ON \
      -DXRT_INSTALL_SYSTEMD_UNIT_FILES=OFF -DXRT_MODULE_COMPOSITOR_MAIN=ON -DXRT_MODULE_COMPOSITOR_NULL=ON \
      -DXRT_FEATURE_STEAMVR_PLUGIN=ON -DXRT_MODULE_MONADO_GUI=OFF -DXRT_BUILD_SAMPLES=OFF -DBUILD_TESTING=OFF \
      -DXRT_HAVE_SDL2=OFF -DXRT_HAVE_OPENCV=ON -DXRT_FEATURE_SLAM=ON -DXRT_MODULE_MERCURY_HANDTRACKING=OFF \
      -DXRT_HAVE_LIBUVC=OFF -DXRT_HAVE_FFMPEG=OFF -DXRT_HAVE_GST=OFF \
      -DXRT_HAVE_PERCETTO=OFF -DXRT_FEATURE_TRACING=OFF -DXRT_HAVE_OPENGL=OFF -DXRT_HAVE_OPENGLES=OFF \
      -DXRT_HAVE_EGL=OFF
  fi
  cmake --build build

  ${CC:-cc} -std=c11 -O2 -Wall -Wextra -Werror -o pico4-openxr-pose pico4-openxr-pose.c -lopenxr_loader -lm
  ${CC:-cc} -std=c11 -O2 -Wall -Wextra -Werror -o pico4-openxr-display pico4-openxr-display.c -lopenxr_loader -lvulkan -lm
  ${CC:-cc} -std=c11 -O2 -Wall -Wextra -Werror -Imonado/src/xrt/drivers/pico4/include -o pico4-cam pico4-cam.c \
    pico4_cam.c pico4_station.c pico4_ssc.c -lpthread
  ${CC:-cc} -std=c11 -O2 -Wall -Wextra -Werror -o pico4-roomview pico4-roomview.c -lvulkan -ldl -lm
  ${CXX:-c++} -std=c++17 -O2 -Wall -Wextra -Werror -isystem /usr/include/eigen3 -o pico4-ctrack-replay \
    pico4-ctrack-replay.cpp "${objs[@]}" pico4_blemcu.o -lpthread -lm
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # SteamVR for linuxarm64 loads drivers from bin/linuxarm64; Monado names the
  # directory after the pointer size. The session's openvrpaths.vrpath lists
  # /usr/share/steamvr-monado as an external driver.
  mv "$pkgdir/usr/share/steamvr-monado/bin/linux64" "$pkgdir/usr/share/steamvr-monado/bin/linuxarm64"
  [[ -s "$pkgdir/usr/share/steamvr-monado/bin/linuxarm64/driver_monado.so" ]]
  # The service units are the project's (userspace/rootfs): upstream's user
  # units would start a second Monado per user.
  rm -rf "$pkgdir/usr/lib/systemd"
  # SteamVR's dashboard has no default bindings for this controller type: the profile names ours.
  local input="$pkgdir/usr/share/steamvr-monado/resources/input"
  install -Dm644 pico4-vrcompositor-bindings.json "$input/pico4_vrcompositor_bindings.json"
  python3 - "$input/bytedance_pico4_controller_profile.json" <<'PY'
import json, sys
with open(sys.argv[1]) as f:
    profile = json.load(f)
profile["default_bindings"] = [
    {"app_key": "openvr.component.vrcompositor", "binding_url": "pico4_vrcompositor_bindings.json"}]
with open(sys.argv[1], "w") as f:
    json.dump(profile, f, indent=2)
PY
  install -Dm755 pico4-openxr-pose pico4-openxr-display pico4-cam pico4-ctrack-replay pico4-roomview -t "$pkgdir/usr/bin"
  # The loader's system-wide active runtime.
  install -dm755 "$pkgdir/etc/openxr/1"
  ln -s /usr/share/openxr/1/openxr_monado.json "$pkgdir/etc/openxr/1/active_runtime.json"
  install -Dm644 monado/LICENSES/BSL-1.0.txt "$pkgdir/usr/share/licenses/$pkgname/BSL-1.0.txt"
}
