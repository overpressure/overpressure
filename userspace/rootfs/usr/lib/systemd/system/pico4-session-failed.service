# The session kept ending (pico4-session.service's OnFailure= after its start limit): fall back
# to Monado's session, unless that is the one that kept ending. A unit of its own, apart from
# pico4-session-fallback.service: systemd passes the failed unit's result (MONITOR_SERVICE_RESULT)
# here, and a stop that only timed out must not start a session.
[Unit]
Description=Fall back to Monado's session after the session kept ending

[Service]
Type=oneshot
ExecStart=/usr/libexec/pico4-poc/session-fallback session
