[Unit]
Description=PICO OS's audio calibration (ACDB) for the speakers and the microphone
ConditionPathExists=/usr/lib/pico4-audio/acdb
# The card registers once the audio process is up; the calibration goes with the ADSP: after a
# restart of the DSP its custom topologies and blocks are sent again.
Requires=pico4-audiopd.service
After=pico4-audiopd.service
PartOf=pico4-adsp.service

[Service]
# It stays: the kernel drops every block when /dev/msm_audio_cal is closed for the last time.
ExecStart=/usr/bin/pico4-audiocal run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=pico4-audio.target
