#!/bin/bash
# Ends the boot indication once the session has started (docs/install.md), run by
# pico4-session.service as root. Valve's session shows SteamVR's compositor in the lenses, and
# pico4-splash exits when the compositor takes the display; Monado's session shows nothing
# until an OpenXR application starts, so the indication ends with the session's start.
set -euo pipefail
case "${PICO4_SESSION_TARGET:-pico4-session.target}" in
gamescope-session.target | plasma-session.target) ;;
*) systemctl stop --no-block pico4-splash.service ;;
esac
