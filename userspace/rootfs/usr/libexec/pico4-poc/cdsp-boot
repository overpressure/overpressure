#!/bin/bash
# Boot the Compute DSP as PICO OS does (write /sys/kernel/boot_cdsp/boot) and wait until its
# subsystem reports ONLINE: PICO OS's head tracker runs its front end there
# (docs/xr.md#head-tracking). The firmware (cdsp.mdt, .bNN) comes from the headset's own modem
# partition (scripts/extract-stock-slam.sh).
. /usr/libexec/pico4-poc/lib.sh
set -u

subsys_dir() {
	local d
	for d in /sys/bus/msm_subsys/devices/*; do
		[ "$(cat "$d/name" 2>/dev/null)" = cdsp ] && { echo "$d"; return 0; }
	done
	return 1
}

subsys_state() {
	local d
	d=$(subsys_dir) && cat "$d/state" 2>/dev/null || echo missing
}

# The kernel default is restart level SYSTEM: any DSP crash or restart request reboots the
# whole headset. It must be RELATED before the DSP starts.
dir=$(subsys_dir) || { log "cdsp: no subsystem"; exit 1; }
write RELATED "$dir/restart_level"
[ "$(cat "$dir/restart_level" 2>/dev/null)" = RELATED ] || { log "cdsp: restart level not RELATED, not booting"; exit 1; }

state=$(subsys_state)
if [ "$state" = ONLINE ]; then
	log "cdsp: already online"
	exit 0
fi
[ -w /sys/kernel/boot_cdsp/boot ] || { log "cdsp: no /sys/kernel/boot_cdsp/boot"; exit 1; }
log "cdsp: booting (state $state)"
echo 1 > /sys/kernel/boot_cdsp/boot || { log "cdsp: boot request failed"; exit 1; }
for _ in $(seq 1 30); do
	state=$(subsys_state)
	if [ "$state" = ONLINE ]; then
		log "cdsp: online"
		exit 0
	fi
	sleep 1
done
log "cdsp: not online after boot request (state $state)"
exit 1
