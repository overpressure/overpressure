#!/usr/bin/python3
"""The power key as on PICO OS (docs/install.md#power-key).

PICO OS's window manager puts the headset to sleep on a short press (screen off, then the
kernel's suspend) and shuts it down without asking when the key is held 2 s (its resolved
long-press behaviour, factory.long_press_power_off=1). Here a short press suspends
(systemctl suspend: the key wakes the headset again) and a 2 s hold powers off. logind leaves
the key alone (HandlePowerKey=ignore, HandlePowerKeyLongPress=ignore).

    powerkey [--dry-run]
"""
import glob
import os
import select
import struct
import subprocess
import sys
import time

KEY_POWER = 116
EV_KEY = 1
EVENT = struct.Struct("qqHHi")  # struct input_event on a 64-bit kernel
LONG_PRESS_S = 2.0               # PICO OS's config_globalActionsKeyTimeout
SETTLE_S = 1.0                   # events this soon after waking belong to the wake-up press


def slept():
    """Seconds spent suspended since boot: CLOCK_BOOTTIME counts them, CLOCK_MONOTONIC does not."""
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()


def key_device():
    """The PMIC's power-on key (qpnp_pon)."""
    for name in sorted(glob.glob("/sys/class/input/event*/device/name")):
        with open(name, encoding="ascii", errors="replace") as f:
            if f.read().strip() == "qpnp_pon":
                return "/dev/input/" + name.split("/")[4]
    return None


def act(action, dry_run):
    print(f"powerkey: {action}", flush=True)
    if not dry_run:
        subprocess.run(["systemctl", action], check=False)


class Key:
    """Turns press/release events into PICO OS's two actions."""

    def __init__(self):
        self.pressed_at = None

    def event(self, value, now):
        """The action for a key event (1 press, 0 release) at monotonic time now, or None."""
        if value == 1:
            self.pressed_at = now
        elif value == 0 and self.pressed_at is not None:
            held = now - self.pressed_at
            self.pressed_at = None
            if held < LONG_PRESS_S:
                return "suspend"
        return None

    def timeout(self, now):
        """Seconds until a held key becomes a long press (None if not pressed); the action when due."""
        if self.pressed_at is None:
            return None, None
        left = self.pressed_at + LONG_PRESS_S - now
        if left > 0:
            return left, None
        self.pressed_at = None
        return None, "poweroff"


def main(argv):
    dry_run = "--dry-run" in argv
    path = key_device()
    if path is None:
        print("powerkey: no qpnp_pon input device", file=sys.stderr)
        return 1
    fd = os.open(path, os.O_RDONLY)
    key = Key()
    quiet_until = 0.0
    asleep = slept()
    while True:
        wait, action = key.timeout(time.monotonic())
        if action is not None:
            act(action, dry_run)
            continue
        ready, _, _ = select.select([fd], [], [], wait)
        if not ready:
            continue
        data = os.read(fd, EVENT.size * 16)
        now = time.monotonic()
        if slept() > asleep + 0.5:
            # Just woken: the key's events now are the press that woke the headset.
            asleep = slept()
            quiet_until = now + SETTLE_S
            key.pressed_at = None
        for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _, _, etype, code, value = EVENT.unpack_from(data, i)
            if etype != EV_KEY or code != KEY_POWER or now < quiet_until:
                continue
            action = key.event(value, now)
            if action is not None:
                act(action, dry_run)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
