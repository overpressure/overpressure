#!/bin/bash
# Boot the sensor DSP like PICO OS's init does (write /sys/kernel/boot_slpi/boot)
# and wait until its subsystem reports ONLINE. The firmware (slpi.mdt, .bNN)
# comes from the headset's own modem partition, see XR.md.
. /usr/libexec/pico4-poc/lib.sh
set -u

subsys_dir() {
	local d
	for d in /sys/bus/msm_subsys/devices/*; do
		[ "$(cat "$d/name" 2>/dev/null)" = slpi ] && { echo "$d"; return 0; }
	done
	return 1
}

subsys_state() {
	local d
	d=$(subsys_dir) && cat "$d/state" 2>/dev/null || echo missing
}

# The kernel default for the SLPI is restart level SYSTEM: any DSP crash or
# restart request reboots the whole headset. PICO OS relaxes it the same way.
dir=$(subsys_dir) && write RELATED "$dir/restart_level"

state=$(subsys_state)
if [ "$state" = ONLINE ]; then
	log "slpi: already online"
	exit 0
fi
[ -w /sys/kernel/boot_slpi/boot ] || { log "slpi: no /sys/kernel/boot_slpi/boot"; exit 1; }
log "slpi: booting (state $state)"
echo 1 > /sys/kernel/boot_slpi/boot || { log "slpi: boot request failed"; exit 1; }
for _ in $(seq 1 "$(poc_arg slpi_timeout 30)"); do
	state=$(subsys_state)
	if [ "$state" = ONLINE ]; then
		log "slpi: online"
		exit 0
	fi
	sleep 1
done
log "slpi: not online after boot request (state $state)"
dmesg | grep -iE 'slpi|ssc|subsys|pil' | tail -n 20 | while IFS= read -r line; do log "slpi: $line"; done
exit 1
