#!/bin/bash
# Restarts the session with Monado's target. Two triggers:
#   session-fallback steamvr   SteamVR failed for good (pico4-session-fallback.path, the flag
#                              the user manager's pico4-steamvr-failed.service touches)
#   session-fallback session   the session kept ending (pico4-session.service's OnFailure=,
#                              pico4-session-failed.service)
# When Monado's session is the one that kept ending, nothing is left to fall back to: the
# session stays failed rather than restarting without end.
set -euo pipefail
dir=/run/pico4-session
reason=${1:-steamvr}
# The path unit starts this service as long as the flag exists: remove it first, whatever follows.
rm -f "$dir/steamvr-failed"
case "$reason" in
steamvr) ;;
session)
	# systemd passes the session's result: only its start limit means the session kept ending;
	# a deliberate stop that failed (a stop timeout) stays stopped.
	if [ "${MONITOR_SERVICE_RESULT:-}" != start-limit-hit ]; then
		echo "the session failed with '${MONITOR_SERVICE_RESULT:-}', not by ending again and again" >&2
		exit 0
	fi
	if [ "$(cat "$dir/target" 2>/dev/null || true)" = pico4-session.target ]; then
		echo "Monado's session kept ending; no session to fall back to" >&2
		exit 0
	fi
	;;
*)
	echo "usage: session-fallback steamvr|session" >&2
	exit 2
	;;
esac
echo PICO4_SESSION_TARGET=pico4-session.target > "$dir/override"
# The session keeps the override for this deliberate start too (/usr/libexec/pico4-poc/session).
touch "$dir/fallback-start"
# A session that hit its start limit starts only after the count is reset.
systemctl reset-failed pico4-session.service
systemctl restart pico4-session.service
