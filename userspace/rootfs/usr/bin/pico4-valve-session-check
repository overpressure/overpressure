#!/bin/bash
# Valve's VR session on the PICO 4 (roadmap step 6, docs/session.md): runs Valve's
# gamescope-session.target through pico4-session.service for a short while, then
# returns to the configured session. Checks that SteamVR's compositor drives the
# panels through the pico4-vrdisplay layer and that SteamVR tracks the headset
# and both controllers. Prints one JSON object; exit status 0 only if it passed.
# "status" is that integration verdict. "performance" is a verdict of its own
# (session-performance): frame rate and pacing over the run after startup,
# against the limits it lists.
#
#   pico4-valve-session-check [--seconds SECONDS]
#
# The session keeps the GPU busy and heats the headset quickly: SECONDS (default
# 30) bounds the run after startup. The hottest thermal zone and the fan daemon's
# state (docs/cooling.md) are recorded before and after. Validated on the host by
# pico4/userspace.py (validate_valve_session).
set -u
seconds=30
while [ $# -gt 0 ]; do
	case "$1" in
	--seconds) seconds=$2; shift ;;
	*) echo "usage: $0 [--seconds SECONDS]" >&2; exit 2 ;;
	esac
	shift
done

json_str() {
	local s=${1//\\/\\\\}
	s=${s//\"/\\\"}
	s=${s//$'\n'/\\n}
	s=${s//$'\t'/ }
	printf '"%s"' "$s"
}
json_list() {
	local first=1 item
	printf '['
	while IFS= read -r item; do
		[ -n "$item" ] || continue
		[ $first = 1 ] || printf ','
		json_str "$item"
		first=0
	done
	printf ']'
}

user=steamos
uid=$(id -u "$user")
home=$(getent passwd "$user" | cut -d: -f6)
logs=$home/.local/share/Steam/logs
conf=/etc/pico4-poc/session.conf
work=/run/pico4-valve-session # the compositor (the session user) writes the layer's files here
dropin=/run/systemd/user/steamvr.service.d/60-pico4-check.conf
errors=()
user_systemctl() {
	runuser -u "$user" -- env "XDG_RUNTIME_DIR=/run/user/$uid" \
		"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus" systemctl --user "$@"
}
max_temp() { # hottest thermal zone, degrees C
	cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | awk '$1 < 200000 && $1 > m {m = $1} END {printf "%.1f", m / 1000}'
}
fan_state() { # pico4-fan's duty, RPM and hottest mean, or null without the daemon
	local s
	s=$(pico4-fan state 2>/dev/null)
	if grep -q '^{' <<<"$s"; then printf '%s' "$s"; else printf null; fi
}

# Valve's session for the duration of the check; the layer reports into $work.
saved=""
[ -s "$conf" ] && saved=$(cat "$conf")
rm -rf "$work"
install -d -o "$user" -m 0755 "$work"
mkdir -p "${dropin%/*}"
printf '[Service]\nEnvironment=PICO4_VRDISPLAY_STATS=%s/vrdisplay.json PICO4_VRDISPLAY_DUMP=%s/vrdisplay.ppm\n' \
	"$work" "$work" > "$dropin"
# The user manager outlives a session restart (logind stops it only after a delay), so it
# must read the drop-in now; without a running manager the next one reads it at its start.
user_systemctl daemon-reload 2>/dev/null || true
rm -f "$logs"/*.txt
# driver_monado in SteamVR owns the hardware: the Monado service must not hold it.
systemctl stop pico4-monado.service
temp_before=$(max_temp)
fan_before=$(fan_state)
echo PICO4_SESSION_TARGET=gamescope-session.target > "$conf"
systemctl restart pico4-session.service

# Startup: the compositor's log, then the layer's first statistics (ten seconds of frames).
startup=-1
for i in $(seq 180); do
	if grep -qs "Startup Complete" "$logs/vrcompositor.txt" && [ -s "$work/vrdisplay.json" ]; then
		startup=$i
		break
	fi
	sleep 1
done
[ "$startup" -ge 0 ] || errors+=("SteamVR's compositor did not start presenting within 180 s")
# SteamVR's startup stalls the compositor a few times while the dashboard starts.
# The measured window starts with the first statistics update (every ten seconds) that
# adds no stall, or after 60 s; the startup's stalls are reported on their own.
stalls() { sed -n 's/.*"stalls":\([0-9]*\).*/\1/p' "$1" 2>/dev/null; }
cp -p "$work/vrdisplay.json" "$work/vrdisplay-start.json" 2>/dev/null
settle=0
while [ "$startup" -ge 0 ] && [ "$settle" -lt 60 ]; do
	previous=$(stat -c %Y "$work/vrdisplay-start.json" 2>/dev/null)
	while [ "$(stat -c %Y "$work/vrdisplay.json" 2>/dev/null)" = "$previous" ] && [ "$settle" -lt 60 ]; do
		sleep 1
		settle=$((settle + 1))
	done
	before=$(stalls "$work/vrdisplay-start.json")
	cp -p "$work/vrdisplay.json" "$work/vrdisplay-start.json" 2>/dev/null
	[ "$(stalls "$work/vrdisplay-start.json")" != "$before" ] || break
done
[ "$startup" -lt 0 ] || sleep "$seconds"

target_state=$(user_systemctl is-active gamescope-session.target 2>/dev/null)
steamvr_state=$(user_systemctl is-active steamvr.service 2>/dev/null)
gamescope_state=$(user_systemctl is-active gamescope-session.service 2>/dev/null)
failed=$(user_systemctl list-units --failed --plain --no-legend 2>/dev/null | awk '{print $1}')
started=false
grep -qs "Startup Complete" "$logs/vrcompositor.txt" && started=true
gamescope_client=false
grep -qs "External connection from /usr/bin/gamescope" "$logs/vrcompositor.txt" && gamescope_client=true
asserts=$(grep -s -c "ASSERT" "$logs/vrcompositor.txt")
present_wait_errors=$(grep -s -c "failed to wait for present" "$logs/vrcompositor.txt")
stats=$(cat "$work/vrdisplay.json" 2>/dev/null)
grep -q '^{' <<<"$stats" || stats=null
# SteamVR's own view of the tracked devices: index, position (m), rotation (rad).
devices=$(runuser -u "$user" -- env "HOME=$home" "XDG_RUNTIME_DIR=/run/user/$uid" \
	timeout 3 /opt/steamvr/bin/linuxarm64/vrcmd --pollposes 2>/dev/null |
	awk -F, 'NF == 7 && $1 ~ /^[0-9]+$/ {
			# vrcmd now and then prints a line with an empty or cut value ("3."): not valid JSON.
			for (i = 2; i <= 7; i++) if ($i !~ /^ *-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?$/) next
			last[$1] = $0}
		END {printf "["; n = 0; for (i = 0; i < 16; i++) if (i in last) {split(last[i], v, ",");
			printf "%s{\"index\":%d,\"position\":[%s,%s,%s],\"rotation\":[%s,%s,%s]}", n++ ? "," : "",
				v[1], v[2], v[3], v[4], v[5], v[6], v[7]} printf "]"}')
grep -q '^\[' <<<"$devices" || devices="[]"
temp_after=$(max_temp)
fan_after=$(fan_state)
performance=$(/usr/libexec/pico4-poc/session-performance "$work/vrdisplay-start.json" "$work/vrdisplay.json" "${temp_after:-nan}" 2>/dev/null)
grep -q '^{' <<<"$performance" || performance='{"status":"failed","failures":["no performance verdict"]}'

[ "$target_state" = active ] || errors+=("gamescope-session.target is $target_state")
[ "$steamvr_state" = active ] || errors+=("steamvr.service is $steamvr_state")
[ "$gamescope_state" = active ] || errors+=("gamescope-session.service is $gamescope_state")
[ "$started" = true ] || errors+=("SteamVR's compositor did not complete its startup")
[ "$gamescope_client" = true ] || errors+=("gamescope did not connect to SteamVR")
[ "${asserts:-0}" = 0 ] || errors+=("SteamVR's compositor asserted")
[ "$stats" != null ] || errors+=("the display layer wrote no statistics")
grep -q '"index":2' <<<"$devices" || errors+=("SteamVR does not report the headset and both controllers")

# Back to the configured session.
rm -f "$dropin"
user_systemctl daemon-reload 2>/dev/null || true
if [ -n "$saved" ]; then printf '%s\n' "$saved" > "$conf"; else rm -f "$conf"; fi
systemctl restart pico4-session.service
restored=$(systemctl is-active pico4-session.service)
[ "$restored" = active ] || errors+=("pico4-session.service is $restored after the check")

status=passed
[ ${#errors[@]} = 0 ] || status=failed
printf '{"schema":1,"status":%s' "$(json_str "$status")"
printf ',"errors":%s' "$(printf '%s\n' "${errors[@]+"${errors[@]}"}" | json_list)"
printf ',"seconds":%s,"startup_seconds":%s,"settle_seconds":%s' "$seconds" "$startup" "$settle"
printf ',"session":{"target":"gamescope-session.target","target_state":%s,"steamvr":%s,"gamescope":%s,"failed_units":%s,"restored":%s}' \
	"$(json_str "$target_state")" "$(json_str "$steamvr_state")" "$(json_str "$gamescope_state")" \
	"$(json_list <<<"$failed")" "$(json_str "$restored")"
printf ',"compositor":{"started":%s,"gamescope_client":%s,"asserts":%s,"present_wait_errors":%s}' \
	"$started" "$gamescope_client" "${asserts:-0}" "${present_wait_errors:-0}"
printf ',"layer":%s,"devices":%s,"max_temp_c":{"before":%s,"after_run":%s}' "$stats" "$devices" \
	"${temp_before:-null}" "${temp_after:-null}"
printf ',"fan":{"before":%s,"after_run":%s},"performance":%s}\n' "$fan_before" "$fan_after" "$performance"
[ "$status" = passed ]
