#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Be the WLAN firmware's second control client, as PICO OS's cnss-daemon is (docs/userspace.md#wi-fi).

The QCA6390's firmware serves WLFW (QMI service 0x45, instance 1) once cnss2 has powered it up.
The PICO 4's device tree sets cnss-daemon-support, so the kernel tells the firmware in its host
capability that two clients exist, and the firmware holds back its memory request, and with it
"FW ready", until the second client has registered. This tool registers as PICO OS's cnss-daemon
does (5.13.7 vendor/bin/cnss-daemon), from the message tables compiled into it:

- the indication-register request (0x20, built at 0x110b0): FW ready, calibration download and
  update, and FW-memory-ready indications on (TLVs 0x10, 0x11, 0x12, 0x17), its client id
  "DMON" (TLV 0x15). The daemon also asks for QDSS trace-save indications (TLV 0x1D); that path
  is not reimplemented;
- on "FW memory ready" (indication 0x37), the capability request (0x24, no TLVs, built at
  0x11234) and the calibration report (0x26, built at 0x11404): no calibration files (TLV 0x01,
  count 0) and TLV 0x11 = 1, as the daemon sends on a first boot.

It logs every response and indication, and registers again when the service comes back after a
firmware restart. Calibration data is not kept: storage is read-only, so each boot calibrates
cold, as PICO OS does without cal files.

    pico4-wlfw-client [-v]
"""

from __future__ import annotations

import argparse
import os
import select
import socket
import struct
import sys

AF_QIPCRTR = getattr(socket, "AF_QIPCRTR", 42)
QRTR_PORT_CTRL = 0xFFFFFFFE
QRTR_TYPE_NEW_SERVER = 4
QRTR_TYPE_DEL_SERVER = 5
QRTR_TYPE_NEW_LOOKUP = 10

WLFW_SERVICE = 0x45
QMI_REQUEST, QMI_RESPONSE, QMI_INDICATION = 0, 2, 4

MSG_IND_REGISTER = 0x20
MSG_CAP = 0x24
MSG_CAL_REPORT = 0x26
IND_FW_MEM_READY = 0x37
#: The indications cnss-daemon handles (its jump table at rodata 0x7f0b), for the log.
INDICATIONS = {0x21: "FW ready", 0x28: "initiate calibration download",
               0x2A: "initiate calibration update", 0x2B: "message 0x2b",
               IND_FW_MEM_READY: "FW memory ready", 0x41: "message 0x41"}

CLIENT_ID = 0x444D4F4E  # "DMON", cnss-daemon's (0x110ec)


def qmi_tlv(tlv_type: int, value: bytes) -> bytes:
    return struct.pack("<BH", tlv_type, len(value)) + value


def qmi_message(msg_type: int, txn: int, msg_id: int, tlvs: bytes) -> bytes:
    return struct.pack("<BHHH", msg_type, txn, msg_id, len(tlvs)) + tlvs


def qmi_parse(packet: bytes):
    if len(packet) < 7:
        raise ValueError("short QMI packet")
    msg_type, txn, msg_id, length = struct.unpack_from("<BHHH", packet)
    tlvs = {}
    pos, end = 7, min(len(packet), 7 + length)
    while pos + 3 <= end:
        tlv_type, tlv_len = struct.unpack_from("<BH", packet, pos)
        pos += 3
        tlvs[tlv_type] = packet[pos:pos + tlv_len]
        pos += tlv_len
    return msg_type, txn, msg_id, tlvs


def ind_register(txn: int) -> bytes:
    """cnss-daemon's indication registration on the PCIe path (instance ids 1-3), without QDSS."""
    one = bytes([1])
    return qmi_message(QMI_REQUEST, txn, MSG_IND_REGISTER,
                       qmi_tlv(0x10, one) + qmi_tlv(0x11, one) + qmi_tlv(0x12, one)
                       + qmi_tlv(0x15, struct.pack("<I", CLIENT_ID)) + qmi_tlv(0x17, one))


def cap_request(txn: int) -> bytes:
    return qmi_message(QMI_REQUEST, txn, MSG_CAP, b"")


def cal_report(txn: int) -> bytes:
    """No calibration files: a count of 0, then TLV 0x11 = 1."""
    return qmi_message(QMI_REQUEST, txn, MSG_CAL_REPORT, qmi_tlv(0x01, bytes([0])) + qmi_tlv(0x11, bytes([1])))


def lookup_packet() -> bytes:
    return struct.pack("<IIIII", QRTR_TYPE_NEW_LOOKUP, WLFW_SERVICE, 0, 0, 0)


def result(tlvs: dict) -> tuple[int, int]:
    return struct.unpack("<HH", tlvs.get(0x02, b"\0\0\0\0")[:4])


class Client:
    """Registers with each WLFW server that appears and answers FW memory ready."""

    def __init__(self, sock, log):
        self.sock = sock
        self.log = log
        self.node = sock.getsockname()[0]
        self.server = None
        self.txn = 0

    def _send(self, build) -> None:
        self.txn = (self.txn + 1) & 0xFFFF or 1
        self.sock.sendto(build(self.txn), self.server)

    def start(self) -> None:
        self.sock.sendto(lookup_packet(), (self.node, QRTR_PORT_CTRL))

    def handle(self, data: bytes, addr) -> None:
        if addr[1] == QRTR_PORT_CTRL:
            self._control(data)
        elif self.server is not None and tuple(addr[:2]) == self.server:
            self._qmi(data)

    def _control(self, data: bytes) -> None:
        if len(data) < 20:
            return
        cmd, service, instance, node, port = struct.unpack_from("<IIIII", data)
        if service != WLFW_SERVICE or not (node or port):
            return
        if cmd == QRTR_TYPE_NEW_SERVER:
            self.server = (node, port)
            self.log(f"WLFW service (instance {instance >> 8}, version {instance & 0xFF}) at node {node} port {port}: "
                     "registering")
            self._send(ind_register)
        elif cmd == QRTR_TYPE_DEL_SERVER and self.server == (node, port):
            self.log("WLFW service gone")
            self.server = None

    def _qmi(self, data: bytes) -> None:
        msg_type, txn, msg_id, tlvs = qmi_parse(data)
        if msg_type == QMI_RESPONSE:
            code, error = result(tlvs)
            self.log(f"response to 0x{msg_id:02x}: result {code} error {error}")
        elif msg_type == QMI_INDICATION:
            self.log(f"indication 0x{msg_id:02x} ({INDICATIONS.get(msg_id, 'unhandled')})")
            if msg_id == IND_FW_MEM_READY:
                self._send(cap_request)
                self._send(cal_report)


def notify_ready(environ=os.environ) -> None:
    """Tell systemd (Type=notify) that the service lookup is out: the firmware may start now."""
    path = environ.get("NOTIFY_SOCKET")
    if not path:
        return
    if path.startswith("@"):
        path = "\0" + path[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
        sock.connect(path)
        sock.sendall(b"READY=1")


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("-v", "--verbose", action="store_true", help="unused; every event is logged")
    parser.parse_args(argv)
    sock = socket.socket(AF_QIPCRTR, socket.SOCK_DGRAM)
    client = Client(sock, lambda message: print(message, file=sys.stderr, flush=True))
    client.start()
    notify_ready()
    while True:
        select.select([sock], [], [])
        data, addr = sock.recvfrom(65536)
        try:
            client.handle(data, addr)
        except (ValueError, struct.error) as exc:
            print(f"bad packet from {addr}: {exc}", file=sys.stderr, flush=True)


if __name__ == "__main__":
    sys.exit(main())
