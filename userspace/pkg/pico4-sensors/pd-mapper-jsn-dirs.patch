--- a/pd-mapper.c
+++ b/pd-mapper.c
@@ -372,7 +372,48 @@ close_class:
 	return 0;
 }
 
-static int pd_load_maps(void)
+/*
+ * Vendor kernels load remote processors with PIL and have no remoteproc class:
+ * collect the .jsn files of an explicitly named directory instead.
+ */
+static void pd_enumerate_dir(struct assoc *json_set, const char *dir)
+{
+	char json_path[PATH_MAX];
+	struct dirent *de;
+	DIR *d;
+	int i;
+
+	d = opendir(dir);
+	if (!d) {
+		warn("cannot open %s", dir);
+		return;
+	}
+
+	while ((de = readdir(d)) != NULL) {
+		size_t len = strlen(de->d_name);
+
+		for (i = 0; known_extensions[i] != NULL; i++) {
+			size_t ext = strlen(known_extensions[i]);
+
+			if (len > ext && !strcmp(&de->d_name[len - ext], known_extensions[i]))
+				break;
+		}
+		if (known_extensions[i] == NULL)
+			continue;
+
+		if (strlen(dir) + 1 + len + 1 > sizeof(json_path))
+			continue;
+
+		strcpy(json_path, dir);
+		strcat(json_path, "/");
+		strcat(json_path, de->d_name);
+		assoc_set(json_set, json_path, NULL);
+	}
+
+	closedir(d);
+}
+
+static int pd_load_maps(int ndirs, char **dirs)
 {
 	struct assoc json_set;
 	unsigned long it;
@@ -381,7 +422,12 @@ static int pd_load_maps(void)
 
 	assoc_init(&json_set, 20);
 
-	pd_enumerate_jsons(&json_set);
+	if (ndirs > 0) {
+		for (int i = 0; i < ndirs; i++)
+			pd_enumerate_dir(&json_set, dirs[i]);
+	} else {
+		pd_enumerate_jsons(&json_set);
+	}
 
 	assoc_foreach(jsn, NULL, &json_set, it) {
 		ret = pd_load_map(jsn);
@@ -404,7 +450,7 @@ int main(int argc, char **argv)
 	int ret;
 	int fd;
 
-	ret = pd_load_maps();
+	ret = pd_load_maps(argc - 1, argv + 1);
 	if (ret)
 		exit(1);
 
