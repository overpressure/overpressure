--- a/src/xrt/state_trackers/steamvr_drv/ovrd_driver.cpp
+++ b/src/xrt/state_trackers/steamvr_drv/ovrd_driver.cpp
@@ -121,7 +121,8 @@
 		m_pose->poseIsValid = false;
 	}
 
-	if ((rel->relation_flags & XRT_SPACE_RELATION_POSITION_TRACKED_BIT) != 0) {
+	// Inferred positions too: 3DoF controllers place themselves with an arm model.
+	if ((rel->relation_flags & XRT_SPACE_RELATION_POSITION_VALID_BIT) != 0) {
 		copy_vec3(&rel->pose.position, m_pose->vecPosition);
 	} else {
 	}
@@ -436,6 +437,17 @@
 	{
 		enum xrt_input_type monado_input_type = XRT_GET_INPUT_TYPE(monado_input_name);
 
+		// One profile serves both hands (the PICO 4's A/B are on the right controller, X/Y on
+		// the left): leave out what this device lacks instead of missing it every frame.
+		bool present = false;
+		for (uint32_t i = 0; i < m_xdev->input_count && !present; i++) {
+			present = m_xdev->inputs[i].name == monado_input_name;
+		}
+		if (!present) {
+			ovrd_log("No input for %s on this device\n", steamvr_control_path);
+			return;
+		}
+
 		SteamVRDriverControlInput in;
 
 		in.monado_input_type = monado_input_type;
@@ -873,6 +885,8 @@
 			grip_name = XRT_INPUT_TOUCH_GRIP_POSE;
 		} else if (m_xdev->name == XRT_DEVICE_SIMPLE_CONTROLLER) {
 			grip_name = XRT_INPUT_SIMPLE_GRIP_POSE;
+		} else if (m_xdev->name == XRT_DEVICE_PICO4_CONTROLLER) {
+			grip_name = XRT_INPUT_PICO4_GRIP_POSE;
 		} else {
 			ovrd_log("Unhandled device name %u\n", m_xdev->name);
 			grip_name = XRT_INPUT_GENERIC_HEAD_POSE; // ???
@@ -1381,8 +1395,9 @@
 
 
 
-	*pnWidth = m_xdev->hmd->screens[0].w_pixels * fscale;
-	*pnHeight = m_xdev->hmd->screens[0].h_pixels * fscale;
+	// OpenVR asks for one eye's size; screens[0] spans both eyes on side-by-side panels.
+	*pnWidth = m_xdev->hmd->views[0].display.w_pixels * fscale;
+	*pnHeight = m_xdev->hmd->views[0].display.h_pixels * fscale;
 
 	ovrd_log("Render Target Size: %dx%d (%fx)\n", *pnWidth, *pnHeight, fscale);
 }
