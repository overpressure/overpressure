# Extra configuration for the step-4 userspace test kernel (mainline 4.19 LTS),
# applied after kernel.fragment. It reproduces the stock PICO 4 kernel's
# answers to what systemd and the SteamOS userspace ask of a kernel, as read
# from its IKCONFIG (see docs/userspace.md, "Kernel compatibility"). Same
# syscall surface as the stock 4.19.81: no pidfd, clone3, openat2 or new
# mount API. Android-only patches (PARANOID_NETWORK, KGSL, SDE, the PSI
# backport) cannot be reproduced in QEMU.
CONFIG_EXPERT=y
# CONFIG_FHANDLE is not set
# CONFIG_VT is not set
# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_USER_NS is not set
# CONFIG_PID_NS is not set
# CONFIG_IPC_NS is not set
# CONFIG_UTS_NS is not set
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
# CONFIG_MEMCG is not set
# CONFIG_CGROUP_PIDS is not set
# CONFIG_CGROUP_DEVICE is not set
CONFIG_BPF_SYSCALL=y
CONFIG_SECCOMP=y
CONFIG_AUDIT=y
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_FANOTIFY is not set
# CONFIG_AUTOFS4_FS is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_SQUASHFS is not set
# CONFIG_HIDRAW is not set
# CONFIG_DMIID is not set
# CONFIG_CRYPTO_USER_API_HASH is not set
CONFIG_UEVENT_HELPER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_EXT4_FS=y
# CONFIG_EXT4_FS_POSIX_ACL is not set
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZO=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_UHID=y
