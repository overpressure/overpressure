# The PICO 4 on Valve's Frame kernel: merged over linux-valve's gabe_defconfig (SM8650).
# Phase 0 adds what the XR2 (SM8250) needs to boot stage 1 from UFS with the USB gadget;
# stage 1 loads no modules on this kernel, so everything here is built in.
CONFIG_LOCALVERSION="-pico4"

# SM8250 SoC support beside the Frame's SM8650
CONFIG_PINCTRL_SM8250=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_QCOM_LLCC=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y

# Display and GPU: SM8250's display and GPU clock controllers, the panel driver
CONFIG_SM_DISPCC_8250=y
CONFIG_SM_GPUCC_8250=y
# the GPU's speed bin is an eFuse in QFPROM; the DSI links' reference voltage (REFGEN)
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_REGULATOR_QCOM_REFGEN=y
# the controller station's supply as a userspace switch (regulator-output)
CONFIG_REGULATOR_USERSPACE_CONSUMER=y
# the four tracking cameras (OmniVision OV7251) on CAMSS, with SM8250's camera clock controller
CONFIG_SM_CAMCC_8250=y
CONFIG_VIDEO_OV7251=y
CONFIG_DRM_PANEL_PICO4_LS026B3SA=y

# USB gadget functions stage 1 uses: NCM network, a serial console, the read-only log drive
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# Reboot modes for the ABL (bootloader, recovery) and the RAM console across a warm reboot
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_REBOOT_MODE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# The DSPs' IPC router over their GLINK channels: the sensor service (head IMU), PD notifications
# and audio reach the apps through it; FastRPC alone has its own channel.
CONFIG_QRTR_SMD=y

# Wi-Fi: the QCA6390 on PCIe 0 (ath11k); its power sequencer powers the function before the
# bus enumerates it. Bluetooth (hci_qca on QUP0 UART 6) is in the Frame's configuration.
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
