From: overpressure <overpressure@pico4>
Subject: [PATCH] misc: fastrpc: map a client's buffer through mmap

The vendor driver's mmap also maps a buffer the client allocated itself:
its DMA-BUF at the client's address, with the client's flags, through
the remote mmap method. PICO OS's FastRPC library serves the DSP's own
requests for memory (apps_mem) that way, and upstream refused every
flag but its own allocations, so the CDSP's message daemon and the
tracker's buffers had no memory. A request with a descriptor and other
flags now maps that buffer; munmap finds such maps too.
---
diff --git a/drivers/misc/fastrpc.c b/drivers/misc/fastrpc.c
index bc979891b2dd..8c67a081d718 100644
--- a/drivers/misc/fastrpc.c
+++ b/drivers/misc/fastrpc.c
@@ -1947,6 +1947,99 @@ static int fastrpc_req_munmap_impl(struct fastrpc_user *fl, struct fastrpc_buf *
 	return err;
 }
 
+/*
+ * The vendor ABI's mmap also maps a buffer the client allocated: its DMA-BUF (fd) at the
+ * client's address (vaddrin), with the client's flags, through the same remote mmap method.
+ * PICO OS's libraries serve the DSP's own requests for memory (apps_mem) this way.
+ */
+static int fastrpc_req_mmap_fd(struct fastrpc_user *fl, struct fastrpc_req_mmap *req)
+{
+	struct fastrpc_invoke_args args[3] = { [0 ... 2] = { 0 } };
+	struct fastrpc_mmap_req_msg req_msg;
+	struct fastrpc_mmap_rsp_msg rsp_msg;
+	struct fastrpc_phy_page pages;
+	struct device *dev = fl->sctx->dev;
+	struct fastrpc_map *map = NULL;
+	int err;
+	u32 sc;
+
+	err = fastrpc_map_create(fl, req->fd, req->size, 0, &map);
+	if (err) {
+		dev_err(dev, "failed to map buffer, fd = %d\n", req->fd);
+		return err;
+	}
+
+	req_msg.client_id = fl->client_id;
+	req_msg.flags = req->flags;
+	req_msg.vaddr = req->vaddrin;
+	req_msg.num = sizeof(pages);
+
+	args[0].ptr = (u64) (uintptr_t) &req_msg;
+	args[0].length = sizeof(req_msg);
+
+	pages.addr = map->dma_addr;
+	pages.size = map->len;
+
+	args[1].ptr = (u64) (uintptr_t) &pages;
+	args[1].length = sizeof(pages);
+
+	args[2].ptr = (u64) (uintptr_t) &rsp_msg;
+	args[2].length = sizeof(rsp_msg);
+
+	sc = FASTRPC_SCALARS(FASTRPC_RMID_INIT_MMAP, 2, 1);
+	err = fastrpc_internal_invoke(fl, true, FASTRPC_INIT_HANDLE, sc, &args[0]);
+	if (err) {
+		dev_err(dev, "mmap error, fd %d (len 0x%08llx)\n", req->fd, map->len);
+		fastrpc_map_put(map);
+		return err;
+	}
+
+	map->va = (void *) (uintptr_t) req->vaddrin;
+	map->raddr = rsp_msg.vaddr;
+	req->vaddrout = rsp_msg.vaddr;
+
+	return 0;
+}
+
+/* Unmaps a client's buffer that fastrpc_req_mmap_fd() mapped; -ENOENT if there is none. */
+static int fastrpc_req_munmap_fd(struct fastrpc_user *fl, struct fastrpc_req_munmap *req)
+{
+	struct fastrpc_invoke_args args[1] = { [0] = { 0 } };
+	struct fastrpc_munmap_req_msg req_msg;
+	struct fastrpc_map *map = NULL, *iter;
+	int err;
+	u32 sc;
+
+	spin_lock(&fl->lock);
+	list_for_each_entry(iter, &fl->maps, node) {
+		if (iter->raddr == req->vaddrout && iter->len == req->size) {
+			map = iter;
+			break;
+		}
+	}
+	spin_unlock(&fl->lock);
+
+	if (!map)
+		return -ENOENT;
+
+	req_msg.client_id = fl->client_id;
+	req_msg.size = map->len;
+	req_msg.vaddr = map->raddr;
+
+	args[0].ptr = (u64) (uintptr_t) &req_msg;
+	args[0].length = sizeof(req_msg);
+
+	sc = FASTRPC_SCALARS(FASTRPC_RMID_INIT_MUNMAP, 1, 0);
+	err = fastrpc_internal_invoke(fl, true, FASTRPC_INIT_HANDLE, sc, &args[0]);
+	if (err) {
+		dev_err(fl->sctx->dev, "unmmap\tpt fd = %d, 0x%09llx error\n", map->fd, map->raddr);
+		return err;
+	}
+	fastrpc_map_put(map);
+
+	return 0;
+}
+
 static int fastrpc_req_munmap(struct fastrpc_user *fl, char __user *argp)
 {
 	struct fastrpc_buf *buf = NULL, *iter, *b;
@@ -1968,9 +2061,11 @@ static int fastrpc_req_munmap(struct fastrpc_user *fl, char __user *argp)
 	spin_unlock(&fl->lock);
 
 	if (!buf) {
-		dev_err(dev, "mmap\t\tpt 0x%09llx [len 0x%08llx] not in list\n",
-			req.vaddrout, req.size);
-		return -EINVAL;
+		err = fastrpc_req_munmap_fd(fl, &req);
+		if (err == -ENOENT)
+			dev_err(dev, "mmap\t\tpt 0x%09llx [len 0x%08llx] not in list\n",
+				req.vaddrout, req.size);
+		return err == -ENOENT ? -EINVAL : err;
 	}
 
 	err = fastrpc_req_munmap_impl(fl, buf);
@@ -1999,9 +2094,20 @@ static int fastrpc_req_mmap(struct fastrpc_user *fl, char __user *argp)
 		return -EFAULT;
 
 	if (req.flags != ADSP_MMAP_ADD_PAGES && req.flags != ADSP_MMAP_REMOTE_HEAP_ADDR) {
-		dev_err(dev, "flag not supported 0x%x\n", req.flags);
+		if (req.fd < 0) {
+			dev_err(dev, "flag not supported 0x%x\n", req.flags);
+			return -EINVAL;
+		}
+		err = fastrpc_req_mmap_fd(fl, &req);
+		if (err)
+			return err;
+		if (copy_to_user((void __user *)argp, &req, sizeof(req))) {
+			struct fastrpc_req_munmap unmap = { .vaddrout = req.vaddrout, .size = req.size };
 
-		return -EINVAL;
+			fastrpc_req_munmap_fd(fl, &unmap);
+			return -EFAULT;
+		}
+		return 0;
 	}
 
 	if (req.vaddrin) {
