From: overpressure <overpressure@pico4>
Subject: [PATCH] media: venus: compressed capture formats as iris reports them

Steam Link's client sets QC08C or QC10C after the source change, builds a Vulkan image with
DRM_FORMAT_MOD_QCOM_COMPRESSED from the format's bytesperline, and queues that image's dma-buf with
the format's sizeimage as its length. Iris reports QC10C's real pitch and the pictures' size. Venus
reported the 8-bit pitch for QC10C, which makes the image too small, and added an extradata margin
to both sizes, which is more than the image holds at any pitch: every capture buffer was refused
with EFAULT. The firmware does not use the margin, its pictures end before it.
---
--- a/drivers/media/platform/qcom/vcodec/venus/helpers.c
+++ b/drivers/media/platform/qcom/vcodec/venus/helpers.c
@@ -966,7 +966,6 @@
 	u32 y_stride, y_plane;
 	u32 uv_meta_stride, uv_meta_plane;
 	u32 uv_stride, uv_plane;
-	u32 extradata = SZ_16K;
 
 	y_meta_stride = ALIGN(DIV_ROUND_UP(width, 32), 64);
 	y_meta_plane = y_meta_stride * ALIGN(DIV_ROUND_UP(height, 8), 16);
@@ -982,8 +981,7 @@
 	uv_stride = ALIGN(width, 128);
 	uv_plane = ALIGN(uv_stride * ALIGN(height / 2, 32), SZ_4K);
 
-	return ALIGN(y_meta_plane + y_plane + uv_meta_plane + uv_plane +
-		     max(extradata, y_stride * 48), SZ_4K);
+	return ALIGN(y_meta_plane + y_plane + uv_meta_plane + uv_plane, SZ_4K);
 }
 
 static u32 get_framesize_raw_p010(u32 width, u32 height)
@@ -1035,7 +1033,6 @@
 	u32 y_meta_stride, y_meta_scanlines;
 	u32 uv_meta_stride, uv_meta_scanlines;
 	u32 y_meta_plane, uv_meta_plane;
-	u32 extradata = SZ_16K;
 	u32 size;
 
 	y_stride = ALIGN(width * 4 / 3, 256);
@@ -1053,7 +1050,6 @@
 	uv_meta_plane = ALIGN(uv_meta_stride * uv_meta_scanlines, SZ_4K);
 
 	size = y_ubwc_plane + uv_ubwc_plane + y_meta_plane + uv_meta_plane;
-	size += max(extradata + SZ_8K, y_stride * 48);
 
 	return ALIGN(size, SZ_4K);
 }
--- a/drivers/media/platform/qcom/vcodec/venus/vdec.c
+++ b/drivers/media/platform/qcom/vcodec/venus/vdec.c
@@ -228,6 +228,8 @@
 
 		pfmt[0].sizeimage = szimage;
 		pfmt[0].bytesperline = ALIGN(stride, 128);
+		if (pixmp->pixelformat == V4L2_PIX_FMT_QC10C)
+			pfmt[0].bytesperline = ALIGN(stride * 4 / 3, 256);
 	} else {
 		pfmt[0].sizeimage = clamp_t(u32, pfmt[0].sizeimage, 0, SZ_8M);
 		pfmt[0].sizeimage = max(pfmt[0].sizeimage, szimage);
