From: overpressure <overpressure@pico4>
Subject: [PATCH] ASoC: the speakers' amplifiers and codec path as the stock kernel runs them

Read from both kernels on the same headset during playback, the registers differ, and the sound with
them: a fade on the stock kernel falls evenly, here it stalls and then drops, and each sound's tail
crackles.

Mainline keeps the WSA881x's gain in register mode, where the stock kernel lets the compander set it
over the amplifier's COMP port (SPKR_DRV_GAIN), so that the macro's compander had no counterpart in
the amplifier. The boost preset, its zero-cross control and the over-current hold differ as well, as
do the macro's top configuration, boost and compander settings and path configuration. The speaker
gain offset of -1.5 dB was half applied: the half dB up without the 2 dB down.
---
--- a/sound/soc/codecs/wsa881x.c
+++ b/sound/soc/codecs/wsa881x.c
@@ -714,6 +714,10 @@
 	if (val)
 		regmap_update_bits(rm, WSA881X_BOOST_PRESET_OUT1, 0xF0, 0x70);
 
+	/* The boost as the stock kernel runs it. */
+	regmap_write(rm, WSA881X_BOOST_PRESET_OUT1, 0x07);
+	regmap_update_bits(rm, WSA881X_BOOST_ZX_CTL, 0x20, 0x00);
+
 	regmap_update_bits(rm, WSA881X_BOOST_PRESET_OUT2, 0xF0, 0x30);
 	regmap_update_bits(rm, WSA881X_SPKR_DRV_EN, 0x08, 0x08);
 	regmap_update_bits(rm, WSA881X_BOOST_CURRENT_LIMIT, 0x0F, 0x08);
@@ -919,12 +923,16 @@
 	case SND_SOC_DAPM_PRE_PMU:
 		snd_soc_component_update_bits(comp, WSA881X_SPKR_OCP_CTL,
 					      WSA881X_SPKR_OCP_MASK,
-					      WSA881X_SPKR_OCP_EN);
+					      WSA881X_SPKR_OCP_EN |
+					      WSA881X_SPKR_OCP_HOLD);
 		regmap_multi_reg_write(wsa881x->regmap, wsa881x_pre_pmu_pa_2_0,
 				       ARRAY_SIZE(wsa881x_pre_pmu_pa_2_0));
 
+		/* With the compander, the macro sets the amplifier's gain over its port. */
 		snd_soc_component_update_bits(comp, WSA881X_SPKR_DRV_GAIN,
 					      WSA881X_PA_GAIN_SEL_MASK,
+					      wsa881x->port_enable[WSA881X_PORT_COMP] ?
+					      WSA881X_PA_GAIN_SEL_DRE :
 					      WSA881X_PA_GAIN_SEL_REG);
 		break;
 	case SND_SOC_DAPM_POST_PMU:
--- a/sound/soc/codecs/lpass-wsa-macro.c
+++ b/sound/soc/codecs/lpass-wsa-macro.c
@@ -1907,6 +1907,9 @@
 					CDC_WSA_RX1_RX_PATH_MIX_SEC0,
 					CDC_WSA_RX_PGA_HALF_DB_MASK,
 					CDC_WSA_RX_PGA_HALF_DB_ENABLE);
+			/* The half dB up and this 2 dB down are the offset of -1.5 dB. */
+			snd_soc_component_write(component, gain_reg,
+				(snd_soc_component_read(component, gain_reg) - 2) & 0xff);
 		}
 		wsa_macro_config_ear_spkr_gain(component, wsa,
 						event, gain_reg);
@@ -1934,6 +1937,8 @@
 					CDC_WSA_RX1_RX_PATH_MIX_SEC0,
 					CDC_WSA_RX_PGA_HALF_DB_MASK,
 					CDC_WSA_RX_PGA_HALF_DB_DISABLE);
+			snd_soc_component_write(component, gain_reg,
+				(snd_soc_component_read(component, gain_reg) + 2) & 0xff);
 		}
 		wsa_macro_config_ear_spkr_gain(component, wsa,
 						event, gain_reg);
@@ -2519,7 +2524,7 @@
 	const struct snd_soc_dapm_widget *widgets;
 	const struct snd_soc_dapm_route *routes;
 	unsigned int num_widgets, num_routes;
-	int ret;
+	int ret, i;
 
 	snd_soc_component_init_regmap(comp, wsa->regmap);
 
@@ -2536,6 +2541,18 @@
 
 	wsa_macro_set_spkr_mode(comp, WSA_MACRO_SPKR_MODE_1);
 
+	/* The speaker paths as the stock kernel sets them up. */
+	snd_soc_component_update_bits(comp, CDC_WSA_TOP_TOP_CFG1, 0x03, 0x03);
+	for (i = 0; i < 2; i++) {
+		snd_soc_component_update_bits(comp, CDC_WSA_BOOST0_BOOST_CFG1 + i * 0x40, 0x3f, 0x12);
+		snd_soc_component_update_bits(comp, CDC_WSA_BOOST0_BOOST_CFG2 + i * 0x40, 0x1c, 0x08);
+		snd_soc_component_update_bits(comp, CDC_WSA_COMPANDER0_CTL7 + i * 0x40, 0x1e, 0x18);
+		snd_soc_component_update_bits(comp, CDC_WSA_RX0_RX_PATH_CFG0 +
+					      i * WSA_MACRO_RX_PATH_OFFSET, 0x01, 0x01);
+		snd_soc_component_update_bits(comp, CDC_WSA_RX0_RX_PATH_MIX_CFG +
+					      i * WSA_MACRO_RX_PATH_OFFSET, 0x01, 0x01);
+	}
+
 	switch (wsa->codec_version) {
 	case LPASS_CODEC_VERSION_1_0:
 	case LPASS_CODEC_VERSION_1_1:
