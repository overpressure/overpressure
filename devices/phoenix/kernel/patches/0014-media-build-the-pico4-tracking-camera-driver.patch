From: overpressure <overpressure@pico4>
Subject: [PATCH] media: build the PICO 4's tracking camera driver

The configuration option and object of the PICO 4's OV7251 driver: the
modules' control port belongs to the controller radio, so the driver has
no I2C client.
---
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index ade94e67f8c7..4128f5241d84 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -685,6 +685,17 @@ config VIDEO_OV7251
 	  To compile this driver as a module, choose M here: the
 	  module will be called ov7251.
 
+config VIDEO_PICO4_OV7251
+	tristate "PICO 4 tracking cameras (OV7251 on the controller radio)"
+	depends on OF && COMMON_CLK && REGULATOR
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	help
+	  The PICO 4's four OV7251 tracking cameras, whose control port belongs
+	  to the controller radio: a sensor subdevice for CAMSS that powers and
+	  clocks them while they stream.
+
 config VIDEO_OV7640
 	tristate "OmniVision OV7640 sensor support"
 	help
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index cc9c9064e042..b7ceda512a00 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -116,6 +116,7 @@ obj-$(CONFIG_VIDEO_OV64A40) += ov64a40.o
 obj-$(CONFIG_VIDEO_OV6650) += ov6650.o
 obj-$(CONFIG_VIDEO_OV6710) += ov6710.o
 obj-$(CONFIG_VIDEO_OV7251) += ov7251.o
+obj-$(CONFIG_VIDEO_PICO4_OV7251) += pico4-ov7251.o
 obj-$(CONFIG_VIDEO_OV7640) += ov7640.o
 obj-$(CONFIG_VIDEO_OV7670) += ov7670.o
 obj-$(CONFIG_VIDEO_OV772X) += ov772x.o
