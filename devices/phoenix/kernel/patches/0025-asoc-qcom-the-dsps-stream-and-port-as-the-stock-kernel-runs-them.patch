From: overpressure <overpressure@pico4>
Subject: [PATCH] ASoC: qcom: the DSP's stream and port as the stock kernel runs them

What the stock kernel's q6 modules send, on the same headset with the same calibration: a stream's
post-processing topology is the DSP's default, where mainline asks for none; a port starts with its
calibrated topology (AFE_PARAM_ID_SET_TOPOLOGY), which mainline never sends; the device path runs at
16 bits; and periods have no step of 480 frames, so that PipeWire gets its 1024.
---
--- a/sound/soc/qcom/sm8250.c
+++ b/sound/soc/qcom/sm8250.c
@@ -66,6 +66,8 @@

 	rate->min = rate->max = 48000;
 	channels->min = channels->max = 2;
+	/* The device path's processing runs at this width. The mask holds the front end's format too. */
+	snd_mask_none(fmt);
 	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);

 	return 0;
--- a/sound/soc/qcom/qdsp6/q6asm.c
+++ b/sound/soc/qcom/qdsp6/q6asm.c
@@ -32,6 +32,7 @@
 #define ASM_STREAM_CMD_FLUSH_READBUFS		0x00010C09
 #define ASM_STREAM_CMD_SET_ENCDEC_PARAM		0x00010C10
 #define ASM_STREAM_POSTPROC_TOPO_ID_NONE	0x00010C68
+#define ASM_STREAM_POSTPROC_TOPO_ID_DEFAULT	0x00010BE4
 #define ASM_CMD_SHARED_MEM_MAP_REGIONS		0x00010D92
 #define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS	0x00010D93
 #define ASM_CMD_SHARED_MEM_UNMAP_REGIONS	0x00010D94
@@ -946,7 +947,7 @@
 	/* source endpoint : matrix */
 	open->sink_endpointype = ASM_END_POINT_DEVICE_MATRIX;
 	open->bits_per_sample = bits_per_sample;
-	open->postprocopo_id = ASM_NULL_POPP_TOPOLOGY;
+	open->postprocopo_id = ASM_STREAM_POSTPROC_TOPO_ID_DEFAULT;
 
 	switch (format) {
 	case SND_AUDIOCODEC_MP3:
--- a/sound/soc/qcom/qdsp6/q6asm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6asm-dai.c
@@ -423,19 +423,6 @@
 		}
 	}
 
-	ret = snd_pcm_hw_constraint_step(runtime, 0,
-		SNDRV_PCM_HW_PARAM_PERIOD_SIZE, 480);
-	if (ret < 0) {
-		dev_err(dev, "constraint for period bytes step ret = %d\n",
-								ret);
-	}
