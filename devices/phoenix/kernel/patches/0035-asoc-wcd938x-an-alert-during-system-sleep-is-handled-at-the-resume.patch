From: overpressure <overpressure@pico4>
Subject: [PATCH] ASoC: wcd938x: an alert during system sleep is handled at the resume

A cable replug during a suspend raises a codec alert while the codec's runtime PM is disabled. The
interrupt thread couldn't resume the codec, so nothing read or acknowledged the interrupt again.
---
--- a/sound/soc/codecs/wcd938x.h
+++ b/sound/soc/codecs/wcd938x.h
@@ -644,6 +644,7 @@
 	struct wcd938x_priv *wcd938x;
 	struct irq_domain *slave_irq;
 	struct regmap *regmap;
+	bool alert_pending;
 };
 
 #if IS_ENABLED(CONFIG_SND_SOC_WCD938X_SDW)
--- a/sound/soc/codecs/wcd938x-sdw.c
+++ b/sound/soc/codecs/wcd938x-sdw.c
@@ -144,6 +144,15 @@
 				      struct sdw_slave_intr_status *status)
 {
 	struct wcd938x_sdw_priv *wcd = dev_get_drvdata(&slave->dev);
+
+	/*
+	 * Between a system sleep's late suspend and early resume the codec can't be resumed, and its
+	 * interrupts can't be read or acknowledged: the resume handles them.
+	 */
+	if (!pm_runtime_enabled(&slave->dev)) {
+		wcd->alert_pending = true;
+		return 0;
+	}
 
 	return wcd_interrupt_callback(slave, wcd->slave_irq, WCD938X_DIGITAL_INTR_STATUS_0,
 				WCD938X_DIGITAL_INTR_STATUS_1, WCD938X_DIGITAL_INTR_STATUS_2);
@@ -1256,7 +1265,30 @@
 	return 0;
 }
 
+static int wcd938x_sdw_resume(struct device *dev)
+{
+	struct wcd938x_sdw_priv *wcd = dev_get_drvdata(dev);
+	unsigned int sts[3] = { };
+
+	if (!wcd->alert_pending)
+		return 0;
+	wcd->alert_pending = false;
+
+	if (pm_runtime_resume_and_get(dev) < 0)
+		return 0;
+	regmap_read(wcd->regmap, WCD938X_DIGITAL_INTR_STATUS_0, &sts[0]);
+	regmap_read(wcd->regmap, WCD938X_DIGITAL_INTR_STATUS_1, &sts[1]);
+	regmap_read(wcd->regmap, WCD938X_DIGITAL_INTR_STATUS_2, &sts[2]);
+	dev_info(dev, "alert during sleep: status %#04x %#04x %#04x\n", sts[0], sts[1], sts[2]);
+	wcd_interrupt_callback(wcd->sdev, wcd->slave_irq, WCD938X_DIGITAL_INTR_STATUS_0,
+			       WCD938X_DIGITAL_INTR_STATUS_1, WCD938X_DIGITAL_INTR_STATUS_2);
+	pm_runtime_mark_last_busy(dev);
+	pm_runtime_put_autosuspend(dev);
+	return 0;
+}
+
 static const struct dev_pm_ops wcd938x_sdw_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(NULL, wcd938x_sdw_resume)
 	RUNTIME_PM_OPS(wcd938x_sdw_runtime_suspend, wcd938x_sdw_runtime_resume, NULL)
 };
 
