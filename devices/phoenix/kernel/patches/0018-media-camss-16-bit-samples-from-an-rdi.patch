From: overpressure <overpressure@pico4>
Subject: [PATCH] media: camss: 16-bit samples from an RDI

A line of packed RAW10 is not always a whole number of the bus's 16-byte bursts:
the RGB camera's 2328 pixels make 2910 bytes, and the write master stops with an
image size violation. PICO's stack has the CSID unpack such a stream into 16-bit
samples, 4656 bytes a line. A client asks for that on the CSID's source pad, with
the RDI's decode format taken from the Bayer format it comes in as.
---
diff --git a/drivers/media/platform/qcom/camss/camss-csid.c b/drivers/media/platform/qcom/camss/camss-csid.c
--- a/drivers/media/platform/qcom/camss/camss-csid.c
+++ b/drivers/media/platform/qcom/camss/camss-csid.c
@@ -650,6 +650,16 @@
 	}
 
 	switch (sink_code) {
+	case MEDIA_BUS_FMT_SRGGB10_1X10:
+	{
+		u32 src_code[] = {
+			MEDIA_BUS_FMT_SRGGB10_1X10,
+			MEDIA_BUS_FMT_SRGGB16_1X16,
+		};
+
+		return csid_find_code(src_code, ARRAY_SIZE(src_code),
+				      match_format_idx, match_code);
+	}
 	case MEDIA_BUS_FMT_SBGGR10_1X10:
 	{
 		u32 src_code[] = {
diff --git a/drivers/media/platform/qcom/camss/camss-csid-gen2.c b/drivers/media/platform/qcom/camss/camss-csid-gen2.c
--- a/drivers/media/platform/qcom/camss/camss-csid-gen2.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-gen2.c
@@ -84,6 +84,7 @@
 #define			PLAIN_ALIGNMENT_LSB	0
 #define			PLAIN_ALIGNMENT_MSB	1
 #define		RDI_CFG0_PLAIN_FORMAT		10
+#define			PLAIN_FORMAT_PLAIN16	1
 #define		RDI_CFG0_DECODE_FORMAT		12
 #define		RDI_CFG0_DATA_TYPE		16
 #define		RDI_CFG0_VIRTUAL_CHANNEL	22
@@ -262,8 +263,11 @@
 {
 	/* Source pads matching RDI channels on hardware. Pad 1 -> RDI0, Pad 2 -> RDI1, etc. */
 	struct v4l2_mbus_framefmt *input_format = &csid->fmt[MSM_CSID_PAD_FIRST_SRC + port];
+	/* 16-bit samples: the RDI unpacks what comes in as 10-bit Bayer. */
+	const bool plain16 = input_format->code == MEDIA_BUS_FMT_SRGGB16_1X16;
 	const struct csid_format_info *format = csid_get_fmt_entry(csid->res->formats->formats,
 								   csid->res->formats->nformats,
+								   plain16 ? MEDIA_BUS_FMT_SRGGB10_1X10 :
 								   input_format->code);
 	u32 val;
 
@@ -284,8 +288,13 @@
 	val = 1 << RDI_CFG0_BYTE_CNTR_EN;
 	val |= 1 << RDI_CFG0_FORMAT_MEASURE_EN;
 	val |= 1 << RDI_CFG0_TIMESTAMP_EN;
-	/* note: for non-RDI path, this should be format->decode_format */
-	val |= DECODE_FORMAT_PAYLOAD_ONLY << RDI_CFG0_DECODE_FORMAT;
+	if (plain16) {
+		val |= format->decode_format << RDI_CFG0_DECODE_FORMAT;
+		val |= PLAIN_FORMAT_PLAIN16 << RDI_CFG0_PLAIN_FORMAT;
+	} else {
+		/* note: for non-RDI path, this should be format->decode_format */
+		val |= DECODE_FORMAT_PAYLOAD_ONLY << RDI_CFG0_DECODE_FORMAT;
+	}
 	val |= format->data_type << RDI_CFG0_DATA_TYPE;
 	val |= vc << RDI_CFG0_VIRTUAL_CHANNEL;
 	val |= dt_id << RDI_CFG0_DT_ID;
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -153,6 +153,8 @@
 	  PER_PLANE_DATA(0, 1, 1, 1, 1, 10) },
 	{ MEDIA_BUS_FMT_SBGGR10_2X8_PADHI_LE, 16, V4L2_PIX_FMT_SBGGR10, 1,
 	  PER_PLANE_DATA(0, 1, 1, 1, 1, 16) },
+	{ MEDIA_BUS_FMT_SRGGB16_1X16, 16, V4L2_PIX_FMT_SRGGB10, 1,
+	  PER_PLANE_DATA(0, 1, 1, 1, 1, 16) },
 	{ MEDIA_BUS_FMT_SBGGR12_1X12, 12, V4L2_PIX_FMT_SBGGR12P, 1,
 	  PER_PLANE_DATA(0, 1, 1, 1, 1, 12) },
 	{ MEDIA_BUS_FMT_SGBRG12_1X12, 12, V4L2_PIX_FMT_SGBRG12P, 1,
