From: overpressure <overpressure@pico4>
Subject: [PATCH] Bluetooth: hci_qca: wait for the WCN7850's firmware on the WCN7850 only

"bluetooth: make sure firmware is avail before probe" defers every hci_qca probe until
qca/hmtbtfw20.tlv, the Frame's WCN7850 firmware, can be loaded. The PICO 4's QCA6390 loads
htbtfw20.tlv when the device is opened and has no hmtbtfw20.tlv, so its probe deferred
forever and Bluetooth never registered. Keep the wait for the WCN7850.
---
diff --git a/drivers/bluetooth/hci_qca.c b/drivers/bluetooth/hci_qca.c
index cd7211ac25d1..e08f0df86eb5 100644
--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -2399,12 +2399,6 @@ static int qca_serdev_probe(struct serdev_device *serdev)
 	bool power_ctrl_enabled = true;
 	const struct firmware *fw;
 
-	/* HACK: make sure firmware is available before trying to probe */
-	err = firmware_request_nowarn(&fw, "qca/hmtbtfw20.tlv", &serdev->dev);
-	if (err)
-		return -EPROBE_DEFER;
-	release_firmware(fw);
-
 	qcadev = devm_kzalloc(&serdev->dev, sizeof(*qcadev), GFP_KERNEL);
 	if (!qcadev)
 		return -ENOMEM;
@@ -2427,6 +2421,17 @@ static int qca_serdev_probe(struct serdev_device *serdev)
 	else
 		qcadev->btsoc_type = QCA_ROME;
 
+	/*
+	 * HACK: make sure firmware is available before trying to probe. The name is the
+	 * WCN7850's; other controllers load their own when the device is opened.
+	 */
+	if (qcadev->btsoc_type == QCA_WCN7850) {
+		err = firmware_request_nowarn(&fw, "qca/hmtbtfw20.tlv", &serdev->dev);
+		if (err)
+			return -EPROBE_DEFER;
+		release_firmware(fw);
+	}
+
 	switch (qcadev->btsoc_type) {
 	case QCA_QCA6390:
 	case QCA_WCN3950:
