From: overpressure <overpressure@pico4>
Subject: [PATCH] ASoC: qcom: q6: PICO OS's audio calibration

PICO's audio HAL registers its custom topologies with the ADSP core,
opens each path's COPP with the path's topology from its calibration
database and sends the path's processing and volume parameters after
the open; mainline opened every COPP with the null topology and sent
no parameters, so the speakers ran without PICO's processing.

q6core gains the core service's memory map and unmap and the custom
topology registration (all registered topologies dropped first, as the
vendor driver does), q6adm an in-band set-parameter command (v6, the
entries with instance ids), and q6routing asks the PICO 4's calibration
driver (q6calibration-pico4.c, built from the device's own sources) for
a path's topology and hands its parameters on after the open. A path
without calibration, or one whose topology the ADSP refuses, keeps the
null topology.
---
diff --git a/sound/soc/qcom/qdsp6/Makefile b/sound/soc/qcom/qdsp6/Makefile
index 67267304e7e9..c7e2795f6c84 100644
--- a/sound/soc/qcom/qdsp6/Makefile
+++ b/sound/soc/qcom/qdsp6/Makefile
@@ -8,7 +8,7 @@ obj-$(CONFIG_SND_SOC_QDSP6_AFE) += q6afe.o
 obj-$(CONFIG_SND_SOC_QDSP6_AFE_DAI) += q6afe-dai.o
 obj-$(CONFIG_SND_SOC_QDSP6_AFE_CLOCKS) += q6afe-clocks.o
 obj-$(CONFIG_SND_SOC_QDSP6_ADM) += q6adm.o
-obj-$(CONFIG_SND_SOC_QDSP6_ROUTING) += q6routing.o
+obj-$(CONFIG_SND_SOC_QDSP6_ROUTING) += q6routing.o q6calibration-pico4.o
 obj-$(CONFIG_SND_SOC_QDSP6_ASM) += q6asm.o
 obj-$(CONFIG_SND_SOC_QDSP6_ASM_DAI) += q6asm-dai.o
 
diff --git a/sound/soc/qcom/qdsp6/q6adm.c b/sound/soc/qcom/qdsp6/q6adm.c
index db0ae71f2983..f6dd67c4da56 100644
--- a/sound/soc/qcom/qdsp6/q6adm.c
+++ b/sound/soc/qcom/qdsp6/q6adm.c
@@ -25,6 +25,7 @@
 #define ADM_CMDRSP_DEVICE_OPEN_V5	0x00010329
 #define ADM_CMD_DEVICE_CLOSE_V5		0x00010327
 #define ADM_CMD_MATRIX_MAP_ROUTINGS_V5	0x00010325
+#define ADM_CMD_SET_PP_PARAMS_V6	0x0001035d
 
 #define TIMEOUT_MS 1000
 #define RESET_COPP_ID 99
@@ -77,6 +78,13 @@ struct q6adm_cmd_device_open_v5 {
 	u8 dev_channel_mapping[8];
 } __packed;
 
+struct q6adm_cmd_set_pp_params {
+	u32 payload_addr_lsw;
+	u32 payload_addr_msw;
+	u32 mem_map_handle;
+	u32 payload_size;
+} __packed;
+
 struct q6adm_cmd_matrix_map_routings_v5 {
 	u32 matrix_id;
 	u32 num_sessions;
@@ -219,6 +227,7 @@ static int q6adm_callback(struct apr_device *adev, const struct apr_resp_pkt *da
 		switch (result->opcode) {
 		case ADM_CMD_DEVICE_OPEN_V5:
 		case ADM_CMD_DEVICE_CLOSE_V5:
+		case ADM_CMD_SET_PP_PARAMS_V6:
 			list_for_each_entry(copp, &adm->copps_list, node) {
 				if ((port_idx == copp->afe_port) && (copp_idx == copp->copp_idx)) {
 					copp->result = *result;
@@ -444,6 +453,51 @@ int q6adm_get_copp_id(struct q6copp *copp)
 }
 EXPORT_SYMBOL_GPL(q6adm_get_copp_id);
 
+/**
+ * q6adm_set_pp_params() - set a COPP's processing parameters
+ *
+ * @dev: Pointer to adm child device.
+ * @copp: the COPP
+ * @data: the parameters, ADM set-parameter v3 entries (with instance ids)
+ * @size: their size
+ *
+ * The parameters go in band, after the command, as the vendor driver's set-parameter command
+ * carries them when it has no mapped buffer.
+ *
+ * Return: Will be an negative on error or a zero on success.
+ */
+int q6adm_set_pp_params(struct device *dev, struct q6copp *copp, const void *data, u32 size)
+{
+	struct q6adm *adm = dev_get_drvdata(dev->parent);
+	struct q6adm_cmd_set_pp_params *cmd;
+	int pkt_size = APR_HDR_SIZE + sizeof(*cmd) + size;
+	struct apr_pkt *pkt;
+	int ret;
+
+	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	cmd = p + APR_HDR_SIZE;
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.src_port = q6afe_get_port_id(copp->afe_port);
+	pkt->hdr.dest_port = copp->id;
+	pkt->hdr.token = copp->afe_port << 16 | copp->copp_idx;
+	pkt->hdr.opcode = ADM_CMD_SET_PP_PARAMS_V6;
+	cmd->payload_size = size;
+	memcpy(p + APR_HDR_SIZE + sizeof(*cmd), data, size);
+
+	/* The helper returns the time left of its wait on success. */
+	ret = q6adm_apr_send_copp_pkt(adm, copp, pkt, 0);
+
+	return ret < 0 ? ret : 0;
+}
+EXPORT_SYMBOL_GPL(q6adm_set_pp_params);
+
 /**
  * q6adm_matrix_map() - Map asm streams and afe ports using payload
  *
diff --git a/sound/soc/qcom/qdsp6/q6adm.h b/sound/soc/qcom/qdsp6/q6adm.h
index 4f56999b7fab..a55038618e1b 100644
--- a/sound/soc/qcom/qdsp6/q6adm.h
+++ b/sound/soc/qcom/qdsp6/q6adm.h
@@ -21,6 +21,7 @@ struct q6copp *q6adm_open(struct device *dev, int port_id, int path, int rate,
 			   uint16_t bit_width, int app_type, int acdb_id);
 int q6adm_close(struct device *dev, struct q6copp *copp);
 int q6adm_get_copp_id(struct q6copp *copp);
+int q6adm_set_pp_params(struct device *dev, struct q6copp *copp, const void *data, u32 size);
 int q6adm_matrix_map(struct device *dev, int path,
 		     struct route_payload payload_map, int perf_mode);
 
diff --git a/sound/soc/qcom/qdsp6/q6core.c b/sound/soc/qcom/qdsp6/q6core.c
index 48825756a7ab..19af9b40e3cb 100644
--- a/sound/soc/qcom/qdsp6/q6core.c
+++ b/sound/soc/qcom/qdsp6/q6core.c
@@ -22,6 +22,38 @@
 #define AVCS_GET_VERSIONS_RSP   0x00012906
 #define AVCS_CMD_GET_FWK_VERSION	0x001292c
 #define AVCS_CMDRSP_GET_FWK_VERSION	0x001292d
+#define AVCS_CMD_SHARED_MEM_MAP_REGIONS		0x00012924
+#define AVCS_CMDRSP_SHARED_MEM_MAP_REGIONS	0x00012925
+#define AVCS_CMD_SHARED_MEM_UNMAP_REGIONS	0x00012926
+#define AVCS_CMD_REGISTER_TOPOLOGIES		0x00012923
+#define AVCS_CMD_DEREGISTER_TOPOLOGIES		0x0001292a
+#define AVCS_MODE_DEREGISTER_ALL_CUSTOM_TOPOLOGIES	2
+#define ADSP_MEMORY_MAP_SHMEM8_4K_POOL		3
+#define Q6_CMD_TIMEOUT_MS	1000
+
+struct avcs_cmd_shared_mem_map_regions {
+	u16 mem_pool_id;
+	u16 num_regions;
+	u32 property_flag;
+	u32 shm_addr_lsw;
+	u32 shm_addr_msw;
+	u32 mem_size_bytes;
+} __packed;
+
+struct avcs_cmd_register_topologies {
+	u32 payload_addr_lsw;
+	u32 payload_addr_msw;
+	u32 mem_map_handle;
+	u32 payload_size;
+} __packed;
+
+struct avcs_cmd_deregister_topologies {
+	u32 payload_addr_lsw;
+	u32 payload_addr_msw;
+	u32 mem_map_handle;
+	u32 payload_size;
+	u32 mode;
+} __packed;
 
 struct avcs_svc_info {
 	uint32_t service_id;
@@ -63,6 +95,10 @@ struct q6core {
 	bool get_state_supported;
 	bool get_version_supported;
 	bool is_version_requested;
+	/* The memory and topology commands: done, the DSP's status, a new map handle. */
+	bool cmd_done;
+	u32 cmd_status;
+	u32 mem_map_handle;
 };
 
 static struct q6core *g_core;
@@ -93,9 +129,23 @@ static int q6core_callback(struct apr_device *adev, const struct apr_resp_pkt *d
 				core->get_state_supported = false;
 			core->resp_received = true;
 			break;
+		case AVCS_CMD_SHARED_MEM_MAP_REGIONS:
+		case AVCS_CMD_SHARED_MEM_UNMAP_REGIONS:
+		case AVCS_CMD_REGISTER_TOPOLOGIES:
+		case AVCS_CMD_DEREGISTER_TOPOLOGIES:
+			core->cmd_status = result->status;
+			core->cmd_done = true;
+			wake_up(&core->wait);
+			break;
 		}
 		break;
 	}
+	case AVCS_CMDRSP_SHARED_MEM_MAP_REGIONS:
+		core->mem_map_handle = *(u32 *)data->payload;
+		core->cmd_status = 0;
+		core->cmd_done = true;
+		wake_up(&core->wait);
+		break;
 	case AVCS_CMDRSP_GET_FWK_VERSION: {
 		struct avcs_cmdrsp_get_fwk_version *fwk;
 
@@ -325,6 +375,130 @@ bool q6core_is_adsp_ready(void)
 }
 EXPORT_SYMBOL_GPL(q6core_is_adsp_ready);
 
+static int q6core_send_cmd(struct apr_pkt *pkt)
+{
+	struct q6core *core = g_core;
+	int rc;
+
+	if (!core)
+		return -ENODEV;
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD, APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	mutex_lock(&core->lock);
+	core->cmd_done = false;
+	core->cmd_status = 0;
+	rc = apr_send_pkt(core->adev, pkt);
+	if (rc >= 0) {
+		rc = wait_event_timeout(core->wait, core->cmd_done, msecs_to_jiffies(Q6_CMD_TIMEOUT_MS));
+		if (!rc)
+			rc = -ETIMEDOUT;
+		else
+			rc = core->cmd_status ? -EIO : 0;
+	}
+	mutex_unlock(&core->lock);
+
+	return rc;
+}
+
+/**
+ * q6core_map_memory() - map a buffer for the ADSP core service
+ * @addr: the buffer's address as the ADSP sees it
+ * @size: its size, a multiple of 4 KiB
+ * @handle: the map handle for later commands
+ *
+ * Return: zero on success, a negative errno otherwise.
+ */
+int q6core_map_memory(u64 addr, u32 size, u32 *handle)
+{
+	struct avcs_cmd_shared_mem_map_regions *cmd;
+	struct apr_pkt *pkt;
+	int rc;
+
+	void *p __free(kfree) = kzalloc(APR_HDR_SIZE + sizeof(*cmd), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	pkt = p;
+	cmd = p + APR_HDR_SIZE;
+	pkt->hdr.pkt_size = APR_HDR_SIZE + sizeof(*cmd);
+	pkt->hdr.opcode = AVCS_CMD_SHARED_MEM_MAP_REGIONS;
+	cmd->mem_pool_id = ADSP_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd->num_regions = 1;
+	cmd->shm_addr_lsw = lower_32_bits(addr);
+	cmd->shm_addr_msw = upper_32_bits(addr);
+	cmd->mem_size_bytes = size;
+
+	rc = q6core_send_cmd(pkt);
+	if (!rc)
+		*handle = g_core->mem_map_handle;
+
+	return rc;
+}
+EXPORT_SYMBOL_GPL(q6core_map_memory);
+
+/**
+ * q6core_unmap_memory() - unmap a buffer q6core_map_memory() mapped
+ * @handle: its map handle
+ *
+ * Return: zero on success, a negative errno otherwise.
+ */
+int q6core_unmap_memory(u32 handle)
+{
+	struct apr_pkt *pkt;
+
+	void *p __free(kfree) = kzalloc(APR_HDR_SIZE + sizeof(u32), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	pkt = p;
+	pkt->hdr.pkt_size = APR_HDR_SIZE + sizeof(u32);
+	pkt->hdr.opcode = AVCS_CMD_SHARED_MEM_UNMAP_REGIONS;
+	*(u32 *)(p + APR_HDR_SIZE) = handle;
+
+	return q6core_send_cmd(pkt);
+}
+EXPORT_SYMBOL_GPL(q6core_unmap_memory);
+
+/**
+ * q6core_register_topologies() - hand the ADSP a set of custom topologies
+ * @addr: the mapped buffer that holds them, as the ADSP sees it
+ * @handle: its map handle
+ * @size: their size
+ *
+ * As the vendor driver does, every custom topology registered before is dropped first.
+ *
+ * Return: zero on success, a negative errno otherwise.
+ */
+int q6core_register_topologies(u64 addr, u32 handle, u32 size)
+{
+	struct avcs_cmd_deregister_topologies *dereg;
+	struct avcs_cmd_register_topologies *reg;
+	struct apr_pkt *pkt;
+	int rc;
+
+	void *p __free(kfree) = kzalloc(APR_HDR_SIZE + sizeof(*dereg), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	pkt = p;
+	dereg = p + APR_HDR_SIZE;
+	pkt->hdr.pkt_size = APR_HDR_SIZE + sizeof(*dereg);
+	pkt->hdr.opcode = AVCS_CMD_DEREGISTER_TOPOLOGIES;
+	dereg->mode = AVCS_MODE_DEREGISTER_ALL_CUSTOM_TOPOLOGIES;
+	rc = q6core_send_cmd(pkt);
+	if (rc)
+		return rc;
+
+	memset(p, 0, APR_HDR_SIZE + sizeof(*dereg));
+	reg = p + APR_HDR_SIZE;
+	pkt->hdr.pkt_size = APR_HDR_SIZE + sizeof(*reg);
+	pkt->hdr.opcode = AVCS_CMD_REGISTER_TOPOLOGIES;
+	reg->payload_addr_lsw = lower_32_bits(addr);
+	reg->payload_addr_msw = upper_32_bits(addr);
+	reg->mem_map_handle = handle;
+	reg->payload_size = size;
+
+	return q6core_send_cmd(pkt);
+}
+EXPORT_SYMBOL_GPL(q6core_register_topologies);
+
 static int q6core_probe(struct apr_device *adev)
 {
 	g_core = kzalloc_obj(*g_core);
diff --git a/sound/soc/qcom/qdsp6/q6core.h b/sound/soc/qcom/qdsp6/q6core.h
index 4105b1d730be..d27cd0c0d2b0 100644
--- a/sound/soc/qcom/qdsp6/q6core.h
+++ b/sound/soc/qcom/qdsp6/q6core.h
@@ -10,6 +10,9 @@ struct q6core_svc_api_info {
 };
 
 bool q6core_is_adsp_ready(void);
+int q6core_map_memory(u64 addr, u32 size, u32 *handle);
+int q6core_unmap_memory(u32 handle);
+int q6core_register_topologies(u64 addr, u32 handle, u32 size);
 int q6core_get_svc_api_info(int svc_id, struct q6core_svc_api_info *ainfo);
 
 #endif /* __Q6CORE_H__ */
diff --git a/sound/soc/qcom/qdsp6/q6routing.c b/sound/soc/qcom/qdsp6/q6routing.c
index 7386226046fa..aa41347da2d2 100644
--- a/sound/soc/qcom/qdsp6/q6routing.c
+++ b/sound/soc/qcom/qdsp6/q6routing.c
@@ -22,6 +22,7 @@
 #include "q6afe.h"
 #include "q6asm.h"
 #include "q6adm.h"
+#include "q6calibration-pico4.h"
 #include "q6routing.h"
 
 #define DRV_NAME "q6routing-component"
@@ -361,7 +362,7 @@ static struct msm_routing_data *routing_data;
 int q6routing_stream_open(int fedai_id, int perf_mode,
 			   int stream_id, int stream_type)
 {
-	int j, topology, num_copps = 0;
+	int j, topology, afe_port, num_copps = 0;
 	struct route_payload payload;
 	struct q6copp *copp;
 	int copp_idx;
@@ -390,16 +391,30 @@ int q6routing_stream_open(int fedai_id, int perf_mode,
 	session->bits_per_sample = pdata->bits_per_sample;
 
 	payload.num_copps = 0; /* only RX needs to use payload */
-	topology = NULL_COPP_TOPOLOGY;
+	/* PICO OS's topology for the path where its calibration has one. */
+	afe_port = q6afe_get_port_id(session->port_id);
+	topology = q6calibration_topology(afe_port, session->path_type);
+	if (topology < 0)
+		topology = NULL_COPP_TOPOLOGY;
 	copp = q6adm_open(routing_data->dev, session->port_id,
 			      session->path_type, session->sample_rate,
 			      session->channels, topology, perf_mode,
 			      session->bits_per_sample, 0, 0);
+	if (IS_ERR_OR_NULL(copp) && topology != NULL_COPP_TOPOLOGY) {
+		dev_err(routing_data->dev, "port 0x%x refused topology 0x%x\n", afe_port, topology);
+		topology = NULL_COPP_TOPOLOGY;
+		copp = q6adm_open(routing_data->dev, session->port_id,
+				  session->path_type, session->sample_rate,
+				  session->channels, topology, perf_mode,
+				  session->bits_per_sample, 0, 0);
+	}
 
 	if (IS_ERR_OR_NULL(copp)) {
 		mutex_unlock(&routing_data->lock);
 		return -EINVAL;
 	}
+	if (topology != NULL_COPP_TOPOLOGY)
+		q6calibration_apply(routing_data->dev, copp, afe_port, session->path_type);
 
 	copp_idx = q6adm_get_copp_id(copp);
 	set_bit(copp_idx, &session->copp_map);
