From: overpressure <overpressure@pico4>
Subject: [PATCH] drm/msm/a6xx: ringbuffer preemption on the A650

msm preempts only on 7xx, and a 4 ms job of a low-priority client holds back the
compositor on this GPU. PICO's KGSL preempts between four ringbuffers on the same
GPU and firmware. As it does, the A650's submit path tells the CP where to save
each ring, yields the floor after each submit, checks for a higher ring and takes
the interrupt that ends a preemption; it leaves out 7xx's postamble, which its
firmware has no packet for.

The CP also needs KGSL's register list at its init, with KGSL's mask and ordinals:
without it a ring switch loses the blocks' 64-bit addressing and the next client
faults on addresses missing their upper half.

The compositor's jobs now start within about a millisecond with another client on
the GPU, and a pixel-exact check of preempted jobs passes in GMEM and sysmem modes.
msm.enable_preemption=0 turns it off.
---
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
--- a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
@@ -585,6 +585,85 @@
 DECLARE_ADRENO_PROTECT(a650_protect, 48);
 
 /* These are for a635 and a660 */
+static const u32 a650_ifpc_reglist_regs[] = {
+	REG_A6XX_CP_CHICKEN_DBG,
+	REG_A6XX_CP_DBG_ECO_CNTL,
+	REG_A6XX_CP_PROTECT_CNTL,
+	REG_A6XX_CP_PROTECT(0),
+	REG_A6XX_CP_PROTECT(1),
+	REG_A6XX_CP_PROTECT(2),
+	REG_A6XX_CP_PROTECT(3),
+	REG_A6XX_CP_PROTECT(4),
+	REG_A6XX_CP_PROTECT(5),
+	REG_A6XX_CP_PROTECT(6),
+	REG_A6XX_CP_PROTECT(7),
+	REG_A6XX_CP_PROTECT(8),
+	REG_A6XX_CP_PROTECT(9),
+	REG_A6XX_CP_PROTECT(10),
+	REG_A6XX_CP_PROTECT(11),
+	REG_A6XX_CP_PROTECT(12),
+	REG_A6XX_CP_PROTECT(13),
+	REG_A6XX_CP_PROTECT(14),
+	REG_A6XX_CP_PROTECT(15),
+	REG_A6XX_CP_PROTECT(16),
+	REG_A6XX_CP_PROTECT(17),
+	REG_A6XX_CP_PROTECT(18),
+	REG_A6XX_CP_PROTECT(19),
+	REG_A6XX_CP_PROTECT(20),
+	REG_A6XX_CP_PROTECT(21),
+	REG_A6XX_CP_PROTECT(22),
+	REG_A6XX_CP_PROTECT(23),
+	REG_A6XX_CP_PROTECT(24),
+	REG_A6XX_CP_PROTECT(25),
+	REG_A6XX_CP_PROTECT(26),
+	REG_A6XX_CP_PROTECT(27),
+	REG_A6XX_CP_PROTECT(28),
+	REG_A6XX_CP_PROTECT(29),
+	REG_A6XX_CP_PROTECT(30),
+	REG_A6XX_CP_PROTECT(31),
+	REG_A6XX_CP_AHB_CNTL,
+};
+DECLARE_ADRENO_REGLIST_LIST(a650_ifpc_reglist);
+
+static const u32 a650_pwrup_reglist_regs[] = {
+	REG_A6XX_VSC_ADDR_MODE_CNTL,
+	REG_A6XX_GRAS_ADDR_MODE_CNTL,
+	REG_A6XX_RB_ADDR_MODE_CNTL,
+	REG_A6XX_PC_ADDR_MODE_CNTL,
+	REG_A6XX_HLSQ_ADDR_MODE_CNTL,
+	REG_A6XX_VFD_ADDR_MODE_CNTL,
+	REG_A6XX_VPC_ADDR_MODE_CNTL,
+	REG_A6XX_UCHE_ADDR_MODE_CNTL,
+	REG_A6XX_SP_ADDR_MODE_CNTL,
+	REG_A6XX_TPL1_ADDR_MODE_CNTL,
+	REG_A6XX_UCHE_WRITE_RANGE_MAX,
+	REG_A6XX_UCHE_WRITE_RANGE_MAX + 1,
+	REG_A6XX_UCHE_TRAP_BASE,
+	REG_A6XX_UCHE_TRAP_BASE + 1,
+	REG_A6XX_UCHE_WRITE_THRU_BASE,
+	REG_A6XX_UCHE_WRITE_THRU_BASE + 1,
+	REG_A6XX_UCHE_GMEM_RANGE_MIN,
+	REG_A6XX_UCHE_GMEM_RANGE_MIN + 1,
+	REG_A6XX_UCHE_GMEM_RANGE_MAX,
+	REG_A6XX_UCHE_GMEM_RANGE_MAX + 1,
+	REG_A6XX_UCHE_FILTER_CNTL,
+	REG_A6XX_UCHE_CACHE_WAYS,
+	REG_A6XX_UCHE_MODE_CNTL,
+	REG_A6XX_RB_NC_MODE_CNTL,
+	REG_A6XX_TPL1_NC_MODE_CNTL,
+	REG_A6XX_SP_NC_MODE_CNTL,
+	REG_A6XX_PC_DBG_ECO_CNTL,
+	REG_A6XX_RB_CONTEXT_SWITCH_GMEM_SAVE_RESTORE_ENABLE,
+	REG_A6XX_RBBM_GBIF_CLIENT_QOS_CNTL,
+	REG_A6XX_CP_PROTECT(47),
+	REG_A6XX_TPL1_BICUBIC_WEIGHTS_TABLE(0),
+	REG_A6XX_TPL1_BICUBIC_WEIGHTS_TABLE(1),
+	REG_A6XX_TPL1_BICUBIC_WEIGHTS_TABLE(2),
+	REG_A6XX_TPL1_BICUBIC_WEIGHTS_TABLE(3),
+	REG_A6XX_TPL1_BICUBIC_WEIGHTS_TABLE(4),
+};
+DECLARE_ADRENO_REGLIST_LIST(a650_pwrup_reglist);
+
 static const u32 a660_protect_regs[] = {
 	A6XX_PROTECT_RDONLY(0x00000, 0x04ff),
 	A6XX_PROTECT_RDONLY(0x00501, 0x0005),
@@ -1001,12 +1080,15 @@
 		.gmem = SZ_1M + SZ_128K,
 		.inactive_period = DRM_MSM_INACTIVE_PERIOD,
 		.quirks = ADRENO_QUIRK_HAS_CACHED_COHERENT |
-			ADRENO_QUIRK_HAS_HW_APRIV,
+			ADRENO_QUIRK_HAS_HW_APRIV |
+			ADRENO_QUIRK_PREEMPTION,
 		.funcs = &a6xx_gpu_funcs,
 		.zapfw = "a650_zap.mdt",
 		.a6xx = &(const struct a6xx_info) {
 			.hwcg = a650_hwcg,
 			.protect = &a650_protect,
+			.ifpc_reglist = &a650_ifpc_reglist,
+			.pwrup_reglist = &a650_pwrup_reglist,
 			.gbif_cx = a640_gbif,
 			.gmu_cgc_mode = 0x00020202,
 			.prim_fifo_threshold = 0x00300200,
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
--- a/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gpu.c
@@ -393,6 +393,17 @@
 	adreno_check_and_reenable_stall(adreno_gpu);
 
 	a6xx_set_pagetable(a6xx_gpu, ring, submit);
+
+	/* Where the CP saves this ring when it is preempted, as PICO's KGSL sets it up */
+	if (gpu->nr_rings > 1) {
+		OUT_PKT7(ring, CP_SET_PROTECTED_MODE, 1);
+		OUT_RING(ring, 0);
+
+		a6xx_emit_set_pseudo_reg(ring, a6xx_gpu, submit->queue);
+
+		OUT_PKT7(ring, CP_SET_PROTECTED_MODE, 1);
+		OUT_RING(ring, 1);
+	}
 
 	get_stats_counter(ring, REG_A6XX_RBBM_PERFCTR_CP(0),
 		rbmemptr_stats(ring, index, cpcycles_start));
@@ -463,7 +474,10 @@
 
 	trace_msm_gpu_submit_flush(submit, adreno_gpu->funcs->get_timestamp(gpu), 0);
 
-	a6xx_flush(gpu, ring);
+	a6xx_flush_yield(gpu, ring);
+
+	/* Check to see if we need to start preemption */
+	a6xx_preempt_trigger(gpu);
 }
 
 void a6xx_emit_set_pseudo_reg(struct msm_ringbuffer *ring,
@@ -494,6 +508,9 @@
 	/* seems OK to set to 0 to disable it */
 	OUT_RING(ring, 0);
 	OUT_RING(ring, 0);
+
+	if (a6xx_gpu->base.info->family < ADRENO_7XX_GEN1)
+		return;
 
 	/* Emit postamble to clear perfcounters */
 	preempt_postamble = a6xx_gpu->preempt_postamble_iova;
@@ -999,6 +1016,36 @@
 	a6xx_gpu->dynamic_sel_reglist_offset = dyn_pwrup_reglist_count;
 }
 
+/*
+ * A ring switch loses what hw_init set once, among it the 64-bit addressing of each block, and the
+ * CP restores these registers from this list. It starts with the registers only a power collapse
+ * loses; list_offset says where those a preemption loses begin. Both lengths count dwords.
+ */
+static void a650_patch_pwrup_reglist(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	const struct adreno_reglist_list *ifpc = adreno_gpu->info->a6xx->ifpc_reglist;
+	const struct adreno_reglist_list *pwrup = adreno_gpu->info->a6xx->pwrup_reglist;
+	struct cpu_gpu_lock *lock = a6xx_gpu->pwrup_reglist_ptr;
+	u32 *dest = (u32 *)&lock->regs[0];
+	int i;
+
+	lock->gpu_req = lock->cpu_req = lock->turn = 0;
+	lock->list_offset = ifpc->count * 2;
+	lock->list_length = (ifpc->count + pwrup->count) * 2;
+
+	for (i = 0; i < ifpc->count; i++) {
+		*dest++ = ifpc->regs[i];
+		*dest++ = gpu_read(gpu, ifpc->regs[i]);
+	}
+
+	for (i = 0; i < pwrup->count; i++) {
+		*dest++ = pwrup->regs[i];
+		*dest++ = gpu_read(gpu, pwrup->regs[i]);
+	}
+}
+
 static int a7xx_preempt_start(struct msm_gpu *gpu)
 {
 	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
@@ -1014,14 +1061,60 @@
 
 	a6xx_emit_set_pseudo_reg(ring, a6xx_gpu, NULL);
 
+	if (adreno_gpu->info->family < ADRENO_7XX_GEN1) {
+		OUT_PKT7(ring, CP_SET_PROTECTED_MODE, 1);
+		OUT_RING(ring, 1);
+	}
+
 	a6xx_flush_yield(gpu, ring);
 
 	return a6xx_idle(gpu, ring) ? 0 : -EINVAL;
 }
 
+static int a650_preempt_cp_init(struct msm_gpu *gpu)
+{
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
+	struct msm_ringbuffer *ring = gpu->rb[0];
+
+	OUT_PKT7(ring, CP_ME_INIT, 11);
+
+	/* Also the operation mode and the register list with its spinlock */
+	OUT_RING(ring, 0x0000016f);
+
+	/* Enable multiple hardware contexts */
+	OUT_RING(ring, 0x00000003);
+
+	/* Enable error detection */
+	OUT_RING(ring, 0x20000000);
+
+	/* Don't enable header dump */
+	OUT_RING(ring, 0x00000000);
+	OUT_RING(ring, 0x00000000);
+
+	/* No workarounds enabled */
+	OUT_RING(ring, 0x00000000);
+
+	/* Operation mode mask */
+	OUT_RING(ring, 0x00000002);
+
+	OUT_RING(ring, lower_32_bits(a6xx_gpu->pwrup_reglist_iova));
+	OUT_RING(ring, upper_32_bits(a6xx_gpu->pwrup_reglist_iova));
+	OUT_RING(ring, 0x00000000);
+	OUT_RING(ring, 0x00000000);
+
+	a6xx_flush(gpu, ring);
+	return a6xx_idle(gpu, ring) ? 0 : -EINVAL;
+}
+
 static int a6xx_cp_init(struct msm_gpu *gpu)
 {
+	struct adreno_gpu *adreno_gpu = to_adreno_gpu(gpu);
+	struct a6xx_gpu *a6xx_gpu = to_a6xx_gpu(adreno_gpu);
 	struct msm_ringbuffer *ring = gpu->rb[0];
+
+	if (a6xx_gpu->pwrup_reglist_emitted)
+		return a650_preempt_cp_init(gpu);
 
 	OUT_PKT7(ring, CP_ME_INIT, 8);
 
@@ -1629,7 +1722,8 @@
 
 	/* Enable interrupts */
 	gpu_write(gpu, REG_A6XX_RBBM_INT_0_MASK,
-		  adreno_is_a7xx(adreno_gpu) ? A7XX_INT_MASK : A6XX_INT_MASK);
+		  adreno_is_a7xx(adreno_gpu) ? A7XX_INT_MASK :
+		  A6XX_INT_MASK | (gpu->nr_rings > 1 ? A6XX_RBBM_INT_0_MASK_CP_SW : 0));
 
 	ret = adreno_hw_init(gpu);
 	if (ret)
@@ -1703,6 +1797,12 @@
 
 	if (adreno_is_a7xx(adreno_gpu) && !a6xx_gpu->pwrup_reglist_emitted) {
 		a7xx_patch_pwrup_reglist(gpu);
+		a6xx_gpu->pwrup_reglist_emitted = true;
+	}
+
+	if (!adreno_is_a7xx(adreno_gpu) && gpu->nr_rings > 1 &&
+	    adreno_gpu->info->a6xx->pwrup_reglist && !a6xx_gpu->pwrup_reglist_emitted) {
+		a650_patch_pwrup_reglist(gpu);
 		a6xx_gpu->pwrup_reglist_emitted = true;
 	}
 
