From: overpressure <overpressure@pico4>
Subject: [PATCH] firmware: psci: a refused reset ends in a cold reset

The stock command line asks for a warm reset on a panic (reboot=panic_warm). The firmware refuses
it, and the system then halts until a long press of the power button. Say what the firmware
answered, and after the other restart handlers (PS_HOLD, as the stock kernel resets) try the
ordinary reset, which works on every plain reboot.
---
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -323,7 +323,9 @@
 		 * reset_type[30:0] = 0 (SYSTEM_WARM_RESET)
 		 * cookie = 0 (ignored by the implementation)
 		 */
-		invoke_psci_fn(PSCI_FN_NATIVE(1_1, SYSTEM_RESET2), 0, 0, 0);
+		int ret = invoke_psci_fn(PSCI_FN_NATIVE(1_1, SYSTEM_RESET2), 0, 0, 0);
+
+		pr_emerg("warm reset refused: %d\n", ret);
 	} else {
 		invoke_psci_fn(PSCI_0_2_FN_SYSTEM_RESET, 0, 0, 0);
 	}
@@ -336,6 +338,23 @@
 	.priority = 129,
 };
 
+/*
+ * The last resort, after the other restart handlers: a reset that was refused must not end in a
+ * halted system that only a long press of the power button brings back.
+ */
+static int psci_sys_reset_last(struct notifier_block *nb, unsigned long action,
+			       void *data)
+{
+	invoke_psci_fn(PSCI_0_2_FN_SYSTEM_RESET, 0, 0, 0);
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block psci_sys_reset_last_nb = {
+	.notifier_call = psci_sys_reset_last,
+	.priority = 0,
+};
+
 static void psci_sys_poweroff(void)
 {
 	invoke_psci_fn(PSCI_0_2_FN_SYSTEM_OFF, 0, 0, 0);
@@ -687,6 +706,7 @@
 	};
 
 	register_restart_handler(&psci_sys_reset_nb);
+	register_restart_handler(&psci_sys_reset_last_nb);
 
 	pm_power_off = psci_sys_poweroff;
 }
