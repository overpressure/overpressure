 /* GEN2 1.2.1 2PH */
 static const struct
 csiphy_lane_regs lane_regs_sm8250[] = {
@@ -1213,7 +1305,12 @@ static void csiphy_gen2_config_lanes(struct csiphy_device *csiphy,
 
 	// select which regs to use here because csiphy_regs->lane_regs is setup during probe
 	// but combo_mode variable is updated later during media links setup
-	if(!csiphy->combo_mode) {
+	if (csiphy->camss->res->version == CAMSS_8250) {
+		if (csiphy->combo_mode) {
+			r = &lane_regs_sm8250_combo[0];
+			array_size = ARRAY_SIZE(lane_regs_sm8250_combo);
+		}
+	} else if(!csiphy->combo_mode) {
 		dev_dbg(csiphy->camss->dev, "csiphy%d loading regular registers", csiphy->id);
 		r = &lane_regs_sm8650[0];
 		array_size = ARRAY_SIZE(lane_regs_sm8650);
@@ -1308,8 +1405,8 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 	writel_relaxed(val, csiphy->base +
 		       CSIPHY_3PH_CMN_CSI_COMMON_CTRLn(regs->offset, 6));
 
-	/*val = 0x02;*/
-	val = 0x7a;
