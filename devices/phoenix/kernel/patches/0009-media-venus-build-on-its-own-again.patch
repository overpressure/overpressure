 	if (ret)
 		goto err_firmware_deinit;
 
@@ -562,10 +515,7 @@ static int venus_probe(struct platform_device *pdev)
 err_core_deinit:
 	hfi_core_deinit(core, false);
 err_venus_shutdown:
-	if (core->use_tz)
-		unload_fw(VENUS_PAS_ID);
-	else
-		unload_fw_no_tz(core);
