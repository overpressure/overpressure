 	if (test_bit(0, &core->dump_core)) {
 		venus_coredump(core);
@@ -141,39 +135,12 @@ static void venus_sys_error_handler(struct work_struct *work)
 		failed = true;
 	}
 
-	ret = of_property_read_string_index(core->dev->of_node, "firmware-name", 0,
-					    &fwpath);
-	if (ret)
-		fwpath = core->res->fwname;
-
-	ret = load_fw(core->dev, fwpath, &core->fw.mem_phys, &core->fw.mem_size,
-		      VENUS_PAS_ID, core->use_tz);
-	if (ret && !failed) {
-		err_msg = "load FW";
-		failed = true;
-	}
-
-	if (core->use_tz)
-		ret = auth_reset_fw(VENUS_PAS_ID);
-	else
-		ret = auth_reset_fw_no_tz(core, core->fw.mem_phys, core->fw.mem_size);
+	ret = venus_boot(core);
 	if (ret && !failed) {
-		err_msg = "Auth and Reset";
+		err_msg = "boot Venus";
 		failed = true;
 	}
 
-	if (core->use_tz && res->cp_size) {
-		ret = protect_secure_region(res->cp_start,
-					    res->cp_size,
-					    res->cp_nonpixel_start,
-					    res->cp_nonpixel_size,
-					    VENUS_PAS_ID);
-		if (ret && !failed) {
-			err_msg = "Protect CP Mem";
-			failed = true;
-		}
-	}
-
 	ret = hfi_core_resume(core, true);
 	if (ret && !failed) {
 		err_msg = "resume HFI";
@@ -412,9 +379,7 @@ static void venus_remove_dynamic_nodes(struct venus_core *core) {}
 
 static int venus_probe(struct platform_device *pdev)
 {
-	const struct venus_resources *res;
 	struct device *dev = &pdev->dev;
-	const char *fwpath = NULL;
