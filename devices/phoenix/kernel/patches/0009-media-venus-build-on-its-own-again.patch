 err_firmware_deinit:
 	venus_firmware_deinit(core);
 err_runtime_disable:
@@ -595,15 +545,10 @@ static void venus_remove(struct platform_device *pdev)
 	ret = hfi_core_deinit(core, true);
 	WARN_ON(ret);
 
-	if (core->use_tz)
-		unload_fw(VENUS_PAS_ID);
-	else
-		unload_fw_no_tz(core);
-
+	venus_shutdown(core);
 	of_platform_depopulate(dev);
 
-	if (!core->use_tz)
-		deinit_fw_no_tz(core);
+	venus_firmware_deinit(core);
 
 	venus_remove_dynamic_nodes(core);
 
@@ -627,12 +572,8 @@ static void venus_core_shutdown(struct platform_device *pdev)
 	struct venus_core *core = platform_get_drvdata(pdev);
 
 	pm_runtime_get_sync(core->dev);
-	if (core->use_tz) {
-		unload_fw(VENUS_PAS_ID);
