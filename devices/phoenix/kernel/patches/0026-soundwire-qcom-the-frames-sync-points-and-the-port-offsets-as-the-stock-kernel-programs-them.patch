From: overpressure <overpressure@pico4>
Subject: [PATCH] soundwire: qcom: the frame's sync points and the port offsets as the stock kernel programs them

Read from the WSA and TX masters on the stock kernel while playing: the active frame control holds a
stream synchronization period of 6 frames, 4 kHz at 50 rows, 16 columns and 19.2 Mbit/s, where
mainline leaves the field at 0. A period of 6 frames fits a whole number of every port's sample
intervals; one frame holds 12.5 of the boost port's 64 bits. And an offset of 0xff in the device
tree means none: the stock kernel writes 0 to the port's second offset, mainline wrote 0xff.
---
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -93,6 +93,8 @@
 #define SWRM_MCP_FRAME_CTRL_BANK_ADDR(m)		(0x101C + 0x40 * (m))
 #define SWRM_MCP_FRAME_CTRL_BANK_COL_CTRL_BMSK			GENMASK(2, 0)
 #define SWRM_MCP_FRAME_CTRL_BANK_ROW_CTRL_BMSK			GENMASK(7, 3)
+#define SWRM_MCP_FRAME_CTRL_BANK_SSP_PERIOD_BMSK		GENMASK(23, 16)
+#define SWRM_SSP_RATE_HZ					4000
 #define SWRM_MCP_BUS_CTRL					0x1044
 #define SWRM_MCP_BUS_CLK_START					BIT(1)
 #define SWRM_MCP_CFG_ADDR					0x1048
@@ -1014,12 +1016,16 @@
 {
 	u32 reg = SWRM_MCP_FRAME_CTRL_BANK_ADDR(bus->params.next_bank);
 	struct qcom_swrm_ctrl *ctrl = to_qcom_sdw(bus);
+	u32 frame_bits = sdw_rows[ctrl->rows_index] * sdw_cols[ctrl->cols_index];
 	u32 val;
 
 	ctrl->reg_read(ctrl, reg, &val);
 
 	u32p_replace_bits(&val, ctrl->cols_index, SWRM_MCP_FRAME_CTRL_BANK_COL_CTRL_BMSK);
 	u32p_replace_bits(&val, ctrl->rows_index, SWRM_MCP_FRAME_CTRL_BANK_ROW_CTRL_BMSK);
+	/* Synchronization points at 4 kHz: a whole number of every port's sample intervals. */
+	u32p_replace_bits(&val, bus->params.curr_dr_freq / (frame_bits * SWRM_SSP_RATE_HZ) - 1,
+			  SWRM_MCP_FRAME_CTRL_BANK_SSP_PERIOD_BMSK);
 
 	return ctrl->reg_write(ctrl, reg, val);
 }
@@ -1050,7 +1056,8 @@
 	pcfg = &ctrl->pconfig[params->port_num];
 
 	value = pcfg->off1 << SWRM_DP_PORT_CTRL_OFFSET1_SHFT;
-	value |= pcfg->off2 << SWRM_DP_PORT_CTRL_OFFSET2_SHFT;
+	if (pcfg->off2 != SWR_INVALID_PARAM)
+		value |= pcfg->off2 << SWRM_DP_PORT_CTRL_OFFSET2_SHFT;
 	value |= pcfg->si & 0xff;
 
 	ret = ctrl->reg_write(ctrl, reg, value);
