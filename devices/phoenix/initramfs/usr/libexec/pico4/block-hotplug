#!/bin/sh
# SPDX-License-Identifier: Unlicense
# Block device hook (called by mdev, and once as "block-hotplug sweep").
#
# Every disk and partition is made read-only (BLKROSET) the moment it
# appears, so nothing in this system can modify the headset's storage. Boot with
# pico4.rw=1 to disable this. Also creates Android-style links:
#   /dev/block/by-name/<PARTNAME> -> ../../sdXN
#   /dev/block/bootdevice -> .  (so /dev/block/bootdevice/by-name/... works)
. /usr/libexec/pico4/lib.sh

handle() {
	local name=$1 partname
	case "$name" in loop* | ram* | zram* | dm-* | nbd*) return 0 ;; esac
	[ -e "/sys/class/block/$name" ] || return 0
	if [ "$(stage1_arg rw 0)" != 1 ]; then
		# The node may be created a moment after the uevent; retry briefly.
		for _ in 1 2 3 4 5; do
			[ -b "/dev/$name" ] && break
			sleep 0.2
		done
		blockdev --setro "/dev/$name" 2>/dev/null || log "could not set /dev/$name read-only"
	fi
	partname=$(sed -n 's/^PARTNAME=//p' "/sys/class/block/$name/uevent" 2>/dev/null)
	if [ -n "$partname" ]; then
		mkdir -p /dev/block/by-name
		ln -sfn "../../$name" "/dev/block/by-name/$partname"
		[ -e /dev/block/bootdevice ] || ln -s . /dev/block/bootdevice
	fi
}

case "$1" in
sweep)
	for d in /sys/class/block/*; do
		[ -e "$d" ] && handle "${d##*/}"
	done
	;;
*)
	[ -n "$MDEV" ] || exit 0
	if [ "$ACTION" = remove ]; then
		for l in /dev/block/by-name/*; do
			[ "$(readlink "$l")" = "../../$MDEV" ] && rm -f "$l"
		done
	else
		handle "$MDEV"
	fi
	;;
esac
exit 0
