#!/bin/sh
# SPDX-License-Identifier: Unlicense
# Self-test for the QEMU test VM (kernel argument pico4.selftest=1).
#
# In the VM, dummy_hcd connects our USB gadget to a virtual host controller
# in the same kernel, so the VM is both the "headset" and the "PC". Results go
# to the kernel log; the harness looks for "PICO4-SELFTEST: PASS".
. /usr/libexec/pico4/lib.sh

pass=0
fail=0
ok() { pass=$((pass + 1)); log "SELFTEST ok: $*"; }
bad() { fail=$((fail + 1)); log "SELFTEST FAIL: $*"; }
check() {
	local what=$1
	shift
	if "$@" >/dev/null 2>&1; then ok "$what"; else bad "$what"; fi
}

# PC-side device of a gadget function: first match of DRIVER among SYSDIRS.
host_netif() {
	local n drv
	for n in /sys/class/net/*; do
		drv=$(readlink "$n/device/driver" 2>/dev/null)
		case "${drv##*/}" in cdc_ncm | rndis_host | cdc_ether) echo "${n##*/}"; return 0 ;; esac
	done
	return 1
}
host_disk() {
	local b
	for b in /sys/block/sd*; do
		[ -e "$b" ] && grep -q "Gadget" "$b/device/model" 2>/dev/null && echo "${b##*/}" && return 0
	done
	return 1
}

wait_for "$P4_RUN/usb.done" 90 || bad "USB setup did not finish"
. "$P4_RUN/net.env"
. "$P4_RUN/usb.env"
. "$P4_RUN/serial.env"

check "/dev populated without devtmpfs (mdev)" [ -c /dev/null -a -c /dev/kmsg -a -c /dev/ptmx ]
check "gadget bound to $UDC" grep -qx bound "$P4_RUN/usb.state"
check "headset address $IP on $IFACE" sh -c "ip addr show dev '$IFACE' | grep -q 'inet $IP/'"

# pico4.selftest_hostdelay=N: the "PC" ignores the link for N seconds, so
# the headset's silent-link re-plug (usb-gadget watch) has to kick in.
hostdelay=$(stage1_arg selftest_hostdelay 0)
if [ "$hostdelay" -gt 0 ]; then
	log "SELFTEST: PC side stays silent for ${hostdelay}s"
	sleep "$hostdelay"
	n=$(grep -c re-plugging "$P4_LOG")
	check "silent link was re-plugged ($n times, at most 2)" [ "$n" -ge 1 -a "$n" -le 2 ]
fi

i=0
until hif=$(host_netif) || [ "$i" -ge 30 ]; do sleep 1; i=$((i + 1)); done
check "PC side enumerated the network function (${hif:-none})" [ -n "$hif" ]
check "controller state is configured" grep -qx configured "/sys/class/udc/$UDC/state"

if [ -n "$hif" ]; then
	ip link set "$hif" up
	cat > /tmp/selftest-dhcp <<-'EOF'
	#!/bin/sh
	[ "$1" = bound ] && echo "$ip" > /tmp/selftest-lease
	exit 0
	EOF
	chmod +x /tmp/selftest-dhcp
	# Like a real PC, keep asking for a minute; the interface may vanish and
	# come back if the headset re-plugs the link (usb-gadget watch).
	got=""
	for attempt in 1 2 3 4 5 6 7 8; do
		if hif=$(host_netif); then
			ip link set "$hif" up
			udhcpc -i "$hif" -n -q -t 5 -T 1 -s /tmp/selftest-dhcp >/dev/null 2>&1 && got=$attempt && break
		else
			sleep 2
		fi
	done
	if [ -n "$got" ]; then
		ok "PC got a DHCP lease across the USB link (attempt $got$(grep -q re-plugging "$P4_LOG" && echo ', after a USB re-plug'))"
	else
		bad "PC got a DHCP lease across the USB link"
	fi
	check "lease is $HOST_IP" grep -qx "$HOST_IP" /tmp/selftest-lease
	if [ ! -s /tmp/selftest-lease ]; then
		log "SELFTEST dhcp debug: udhcpd pid=$(pidof udhcpd) $IFACE carrier=$(cat /sys/class/net/$IFACE/carrier 2>/dev/null) $hif carrier=$(cat /sys/class/net/$hif/carrier 2>/dev/null) $(ip -o addr | tr -s ' \n' ' ')"
		log "SELFTEST dhcp debug: svc-udhcpd.log: $(tr '\n' '|' < "$P4_RUN/svc-udhcpd.log" 2>/dev/null)"
	fi
fi

for svc in 22:ssh 23:telnet 80:http; do
	check "${svc#*:} listening on port ${svc%%:*}" sh -c "netstat -ltn | grep -q ':${svc%%:*} '"
done
check "ssh login as root with the empty password" sh -c \
	"timeout 90 dbclient -y -y root@127.0.0.1 'echo SSH-\$((6*7))-OK' 2>/dev/null | grep -q SSH-42-OK"
check "web status page" sh -c "wget -qO- http://127.0.0.1/cgi-bin/status | grep -q 'PICO 4 Linux'"
check "web boot log" sh -c "wget -qO- 'http://127.0.0.1/cgi-bin/log?boot' | grep -q 'USB: gadget bound'"

# Storage must refuse writes.
dev=$(readlink -f /dev/block/by-name/stage1_test 2>/dev/null)
if [ -b "$dev" ]; then
	ok "by-name link /dev/block/by-name/stage1_test -> $dev"
	check "$dev is read-only" [ "$(blockdev --getro "$dev")" = 1 ]
	check "writing to $dev is refused" sh -c "! dd if=/dev/zero of='$dev' bs=4096 count=1 conv=fsync"
	check "Android-style /dev/block/bootdevice/by-name path" [ -b /dev/block/bootdevice/by-name/stage1_test ]
else
	bad "no /dev/block/by-name/stage1_test (attach the test disk)"
fi

# The read-only log drive, seen from the PC side.
i=0
until disk=$(host_disk) || [ "$i" -ge 20 ]; do sleep 1; i=$((i + 1)); done
if [ -n "$disk" ]; then
	mkdir -p /mnt/logdisk
	check "PC can mount the log drive (/dev/$disk)" mount -t vfat -o ro "/dev/$disk" /mnt/logdisk
	check "log drive has boot.log" [ -s /mnt/logdisk/boot.log ]
	umount /mnt/logdisk 2>/dev/null
else
	[ "$(stage1_arg logdisk 1)" = 1 ] && bad "log drive not seen by the PC side"
fi

# Shell over USB serial (only kernels with CDC-ACM; not the stock PICO one).
if [ -n "$TTY" ]; then
	i=0
	until [ -c /dev/ttyACM0 ] || [ "$i" -ge 20 ]; do sleep 1; i=$((i + 1)); done
	if [ -c /dev/ttyACM0 ]; then
		# One fd for the whole exchange, so "raw -echo" stays in effect (an
		# echoing PC-side tty would feed the headset's output back as input).
		# Answer getty's login prompt (any name), then run a command; it is
		# sent a few times in case the first one is lost.
		check "login shell answers on the USB serial port" sh -c '
			exec 3<>/dev/ttyACM0
			stty raw -echo <&3
			timeout 25 cat <&3 > /tmp/serial.out &
			sleep 1
			printf "root\r" >&3
			for i in 1 2 3 4; do
				sleep 3
				printf "echo SERIAL-\$((6*7))-OK\r" >&3
				grep -q SERIAL-42-OK /tmp/serial.out && exit 0
			done
			sleep 3
			grep -q SERIAL-42-OK /tmp/serial.out'
		grep -q SERIAL-42-OK /tmp/serial.out 2>/dev/null ||
			log "SELFTEST serial port received: $(head -c 300 /tmp/serial.out 2>/dev/null | od -An -c | tr -s ' \n' ' ')"
	else
		bad "PC side has no /dev/ttyACM0"
	fi
fi

# Hardware report (pico4-probe runs shortly after boot).
wait_for "$P4_RUN/probe.done" 120
check "hardware report collected" [ -s "$P4_RUN/report.tar.gz" ]
check "report downloadable over http" sh -c "wget -qO- http://127.0.0.1/cgi-bin/report | gzip -t"
check "report browsable over http" sh -c "wget -qO- http://127.0.0.1/report/summary.txt | grep -q kernel"

# Hand the report to the harness: the test disk's second partition is made
# writable on purpose (everything else stays read-only) and gets the tarball.
# Newer kernels also treat a partition as read-only while its disk is, so
# both have to be switched.
exp=$(readlink -f /dev/block/by-name/stage1_export 2>/dev/null)
if [ -b "$exp" ] && [ -s "$P4_RUN/report.tar.gz" ]; then
	disk=$(basename "$(dirname "$(readlink -f "/sys/class/block/${exp##*/}")")")
	blockdev --setrw "/dev/$disk" && blockdev --setrw "$exp" &&
		dd if="$P4_RUN/report.tar.gz" of="$exp" bs=64k conv=fsync &&
		log "SELFTEST exported the report to $exp"
fi

if [ "$fail" = 0 ]; then
	log "PICO4-SELFTEST: PASS ($pass checks)"
else
	log "PICO4-SELFTEST: FAIL ($fail of $((pass + fail)) checks failed)"
fi
sync
sleep 1
[ "$(stage1_arg selftest_poweroff 1)" = 1 ] && pico4-reboot poweroff
exit 0
