#!/bin/sh
# SPDX-License-Identifier: Unlicense
# Install the Linux system on the headset, from the maintenance stage 1 in recovery
# (docs/install.md). The only partitions it writes:
#
#   pico4-install write boot|super --size BYTES --bytes N --sha256 HEX [--zstd] < IMAGE
#       write an image to the start of boot (the installed boot image) or super (the system
#       image). The partition must be BYTES large (the PC passes the backup's size), the image
#       at most that; the written bytes are read back and must have the SHA-256 HEX.
#       --zstd: the stream is zstd-compressed; N and HEX are the image's, decompressed.
#   pico4-install format-data --size BYTES
#       a new ext4 file system "pico4-data" on userdata (BYTES as the backup has it)
#   pico4-install keys --size BYTES --id ID < AUTHORIZED_KEYS
#       the installed system's SSH keys and install ID on its data partition (pico4-data):
#       /root/.ssh/authorized_keys and /etc/pico4/install-id (in the /etc overlay's upper layer)
#   pico4-install wipe userdata|metadata --size BYTES
#       zero the first 64 MiB, the way back to PICO OS: both are "formattable" in its fstab,
#       so it makes new file systems (and encryption keys) on its next boot
#   pico4-install bootmode recovery|normal
#       the bootloader message in misc: "boot-recovery" keeps every boot in this maintenance
#       stage 1, as the ABL's "fastboot reboot recovery" sets it; "normal" clears it (all zero,
#       as the backup's misc), so the next boot starts boot's image
#   pico4-install hash NAME BYTES
#       the SHA-256 of the partition's first BYTES (read-only: whether it holds an image)
#   pico4-install status
#
# Each partition is made writable for its write only and read-only again afterwards.
. /usr/libexec/pico4/lib.sh
set -o pipefail

STATE=$P4_RUN/install
BCB_BYTES=2048 # Android's struct bootloader_message
die() { log "install: $*"; echo "pico4-install: $*" >&2; exit 1; }

# The block device of a partition, checked against the size the PC expects.
partition() {
	local name=$1 size=$2 dev
	dev=$(readlink -f "/dev/block/by-name/$name" 2>/dev/null)
	[ -b "$dev" ] || die "no partition $name"
	[ "$(blockdev --getsize64 "$dev")" = "$size" ] || die "$name is not $size bytes"
	echo "$dev"
}

writable() { blockdev --setrw "$1" || die "could not make $1 writable"; }
readonly_again() { blockdev --setro "$1" || log "install: could not set $1 read-only"; }

# sha256: the SHA-256 of standard input in hex: OpenSSL's, which uses the CPU's SHA-2 instructions,
# else BusyBox's (42 MB/s here: slower than the USB link brings a compressed image).
sha256() {
	if command -v openssl >/dev/null 2>&1; then
		openssl dgst -sha256 -r | cut -d' ' -f1
	else
		sha256sum | cut -d' ' -f1
	fi
}

# read_part DEVICE BYTES: the device's first BYTES, read in 4 MiB blocks (head -c reads a block
# device in small pieces: half the speed with the hash).
read_part() {
	dd if="$1" bs=4M iflag=count_bytes count="$2" 2>/dev/null
}

# stream ZSTD: standard input as the image, decompressed when ZSTD is 1.
stream() {
	if [ "$1" = 1 ]; then zstd -dcq; else cat; fi
}

write() {
	local name=$1 size="" bytes="" sha="" zstd=0 dev back
	shift
	case "$name" in boot | super) ;; *) die "write refuses $name (boot or super only)" ;; esac
	while [ $# -gt 0 ]; do
		case "$1" in
		--size) size=$2; shift ;;
		--bytes) bytes=$2; shift ;;
		--sha256) sha=$2; shift ;;
		--zstd) zstd=1 ;;
		*) die "unknown option $1" ;;
		esac
		shift
	done
	[ -n "$size" ] && [ -n "$bytes" ] && [ ${#sha} = 64 ] || die "write needs --size, --bytes and --sha256"
	[ "$bytes" -gt 0 ] && [ "$bytes" -le "$size" ] || die "the image ($bytes bytes) does not fit $name"
	[ "$zstd" = 0 ] || command -v zstd >/dev/null || die "zstd missing from this image (rebuild stage 1)"
	dev=$(partition "$name" "$size")
	mkdir -p "$STATE"
	writable "$dev"
	log "install: writing $bytes bytes to $name ($dev)"
	# Straight into dd in 4 MiB blocks: a hash of the stream beside it (tee) held the write to
	# 25 MB/s, below the USB link. The readback below checks what was written, and with it the
	# stream: a stream that differs from the image cannot read back with the image's hash.
	stream "$zstd" | dd of="$dev" bs=4M iflag=count_bytes,fullblock count="$bytes" conv=fsync 2> "$STATE/dd.log"
	local rc=$?
	sync
	readonly_again "$dev"
	[ $rc = 0 ] || die "writing $name failed ($(tail -n 2 "$STATE/dd.log" | tr '\n' ' '))"
	echo 3 > /proc/sys/vm/drop_caches
	back=$(read_part "$dev" "$bytes" | sha256)
	[ "$back" = "$sha" ] || die "readback of $name differs: $back is not the image's $sha ($name now holds it)"
	log "install: $name holds $sha"
	echo "written $name $sha"
}

format_data() {
	local size="" dev
	[ "$1" = --size ] && size=$2
	[ -n "$size" ] || die "format-data needs --size"
	dev=$(partition userdata "$size")
	command -v mkfs.ext4 >/dev/null || die "mkfs.ext4 missing from this image"
	writable "$dev"
	log "install: formatting userdata ($dev) as pico4-data"
	# e2fsprogs >= 1.47 enables features the stock kernel, under this maintenance stage 1, cannot mount.
	mkfs.ext4 -q -F -L pico4-data -O ^orphan_file,^metadata_csum_seed "$dev"
	local rc=$?
	sync
	readonly_again "$dev"
	[ $rc = 0 ] || die "mkfs.ext4 failed"
	[ "$(ext_label "$dev")" = pico4-data ] || die "userdata has no pico4-data file system after formatting"
	echo "formatted userdata"
}

keys() {
	local size="" id="" dev mnt=$STATE/data count rc=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--size) size=$2; shift ;;
		--id) id=$2; shift ;;
		*) die "unknown option $1" ;;
		esac
		shift
	done
	[ -n "$size" ] && [ -n "$id" ] || die "keys needs --size and --id"
	case "$id" in *[!A-Za-z0-9._-]*) die "the install ID may hold letters, digits, dots, dashes" ;; esac
	dev=$(partition userdata "$size")
	[ "$(ext_label "$dev")" = pico4-data ] || die "userdata holds no pico4-data file system"
	mkdir -p "$STATE" "$mnt"
	head -c 65536 > "$STATE/authorized_keys"
	count=$(grep -c -E '^(ssh-|ecdsa-|sk-)' "$STATE/authorized_keys")
	[ "$count" -gt 0 ] || die "no SSH public key on standard input"
	writable "$dev"
	mount -t ext4 -o noatime "$dev" "$mnt" || { readonly_again "$dev"; die "mounting userdata failed"; }
	{
		mkdir -p "$mnt/root/.ssh" "$mnt/etc/upper/pico4" &&
			chmod 700 "$mnt/root/.ssh" &&
			cp "$STATE/authorized_keys" "$mnt/root/.ssh/authorized_keys" &&
			chmod 600 "$mnt/root/.ssh/authorized_keys" &&
			echo "$id" > "$mnt/etc/upper/pico4/install-id" &&
			chown -R 0:0 "$mnt/root/.ssh" "$mnt/etc/upper/pico4"
	} || rc=1
	umount "$mnt" || rc=1
	sync
	readonly_again "$dev"
	[ $rc = 0 ] || die "writing the keys to userdata failed"
	log "install: $count SSH key(s) and install ID $id on userdata"
	echo "keys $count"
}

wipe() {
	local name=$1 size="" dev mib=64
	case "$name" in userdata | metadata) ;; *) die "wipe refuses $name (userdata or metadata only)" ;; esac
	[ "$2" = --size ] && size=$3
	[ -n "$size" ] || die "wipe needs --size"
	dev=$(partition "$name" "$size")
	[ "$size" -ge $((mib << 20)) ] || mib=$((size >> 20))
	writable "$dev"
	dd if=/dev/zero of="$dev" bs=1M count="$mib" conv=fsync 2>/dev/null
	local rc=$?
	sync
	readonly_again "$dev"
	[ $rc = 0 ] || die "wiping $name failed"
	echo 3 > /proc/sys/vm/drop_caches
	[ "$(head -c $((mib << 20)) "$dev" | tr -d '\000' | head -c 1 | wc -c)" = 0 ] || die "readback of $name is not zero"
	log "install: wiped the first $mib MiB of $name"
	echo "wiped $name"
}

bootmode() {
	local dev want got
	dev=$(readlink -f /dev/block/by-name/misc 2>/dev/null)
	[ -b "$dev" ] || die "no misc partition"
	mkdir -p "$STATE"
	case "$1" in
	recovery) { printf 'boot-recovery'; head -c $((BCB_BYTES - 13)) /dev/zero; } > "$STATE/bcb" ;;
	normal) head -c $BCB_BYTES /dev/zero > "$STATE/bcb" ;;
	*) die "bootmode recovery|normal" ;;
	esac
	want=$(sha256 < "$STATE/bcb")
	writable "$dev"
	dd if="$STATE/bcb" of="$dev" bs=$BCB_BYTES count=1 conv=fsync,notrunc 2>/dev/null
	local rc=$?
	sync
	readonly_again "$dev"
	[ $rc = 0 ] || die "writing misc failed"
	echo 3 > /proc/sys/vm/drop_caches
	got=$(head -c $BCB_BYTES "$dev" | sha256)
	[ "$got" = "$want" ] || die "readback of misc differs"
	log "install: boot mode $1"
	echo "bootmode $1"
}

hash() {
	local name=$1 bytes=$2 dev
	case "$bytes" in '' | *[!0-9]*) die "hash needs a partition and a byte count" ;; esac
	dev=$(readlink -f "/dev/block/by-name/$name" 2>/dev/null)
	[ -b "$dev" ] || die "no partition $name"
	read_part "$dev" "$bytes" | sha256
}

status() {
	local cmd label
	cmd=$(head -c 32 /dev/block/by-name/misc 2>/dev/null | tr -d '\000')
	echo "bootmode: ${cmd:-normal}"
	label=$(ext_label /dev/block/by-name/super 2>/dev/null)
	echo "system: ${label:-none}"
	label=$(ext_label /dev/block/by-name/userdata 2>/dev/null)
	echo "data: ${label:-none}"
}

case "${1:-}" in
write) shift; write "$@" ;;
format-data) shift; format_data "$@" ;;
keys) shift; keys "$@" ;;
hash) hash "$2" "$3" ;;
wipe) shift; wipe "$@" ;;
bootmode) bootmode "$2" ;;
status) status ;;
*) sed -n '3,27s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
