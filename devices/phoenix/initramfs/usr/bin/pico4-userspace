#!/bin/sh
# SPDX-License-Identifier: Unlicense
# Stage-2 handoff: hand PID 1 to the installed system's systemd (docs/install.md).
#
#   pico4-userspace installed
#       super read-only at /newroot, userdata (pico4-data) at /newroot/data, with
#       /etc as an overlay and /var, /home and /root on the data (pico4-install)
#   pico4-userspace switch
#       carry over SSH identity, test-run state and USB network settings, then
#       let pico4-init hand PID 1 to systemd (the SSH session is closed)
#   pico4-userspace status
. /usr/libexec/pico4/lib.sh
set -o pipefail

NEW=/newroot
STATE=$P4_RUN/userspace
die() { log "userspace: $*"; echo "pico4-userspace: $*" >&2; exit 1; }

# The system image (super) is read-only and replaced whole by an update; the data partition
# keeps what changes: /etc's changes (an overlay), /var, /home and /root. On the first boot, and
# for /var/lib/pacman after each new system image, they start as the image has them.
installed() {
	local system data disk image dir
	system=$(readlink -f /dev/block/by-name/super 2>/dev/null)
	data=$(readlink -f /dev/block/by-name/userdata 2>/dev/null)
	[ -b "$system" ] && [ -b "$data" ] || die "super or userdata missing"
	grep -q " $NEW " /proc/mounts && die "$NEW is already mounted"
	[ "$(ext_label "$system" 2>/dev/null)" = pico4-system ] || die "super holds no pico4-system image"
	[ "$(ext_label "$data" 2>/dev/null)" = pico4-data ] || die "userdata holds no pico4-data file system"
	mkdir -p "$STATE" "$NEW"
	rm -f "$STATE"/*
	mount -t ext4 -o ro,noatime "$system" "$NEW" || die "mounting the system image failed"
	[ -d "$NEW/data" ] || die "the system image has no /data"
	# The 4.19 kernel keeps a partition's read-only flag apart from its disk's. A mainline kernel
	# also counts its disk's, so there the disk becomes writable too; its other partitions keep
	# their own flags.
	blockdev --setrw "$data" || die "could not make userdata writable"
	if [ "$(cat "/sys/class/block/${data##*/}/ro")" != 0 ]; then
		disk=$(readlink -f "/sys/class/block/${data##*/}/..")
		blockdev --setrw "/dev/${disk##*/}" || die "could not make ${disk##*/} writable"
	fi
	mount -t ext4 -o noatime "$data" "$NEW/data" || die "mounting the data partition failed"
	image=$(cat "$NEW/usr/share/pico4/system-image" 2>/dev/null)
	if [ ! -e "$NEW/data/.pico4-initialized" ]; then
		log "userspace: first boot of the installed system: data from the image"
		for dir in var root home; do
			mkdir -p "$NEW/data/$dir"
			cp -a "$NEW/$dir/." "$NEW/data/$dir/" || die "copying /$dir"
		done
		mkdir -p "$NEW/data/etc/upper" "$NEW/data/etc/work"
		# Settings an earlier system kept under its old folder name.
		if [ -d "$NEW/data/etc/upper/pico4-poc" ] && [ ! -e "$NEW/data/etc/upper/pico4" ]; then
			mv "$NEW/data/etc/upper/pico4-poc" "$NEW/data/etc/upper/pico4"
		fi
		touch "$NEW/data/.pico4-initialized"
	elif [ "$(cat "$NEW/data/.pico4-system-image" 2>/dev/null)" != "$image" ]; then
		# A new system image: its package database replaces the old one.
		log "userspace: new system image: package database from the image"
		rm -rf "$NEW/data/var/lib/pacman"
		cp -a "$NEW/var/lib/pacman" "$NEW/data/var/lib/" || die "copying the package database"
	fi
	echo "$image" > "$NEW/data/.pico4-system-image"
	# Without the inodes index: an update replaces the lower /etc whole, and with the index (a
	# mainline kernel's default here) the upper directory stays tied to the image it was made
	# with ("failed to verify upper root origin").
	mount -t overlay overlay -o "lowerdir=$NEW/etc,upperdir=$NEW/data/etc/upper,workdir=$NEW/data/etc/work,index=off" \
		"$NEW/etc" || die "mounting the /etc overlay failed"
	for dir in var root home; do
		mount --bind "$NEW/data/$dir" "$NEW/$dir" || die "mounting /$dir"
	done
	[ -x "$NEW/usr/lib/systemd/systemd" ] || die "no systemd in the system image"
	chroot "$NEW" /usr/lib/systemd/systemd --version > "$STATE/systemd-version" 2>&1 ||
		die "the system's systemd does not run here: $(head -n 2 "$STATE/systemd-version")"
	cp "$NEW/usr/share/pico4/userspace-archive.sha256" "$STATE/archive.sha256" 2>/dev/null ||
		echo "$image" > "$STATE/archive.sha256"
	touch "$STATE/received"
	log "userspace: installed system ${image:-unknown} mounted, data $(df -k "$NEW/data" | awk 'NR==2 {print int($3/1048576)}') of" \
		"$(df -k "$NEW/data" | awk 'NR==2 {print int($2/1048576)}') GiB used, $(head -n 1 "$STATE/systemd-version")"
	echo "installed $image"
}

# Convert the stage-1 dropbear host keys, so the hardware runner's pinned
# known_hosts entry stays valid after the switch.
host_keys() {
	local k t
	# An installed system keeps its own keys (in the /etc overlay) from its first boot on.
	if grep -q " $NEW/data " /proc/mounts && [ -s "$NEW/etc/ssh/ssh_host_ed25519_key" ]; then
		return 0
	fi
	mkdir -p "$NEW/etc/ssh"
	for t in ed25519 ecdsa rsa; do
		k=/etc/dropbear/dropbear_${t}_host_key
		[ -s "$k" ] || continue
		dropbearconvert dropbear openssh "$k" "$NEW/etc/ssh/ssh_host_${t}_key" >/dev/null 2>&1 ||
			die "could not convert the $t host key"
		chmod 600 "$NEW/etc/ssh/ssh_host_${t}_key"
		dropbearkey -y -f "$k" | grep "^ssh-\|^ecdsa-" > "$NEW/etc/ssh/ssh_host_${t}_key.pub"
	done
}

network() {
	local offset
	. "$P4_RUN/net.env" 2>/dev/null
	[ -n "$IFACE" ] || { log "userspace: no USB network to carry over"; return 0; }
	offset=${HOST_IP##*.}
	# The PC keeps talking to this exact link: stage 2 checks it is unchanged.
	mkdir -p "$NEW/etc/pico4"
	printf 'IFACE=%s\nMAC=%s\nIP=%s\n' "$IFACE" "$(cat "/sys/class/net/$IFACE/address")" "$IP" \
		> "$NEW/etc/pico4/usb-link.env"
	mkdir -p "$NEW/etc/systemd/network"
	cat > "$NEW/etc/systemd/network/50-pico4-usb.network" <<-EOF
	# Written by pico4-userspace switch from the stage-1 USB setup.
	[Match]
	Name=$IFACE

	[Link]
	RequiredForOnline=no

	[Network]
	Address=$IP/24
	DHCPServer=yes
	LinkLocalAddressing=no
	IPv6AcceptRA=no
	ConfigureWithoutCarrier=yes
	KeepConfiguration=yes

	[DHCPServer]
	PoolOffset=$offset
	PoolSize=1
	EmitDNS=no
	EmitNTP=no
	EmitRouter=no
	DefaultLeaseTimeSec=86400
	EOF
}

switch() {
	[ -e "$STATE/received" ] || die "no system mounted yet (pico4-userspace installed)"
	grep -q " $NEW " /proc/mounts || die "$NEW is not mounted"
	[ "$(cat /proc/1/comm)" = pico4-init ] || die "PID 1 is not pico4-init (rebuild the image)"
	grep -q '^::restart:/usr/libexec/pico4/switch-userspace' /etc/inittab || die "image lacks the handoff entry"

	host_keys
	mkdir -p "$NEW/etc/pico4" "$NEW/root/.ssh"
	cp -a /etc/pico4/. "$NEW/etc/pico4/"
	cp "$STATE/archive.sha256" "$NEW/etc/pico4/userspace-archive.sha256"
	if [ -s /root/.ssh/authorized_keys ]; then
		cp /root/.ssh/authorized_keys "$NEW/root/.ssh/authorized_keys"
		chmod 700 "$NEW/root/.ssh"
		chmod 600 "$NEW/root/.ssh/authorized_keys"
	fi
	# Stable per headset, so journals of different boots belong together.
	device_serial | md5sum | cut -c1-32 > "$NEW/etc/machine-id"
	network
	# Uptime of the switch: starts stage 2's connection deadline in test runs.
	cut -d. -f1 /proc/uptime > "$STATE/ready"
	log "userspace: prepared; handing over to systemd"
	# Detached: pico4-init stops every user process, including this SSH session.
	( sleep 2; kill -QUIT 1 ) </dev/null >/dev/null 2>&1 &
	echo "switching"
}

case "${1:-}" in
installed) installed ;;
switch) switch ;;
status)
	for f in received ready archive.sha256; do
		[ -e "$STATE/$f" ] && echo "$f: $(cat "$STATE/$f")"
	done
	grep " $NEW " /proc/mounts
	;;
*) sed -n '3,11s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
