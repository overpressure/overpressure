# Services of the PICO 4 Linux POC, run by /usr/libexec/pico4-poc/pico4-init
# (busybox inittab syntax; see also /usr/libexec/pico4-poc/svc).
# /init has already done all one-time setup before exec'ing init.
::respawn:/usr/libexec/pico4-poc/svc udhcpd
::respawn:/usr/libexec/pico4-poc/svc telnetd
::respawn:/usr/libexec/pico4-poc/svc dropbear
::respawn:/usr/libexec/pico4-poc/svc httpd
::respawn:/usr/libexec/pico4-poc/svc serial
::respawn:/usr/libexec/pico4-poc/svc usb-watch
::respawn:/usr/libexec/pico4-poc/svc recovery-watch
::ctrlaltdel:/sbin/reboot
# SIGQUIT (pico4-userspace switch): hand PID 1 to the installed system's systemd.
::restart:/usr/libexec/pico4-poc/switch-userspace
::shutdown:/usr/libexec/pico4-poc/svc shutdown
