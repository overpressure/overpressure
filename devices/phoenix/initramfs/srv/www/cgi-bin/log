#!/bin/sh
# SPDX-License-Identifier: Unlicense
# /cgi-bin/log?boot|dmesg|services|pstore
printf 'Content-Type: text/plain; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
case "$QUERY_STRING" in
boot) cat /run/pico4/boot.log ;;
dmesg) dmesg ;;
services)
	for f in /run/pico4/svc-*.log; do
		[ -e "$f" ] || continue
		echo "==== ${f##*/}"
		tail -n 200 "$f"
	done
	;;
pstore)
	for f in /sys/fs/pstore/*; do
		[ -e "$f" ] || { echo "pstore is empty"; break; }
		echo "==== ${f##*/}"
		cat "$f"
	done
	;;
*) echo "unknown log '$QUERY_STRING'" ;;
esac
