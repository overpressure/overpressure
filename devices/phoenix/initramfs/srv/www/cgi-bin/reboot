#!/bin/sh
# SPDX-License-Identifier: Unlicense
# POST target=android|bootloader|recovery
printf 'Content-Type: text/plain; charset=utf-8\r\n\r\n'
if [ "$REQUEST_METHOD" != POST ]; then
	echo "use POST"
	exit 0
fi
len=${CONTENT_LENGTH:-0}
[ "$len" -gt 100 ] && len=100
body=$(head -c "$len")
case "$body" in
target=android) mode="" ;;
target=bootloader) mode=bootloader ;;
target=recovery) mode=recovery ;;
*) echo "unknown target"; exit 0 ;;
esac
echo "rebooting ${mode:-to PICO OS} in 2 seconds"
. /usr/libexec/pico4/lib.sh
log "reboot requested from the web UI: ${mode:-android}"
( sleep 2; pico4-reboot $mode ) >/dev/null 2>&1 &
