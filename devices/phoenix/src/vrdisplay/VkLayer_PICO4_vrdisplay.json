{
    "file_format_version": "1.2.0",
    "layer": {
        "name": "VK_LAYER_PICO4_vrdisplay",
        "type": "GLOBAL",
        "library_path": "/usr/lib/libVkLayer_PICO4_vrdisplay.so",
        "api_version": "1.4.328",
        "implementation_version": "1",
        "description": "PICO 4 panels as a VK_KHR_display direct-mode display (SteamVR's compositor)",
        "functions": {
            "vkNegotiateLoaderLayerInterfaceVersion": "vkNegotiateLoaderLayerInterfaceVersion"
        },
        "instance_extensions": [
            {"name": "VK_KHR_display", "spec_version": "23"},
            {"name": "VK_KHR_get_display_properties2", "spec_version": "1"},
            {"name": "VK_EXT_direct_mode_display", "spec_version": "1"},
            {"name": "VK_EXT_acquire_drm_display", "spec_version": "1"},
            {"name": "VK_EXT_display_surface_counter", "spec_version": "1"}
        ],
        "device_extensions": [
            {
                "name": "VK_EXT_display_control",
                "spec_version": "1",
                "entrypoints": ["vkDisplayPowerControlEXT", "vkRegisterDeviceEventEXT",
                                "vkRegisterDisplayEventEXT", "vkGetSwapchainCounterEXT"]
            }
        ],
        "enable_environment": {
            "PICO4_VRDISPLAY": "1"
        },
        "disable_environment": {
            "PICO4_VRDISPLAY_DISABLE": "1"
        }
    }
}
