#!/bin/bash
# On a mainline kernel, bring the LPASS VA macro up once PICO OS's audio process runs. Its probe
# votes the LPASS hardware through the AFE, which refuses the vote until the audio process
# (audiopd) is up; a probe before that fails for good rather than deferring, and the driver has no
# bind file: the platform bus probes it again (drivers_probe). The other macros, the SoundWire
# buses and the card wait for the VA macro and follow it, so the card is what this waits for.
# While a probe runs, the device already shows its driver: only an unbound macro is probed again.
. /usr/libexec/pico4-poc/lib.sh
set -u
DEV=3370000.codec
CARD=/proc/asound/PICO4

# A refused vote takes the AFE's 3 s timeout: about two minutes in all.
for _ in $(seq 1 40); do
	if [ -e "$CARD" ]; then
		log "lpass-macros: sound card up"
		exit 0
	fi
	[ -e "/sys/bus/platform/devices/$DEV/driver" ] || echo "$DEV" > /sys/bus/platform/drivers_probe 2> /dev/null || true
	sleep 2
done
log "lpass-macros: no sound card"
exit 1
