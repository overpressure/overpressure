#!/bin/sh
# After a boot the panels stay dark, whatever the session shows, until a resume or until their
# power-on commands go out again over the running video (panel-pico4-ls026b3sa.c). Leaving SteamVR's
# standby does that, but someone who wears the headset as the session starts never sees a standby:
# so once the compositor runs, the backlight device blanks and unblanks once. A standby that came
# first has blanked it already and needs nothing (docs/session.md).
power=/sys/class/backlight/pico4-panel/bl_power
[ -w "$power" ] || exit 0
(
	for _ in $(seq 1 30); do
		pgrep -x vrcompositor > /dev/null && break
		sleep 1
	done
	sleep 3
	[ "$(cat "$power")" = 0 ] || exit 0
	echo 4 > "$power"
	sleep 0.2
	echo 0 > "$power"
) &
