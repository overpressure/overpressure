#!/bin/bash
# udev helper for the stock PICO 4 kernel, which has no devtmpfs:
#   devnode add     create the node for $DEVNAME (from 00-pico4-devnodes.rules)
#   devnode remove  delete it again
#   devnode sweep   apply the storage policy to every block device present
#
# Block devices are made read-only as soon as they appear, exactly like the
# stage-1 initramfs does (pico4poc.rw=1 on the kernel command line disables
# this), and get Android-style /dev/block/by-name/<PARTNAME> links. The one
# exception is the installed system's data partition (userdata holding the
# pico4-data file system), which stage 1 made writable and mounted: set
# read-only under the mounted file system, its writeback fails and data is lost.
# udev runs this for every device event: the common path stays builtin-only.
set -u

block_policy() {
	local name=$1 partname
	case "$name" in loop* | ram* | zram* | dm-* | nbd*) return 0 ;; esac
	[ -e "/sys/class/block/$name" ] || return 0
	. /usr/libexec/pico4-poc/lib.sh
	partname=$(sed -n 's/^PARTNAME=//p' "/sys/class/block/$name/uevent" 2>/dev/null)
	if [ "$(poc_arg rw 0)" != 1 ] && ! installed_data "$name" "$partname" && ! installed_data_disk "$name"; then
		blockdev --setro "/dev/$name" 2>/dev/null || log "could not set /dev/$name read-only"
	fi
	if [ -n "$partname" ]; then
		mkdir -p /dev/block/by-name
		ln -sfn "../../$name" "/dev/block/by-name/$partname"
		[ -e /dev/block/bootdevice ] || ln -s . /dev/block/bootdevice
	fi
}

# installed_data NAME PARTNAME: true for the installed system's data partition.
installed_data() {
	[ "$2" = userdata ] && [ "$(poc_arg root '')" = installed ] &&
		[ "$(ext_label "/dev/$1" 2>/dev/null)" = pico4-data ]
}

# installed_data_disk NAME: true for the disk of the installed system's data partition when stage 1
# left it writable: the kernel counts a disk's read-only flag for its partitions too.
installed_data_disk() {
	local part
	[ "$(poc_arg root '')" = installed ] && [ "$(cat "/sys/class/block/$1/ro" 2>/dev/null)" = 0 ] || return 1
	for part in "/sys/class/block/$1/$1"*; do
		[ -e "$part/partition" ] || continue
		installed_data "${part##*/}" "$(sed -n 's/^PARTNAME=//p' "$part/uevent" 2>/dev/null)" && return 0
	done
	return 1
}

# matches NODE TYPE: true if NODE is a TYPE (b/c) node with $MAJOR:$MINOR.
matches() {
	local want
	[ "$2" = b ] && want="block special file" || want="character special file"
	[ "$(stat -c '%F %t:%T' "$1" 2>/dev/null)" = "$want $(printf '%x:%x' "$MAJOR" "$MINOR")" ]
}

case "${1:-}" in
add)
	[ -n "${DEVNAME:-}" ] && [ -n "${MAJOR:-}" ] && [ -n "${MINOR:-}" ] || exit 0
	node=/dev/${DEVNAME#/dev/}
	type=c
	[ "${SUBSYSTEM:-}" = block ] && type=b
	if ! matches "$node" "$type"; then
		rm -f "$node"
		mkdir -p "${node%/*}"
		# Same default as devtmpfs: the driver's mode, else root-only.
		mknod -m "${DEVMODE:-0600}" "$node" "$type" "$MAJOR" "$MINOR" || exit 0
	fi
	if [ "$type" = b ] && [ "${ACTION:-add}" != change ]; then
		block_policy "${node#/dev/}"
	fi
	;;
remove)
	[ -n "${DEVNAME:-}" ] && [ -n "${MAJOR:-}" ] || exit 0
	node=/dev/${DEVNAME#/dev/}
	type=c
	[ "${SUBSYSTEM:-}" = block ] && type=b
	matches "$node" "$type" && rm -f "$node"
	if [ "$type" = b ]; then
		for l in /dev/block/by-name/*; do
			[ "$(readlink "$l")" = "../../${node#/dev/}" ] && rm -f "$l"
		done
	fi
	;;
sweep)
	for d in /sys/class/block/*; do
		[ -e "$d" ] && block_policy "${d##*/}"
	done
	;;
esac
exit 0
