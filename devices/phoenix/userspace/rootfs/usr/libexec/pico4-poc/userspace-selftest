#!/bin/bash
# See pico4-userspace-selftest.service. The QEMU harness reads the result
# line and the JSON from the console log.
. /usr/libexec/pico4-poc/lib.sh
result=$(pico4-userspace-check --wait 120 --no-vulkan)
rc=$?
# The service's stdout is the console: no kernel-log record length limit there.
echo "pico4-userspace-check: $result"
{ ip -o link; ip -o addr; networkctl list --no-pager --no-legend; } 2>&1 | sed 's/^/pico4-net: /'
journalctl -b --no-pager -p warning -o short-monotonic 2>/dev/null | tail -n 80 |
	while IFS= read -r line; do echo "pico4-journal: $line" > /dev/kmsg; done
if [ $rc = 0 ]; then
	log "PICO4-USERSPACE-SELFTEST: PASS"
else
	log "PICO4-USERSPACE-SELFTEST: FAIL"
fi
systemctl --no-block poweroff
