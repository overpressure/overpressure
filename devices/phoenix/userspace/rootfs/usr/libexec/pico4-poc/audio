#!/bin/bash
# Audio bring-up as PICO OS does it (docs/userspace.md#audio).
#
#   audio modules   load PICO OS's audio modules (early-init there). This has to happen before the
#                   protection-domain mapper starts: the audio notifier only registers its clients
#                   when the kernel's service locator answers, and the locator answers at once
#                   while the mapper runs, before the notifier module has subscribed.
#   audio boot      boot the audio DSP (early-boot there) at restart level RELATED: at the kernel's
#                   default, SYSTEM, a DSP crash would reboot the headset.
#
# The modules are the stock signed ones, loaded by path in the order PICO OS's modprobe gives
# them: PICO OS's list, each module after the modules it depends on (modules.dep). Modules are
# never unloaded.
set -euo pipefail

DIR=/usr/lib/pico4-audio
# PICO OS's list (vendor init.target.rc); modprobe adds the dependencies.
LIST="audio_q6_pdr audio_q6_notifier audio_snd_event audio_apr audio_adsp_loader audio_q6
audio_native audio_usf audio_pinctrl_wcd audio_pinctrl_lpi audio_swr audio_platform audio_hdmi
audio_stub audio_wcd_core audio_wsa881x audio_bolero_cdc audio_wsa_macro audio_va_macro
audio_rx_macro audio_tx_macro audio_wcd938x audio_wcd938x_slave audio_machine_kona"

declare -A seen

# The modules $1 depends on, as modules.dep lists them (by the vendor partition's paths).
deps() {
	sed -n "s|^/vendor/lib/modules/$1\.ko:||p" "$DIR/modules.dep" | tr ' ' '\n' |
		sed -n 's|.*/\(.*\)\.ko$|\1|p'
}

load() {
	local m=$1 d
	[ -z "${seen[$m]:-}" ] || return 0
	seen[$m]=1
	# modules.dep lists the deepest dependency last.
	for d in $(deps "$m" | tac); do
		load "$d"
	done
	# A module loaded before (the unit ran already) answers "File exists".
	local out
	out=$(insmod "$DIR/$m.ko" 2>&1) || case "$out" in
		*"File exists"*) ;;
		*) echo "audio: cannot load $m: $out" >&2; return 1 ;;
	esac
}

subsystem() {
	local d
	for d in /sys/bus/msm_subsys/devices/*; do
		[ "$(cat "$d/name" 2>/dev/null)" = adsp ] && { echo "$d"; return 0; }
	done
	return 1
}

case "${1:-}" in
modules)
	for m in $LIST; do
		load "$m"
	done
	;;
boot)
	d=$(subsystem) || { echo "audio: no ADSP subsystem" >&2; exit 1; }
	echo RELATED > "$d/restart_level"
	[ "$(cat "$d/state")" = ONLINE ] && exit 0
	echo 1 > /sys/kernel/boot_adsp/boot
	for _ in $(seq 1 30); do
		[ "$(cat "$d/state")" = ONLINE ] && exit 0
		sleep 1
	done
	echo "audio: ADSP not online (state $(cat "$d/state"))" >&2
	exit 1
	;;
*)
	echo "usage: $0 modules|boot" >&2
	exit 2
	;;
esac
