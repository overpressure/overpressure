#!/bin/sh
# PICO OS's persist partition, read-only at /mnt/vendor/persist, where PICO OS mounts it
# (docs/userspace.md#the-headsets-own-data): the headset's factory data that the image links to
# instead of shipping it: the sensor registry with its calibration, the camera, IMU and lens
# calibration (pvr/), the serial number the fan's batch comes from and the Wi-Fi MAC addresses.
# noload: an ext4 journal is never replayed, nothing is written; the block device stays
# read-only (the storage policy, pico4-storage-ro.service).
set -eu
dir=/mnt/vendor/persist
mountpoint -q "$dir" && exit 0
dev=$(readlink -f /dev/block/by-name/persist 2>/dev/null || true)
[ -n "$dev" ] && [ -b "$dev" ] || { echo "persist: no partition named persist" >&2; exit 1; }
blockdev --setro "$dev"
mount -t ext4 -o ro,noload,nodev,nosuid,noexec "$dev" "$dir"
echo "persist: $dev read-only at $dir"
# The controllers' gyro bias tables (pvr/<serial>.txt) are root's alone on persist; SteamVR's
# driver runs as the session's user and reads a copy.
mkdir -p /run/pico4-controllers
for table in "$dir"/pvr/?????????????????.txt; do
	[ -f "$table" ] && install -m 644 "$table" /run/pico4-controllers/
done
