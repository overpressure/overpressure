#!/bin/sh
# wlan0's address from persist's wlan_mac.bin (Intf0MacAddress=...), the one PICO assigned to the
# headset: the stock driver reads the file itself, ath11k takes the chip's own. The interface is
# down until NetworkManager takes it, which keeps the address ("preserve").
#   wlan-address [MAC_FILE [INTERFACE]]
set -eu
file=${1:-/mnt/vendor/persist/wlan_mac.bin}
dev=${2:-wlan0}
hex=$(sed -n 's/^Intf0MacAddress=\([0-9A-Fa-f]\{12\}\).*/\1/p' "$file" | head -n 1)
[ -n "$hex" ] || { echo "wlan-address: no Intf0MacAddress in $file" >&2; exit 1; }
mac=$(echo "$hex" | sed 's/\(..\)/\1:/g; s/:$//' | tr 'A-F' 'a-f')
ip link set dev "$dev" down
ip link set dev "$dev" address "$mac"
echo "wlan-address: $dev has persist's address"
