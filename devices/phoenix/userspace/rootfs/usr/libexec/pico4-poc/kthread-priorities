#!/bin/bash
# Real-time priority for the kernel threads between the compositor and the panels
# (docs/session.md). SteamVR's compositor and render threads run at SCHED_RR 99; on the
# stock 4.19 kernel the GPU dispatcher (kgsl_worker_thr) runs at SCHED_FIFO 12 and the
# display's commit and event threads (crtc_commit:N, crtc_event:N) at SCHED_FIFO 61, so
# a compositor thread on the same CPU delays its own submissions and flips. They get
# SCHED_RR 99, round-robin with the compositor. The station's SPI thread (spi0) already
# runs at SCHED_FIFO 99; the GPU's workqueues (kgsl-events, kgsl-workqueue) run at
# nice -20 and take no real-time policy.
set -euo pipefail
prio=${PICO4_KTHREAD_PRIO:-99}
found=0
while read -r pid comm; do
	case "$comm" in
	kgsl_worker_thr | crtc_commit:* | crtc_event:*)
		chrt -r -p "$prio" "$pid"
		echo "$comm ($pid): SCHED_RR $prio"
		found=$((found + 1))
		;;
	esac
done < <(ps --ppid 2 -o pid=,comm=)
[[ $found -gt 0 ]] || { echo "no GPU or display kernel threads found" >&2; exit 1; }
