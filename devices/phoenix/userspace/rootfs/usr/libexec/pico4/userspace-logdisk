#!/bin/bash
# SPDX-License-Identifier: Unlicense
# Stage-2 version of the stage-1 log drive (initramfs .../logdisk): rewrite the
# read-only USB mass-storage medium with this boot's journal, unit and network
# state. It reaches the PC even when the USB network does not.
. /usr/libexec/pico4/lib.sh
set -u
IMG=$P4_RUN/logdisk.img
LUN=/sys/kernel/config/usb_gadget/pico4/functions/mass_storage.0/lun.0
export MTOOLS_SKIP_CHECK=1
[ -e "$LUN/file" ] || exit 0

tmp=$(mktemp -d)
trap 'rm -rf "$tmp" "$IMG.new"' EXIT
{
	echo "PICO 4 SteamOS-compatible userspace (stage 2) - log drive, refreshed every 2 minutes"
	echo "boot.log: stage 1 + handoff; journal.txt: this boot; state.txt: units and network"
} | sed 's/$/\r/' > "$tmp/README.txt"
cp "$P4_LOG" "$tmp/boot.log" 2>/dev/null
journalctl -b --no-pager -o short-monotonic > "$tmp/journal.txt" 2>&1
dmesg > "$tmp/dmesg.txt" 2>&1
{
	echo "== systemctl is-system-running: $(systemctl is-system-running 2>&1)"
	systemctl list-units --failed --no-pager --plain
	systemctl list-jobs --no-pager
	echo "== links"; ip -d link
	echo "== addresses"; ip addr
	echo "== routes"; ip route
	echo "== networkctl"; networkctl list --no-pager
	echo "== usb-link.env"; cat /etc/pico4/usb-link.env
	echo "== sshd"; systemctl status sshd --no-pager -l
	echo "== udc"; cat "$LUN/../../../UDC" /sys/class/udc/*/state 2>&1
} > "$tmp/state.txt" 2>&1
pico4-userspace-check --wait 1 --no-vulkan > "$tmp/check.json" 2>&1
cp /etc/pico4/build-info "$tmp/build-info.json" 2>/dev/null

dd if=/dev/zero of="$IMG.new" bs=1M count="$(stage1_arg logdisk_mb 32)" status=none &&
	mformat -i "$IMG.new" -v PICO4LOGS :: >/dev/null &&
	mcopy -s -i "$IMG.new" "$tmp"/* :: >/dev/null || { log "userspace logdisk: could not build the image"; exit 1; }
mv -f "$IMG.new" "$IMG"
# The PC may hold the medium: eject it first (it sees a media change).
if ! echo "$IMG" > "$LUN/file" 2>/dev/null; then
	echo 1 > "$LUN/forced_eject" 2>/dev/null
	echo "$IMG" > "$LUN/file" 2>/dev/null || { log "userspace logdisk: medium busy"; exit 1; }
fi
