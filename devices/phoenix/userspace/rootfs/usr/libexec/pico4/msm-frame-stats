# SPDX-License-Identifier: Unlicense
"""The panels' frame statistics on msm, from its own events (docs/session.md).

The compositor
drives the display itself, and the kernel's tracepoints tell the same: the flips the display
completed (dpu_crtc_complete_flip), the vblanks (drm_vblank_event) and the GPU jobs of the
presenting process's threads (msm_gpu_submit_retired names the submitting thread, with the GPU's
own time per job). The statistics (commits, commit_hz, late, stalls, max_interval_ms, vblank_hz)
are what session-performance judges, with the GPU time per job (gpu_ms).

  msm-frame-stats record SECONDS PID OUT.json   root: records SECONDS of tracefs events
  msm-frame-stats parse TRACE TID...            the statistics of a recorded trace
"""

from __future__ import annotations

import json
import re
import statistics
import sys
import time
from pathlib import Path
from typing import TYPE_CHECKING, Any

if TYPE_CHECKING:
    from collections.abc import Iterable, Sequence

TRACING = Path("/sys/kernel/tracing")
EVENTS = ("dpu/dpu_crtc_complete_flip", "drm/drm_vblank_event", "drm_msm_gpu/msm_gpu_submit_retired")
LINE = re.compile(r"\s*.+?-\d+\s+\[\d+\]\s+\S+\s+([\d.]+): (\w+): ?(.*)")
LATE_REFRESHES = 1.5  # a commit more than 1.5 refreshes after the one before
STALL_S = 0.100  # a gap above 100 ms
HELPERS = {"steamwebhelper", "vrwebhelper"}
RECORD_ARGC = 5  # msm-frame-stats record SECONDS PID OUT.json
PARSE_MIN_ARGC = 4  # msm-frame-stats parse TRACE TID...


def job_margins(job_ends: Iterable[float], vblanks: Iterable[float], refresh: float) -> dict[str, float]:
    """Measure how long before each vblank the compositor's last job of that refresh ended, in ms.

    A vblank within the jobs' span with no job in its refresh counts as 0: its frame had no margin.
    """
    ends = sorted(job_ends)
    margins = []
    i = 0
    for v in sorted(vblanks):
        if not ends or v <= ends[0] or v > ends[-1] + refresh:
            continue
        while i + 1 < len(ends) and ends[i + 1] < v:
            i += 1
        margin = v - ends[i]
        margins.append(margin * 1e3 if 0 < margin <= refresh else 0.0)
    if not margins:
        return {}
    margins.sort()
    # p99: 99 % of the frames had at least this margin.
    return {
        "p50": round(margins[len(margins) // 2], 3),
        "p99": round(margins[len(margins) // 100], 3),
        "frames": len(margins),
        "without_a_job": sum(m == 0.0 for m in margins),
    }


def events(
    lines: Iterable[str], tids: set[int], helper_tids: set[int]
) -> tuple[dict[str, list[float]], list[float], list[float], list[float], int]:
    """Sort trace lines into flips per CRTC, vblanks, the threads' GPU times (ms) and ends, the helpers' GPU ns."""
    flips: dict[str, list[float]] = {}
    vblanks: list[float] = []
    gpu: list[float] = []
    ends: list[float] = []
    helper_ns = 0
    for line in lines:
        m = LINE.match(line)
        if not m:
            continue
        t, event, fields = float(m.group(1)), m.group(2), m.group(3)
        if event == "dpu_crtc_complete_flip":
            flips.setdefault(fields, []).append(t)
        elif event == "drm_vblank_event":
            vblanks.append(t)
        elif event == "msm_gpu_submit_retired":
            f = dict(re.findall(r"(\w+)=(-?\d+)", fields))
            pid = int(f.get("pid", -1))
            if pid in tids:
                gpu.append(int(f["elapsed"]) / 1e6)
                ends.append(t)
            elif pid in helper_tids:
                helper_ns += int(f["elapsed"])
    return flips, vblanks, gpu, ends, helper_ns


def parse(lines: Iterable[str], tids: Iterable[int | str], helper_tids: Iterable[int | str] = ()) -> dict[str, Any]:
    """Compute the statistics of trace lines.

    They cover the flips of the busiest CRTC, the vblanks, the threads' GPU jobs, and the web helpers'
    share of the GPU, which on a table can be idle when worn it would not be.
    """
    flips, vblanks, gpu, ends, helper_ns = events(lines, {int(t) for t in tids}, {int(t) for t in helper_tids})
    stats: dict[str, Any] = {
        "target": "msm",
        "commits": 0,
        "commit_hz": 0.0,
        "late": 0,
        "stalls": 0,
        "max_interval_ms": 0.0,
        "vblank_hz": 0.0,
        "gpu_jobs": len(gpu),
    }
    if len(vblanks) > 1:
        stats["vblank_hz"] = round((len(vblanks) - 1) / (vblanks[-1] - vblanks[0]), 3)
    refresh = 1 / stats["vblank_hz"] if stats["vblank_hz"] else 1 / 90
    times = max(flips.values(), key=len) if flips else []
    stats["commits"] = len(times)
    if len(times) > 1:
        intervals = [b - a for a, b in zip(times, times[1:])]
        stats["commit_hz"] = round((len(times) - 1) / (times[-1] - times[0]), 3)
        stats["late"] = sum(i > LATE_REFRESHES * refresh for i in intervals)
        stats["stalls"] = sum(i > STALL_S for i in intervals)
        stats["max_interval_ms"] = round(max(intervals) * 1e3, 3)
    if gpu:
        gpu.sort()
        stats["gpu_ms"] = {
            "mean": round(statistics.fmean(gpu), 3),
            "p90": round(gpu[len(gpu) * 9 // 10], 3),
            "max": round(gpu[-1], 3),
        }
    margins = job_margins(ends, vblanks, refresh)
    if margins:
        stats["job_margin_ms"] = margins
    if len(vblanks) > 1:
        stats["web_helper_gpu_percent"] = round(helper_ns / ((vblanks[-1] - vblanks[0]) * 1e9) * 100, 2)
    return stats


def write(path: Path, text: str) -> None:
    """Write a tracefs file."""
    path.write_text(text)


def threads(pid: int) -> set[int]:
    """Return the process's thread ids, none once it is gone."""
    try:
        return {int(t.name) for t in Path(f"/proc/{pid}/task").iterdir()}
    except OSError:
        return set()


def command_name(proc: Path) -> str:
    """Return a process's command name, empty once it is gone."""
    try:
        return (proc / "comm").read_text().strip()
    except OSError:
        return ""


def helpers() -> set[int]:
    """Return the threads of the web helpers, the Steam client's and SteamVR's, which draw the panels."""
    tids: set[int] = set()
    for proc in Path("/proc").glob("[0-9]*"):
        if command_name(proc) in HELPERS:
            tids |= threads(int(proc.name))
    return tids


def record(seconds: float, pid: int) -> dict[str, Any]:
    """Record SECONDS of the events with tracefs and parse them."""
    tids = threads(pid)
    write(TRACING / "tracing_on", "0")
    write(TRACING / "trace", "")
    write(TRACING / "buffer_size_kb", "8192")
    for event in EVENTS:
        write(TRACING / "events" / event / "enable", "1")
    try:
        write(TRACING / "tracing_on", "1")
        time.sleep(seconds)
        write(TRACING / "tracing_on", "0")
        trace = (TRACING / "trace").read_text(errors="replace").splitlines()
        tids |= threads(pid)
        helper_tids = helpers()
    finally:
        for event in EVENTS:
            write(TRACING / "events" / event / "enable", "0")
        write(TRACING / "trace", "")
        write(TRACING / "buffer_size_kb", "1408")
    return parse(trace, tids, helper_tids)


def main(argv: Sequence[str]) -> int:
    """Run the record or the parse command."""
    if len(argv) == RECORD_ARGC and argv[1] == "record":
        stats = record(float(argv[2]), int(argv[3]))
        Path(argv[4]).write_text(json.dumps(stats) + "\n")
        print(json.dumps(stats))
        return 0
    if len(argv) >= PARSE_MIN_ARGC and argv[1] == "parse":
        print(json.dumps(parse(Path(argv[2]).read_text(errors="replace").splitlines(), argv[3:])))
        return 0
    print("usage: msm-frame-stats record SECONDS PID OUT.json | parse TRACE TID...", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
