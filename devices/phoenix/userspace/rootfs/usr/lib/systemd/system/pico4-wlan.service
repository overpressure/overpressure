# Wi-Fi: the QCA6390 and its stock driver, brought up as on PICO OS (docs/userspace.md#wi-fi).
# The module waits for the chip's cold-boot calibration, about 30 s; NetworkManager takes wlan0
# when it appears.
[Unit]
Description=Wi-Fi (QCA6390)
Requires=pico4-wlfw-client.service
After=pico4-wlfw-client.service
ConditionPathExists=/usr/lib/pico4-wlan/qca_cld3_qca6390.ko
# The stock kernel only (KGSL): a mainline kernel drives the QCA6390 with ath11k.
ConditionPathExists=/sys/class/kgsl

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4-poc/wlan start
ExecStop=/usr/libexec/pico4-poc/wlan stop
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
