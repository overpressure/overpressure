# The PICO 4's counterpart of the Frame's steamvr-set-kernel-thread-priorities.service
# (masked: its thread names are the Frame kernel's). No CPUWeight/CPUQuota: the cpu
# controller stays off for SCHED_FIFO in Monado's compositor.
[Unit]
Description=Real-time priority for the PICO 4's GPU and display kernel threads
ConditionPathExists=/sys/class/kgsl/kgsl-3d0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4-poc/kthread-priorities

[Install]
WantedBy=multi-user.target
