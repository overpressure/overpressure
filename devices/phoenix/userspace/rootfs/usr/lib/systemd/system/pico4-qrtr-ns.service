[Unit]
Description=QRTR name service (the stock 4.19 kernel has no in-kernel one)
ConditionPathExists=/usr/lib/firmware/slpi.mdt
ConditionPathExists=/sys/kernel/boot_slpi
Before=pico4-slpi.service

[Service]
ExecStart=/usr/bin/qrtr-ns -f
Restart=on-failure
RestartSec=1

[Install]
WantedBy=pico4-sensors.target
