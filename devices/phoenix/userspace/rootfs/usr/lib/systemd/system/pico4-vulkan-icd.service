# The Vulkan driver by the kernel: the loader's ICD file links to /run/pico4-poc/vulkan-icd.json,
# which this unit points at the KGSL build on the stock kernel and at Valve's Turnip on a mainline
# kernel (docs/userspace.md#turnip-needs-its-kgsl-backend).
[Unit]
Description=Vulkan driver for this kernel
DefaultDependencies=no
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /run/pico4-poc; if [ -e /sys/class/kgsl ]; then d=kgsl; else d=valve; fi; ln -sfn /usr/share/pico4/vulkan/turnip-$d.json /run/pico4-poc/vulkan-icd.json'

[Install]
WantedBy=sysinit.target
