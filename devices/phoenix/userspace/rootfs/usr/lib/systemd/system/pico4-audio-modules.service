# PICO OS's audio modules, before the protection-domain mapper starts: the audio notifier only
# sees the service locator come up if it is loaded first (docs/userspace.md#audio).
[Unit]
Description=Audio modules (ADSP, sound card)
DefaultDependencies=no
After=local-fs.target
Before=pico4-pd-mapper.service
ConditionPathExists=/usr/lib/pico4-audio/audio_machine_kona.ko
# Stock kernel modules: the stock kernel only (KGSL).
ConditionPathExists=/sys/class/kgsl

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4-poc/audio modules

[Install]
WantedBy=pico4-audio.target
