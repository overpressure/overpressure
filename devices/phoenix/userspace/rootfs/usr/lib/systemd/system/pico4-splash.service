# A sign of life in the lenses while the installed system starts (docs/install.md): stage 1's
# pico4-splash ends with the switch to this system, this one carries on until a compositor
# takes the display (it exits by itself): SteamVR's, when Valve's session starts.
[Unit]
Description=Boot indication in the lenses
DefaultDependencies=no
ConditionKernelCommandLine=pico4.root=installed
# msm's panels have
# their mode once pico4-panel-probe has run.
After=pico4-storage-ro.service pico4-panel-probe.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
ExecStart=/usr/bin/pico4-splash 240

[Install]
WantedBy=sysinit.target
