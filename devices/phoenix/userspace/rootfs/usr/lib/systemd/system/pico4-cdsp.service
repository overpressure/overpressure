# The Compute DSP, for PICO OS's head tracker (docs/xr.md#head-tracking).
[Unit]
Description=Boot the Compute DSP (CDSP)
ConditionPathExists=/usr/lib/firmware/cdsp.mdt
# The stock kernel's subsystem interface, or a mainline kernel's remoteproc.
ConditionPathExists=|/sys/kernel/boot_cdsp
ConditionPathExists=|/sys/class/remoteproc
After=systemd-udev-trigger.service pico4-pd-mapper.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4-poc/cdsp-boot
