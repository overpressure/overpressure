# PICO OS's CPU limits for VR (docs/cooling.md#vr-cpu-limits): held while
# Valve's session or Monado runs, which both want this unit; it stops once
# neither does. No CPUWeight/CPUQuota (CLAUDE.md).
[Unit]
Description=PICO OS's VR CPU frequency limits
StopWhenUnneeded=yes
# The stock kernel's msm_performance, or a mainline kernel's cpufreq policies.
ConditionPathExists=|/sys/module/msm_performance/parameters/cpu_max_freq
ConditionPathExists=|/sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4-poc/vr-performance on
ExecStop=/usr/libexec/pico4-poc/vr-performance off
