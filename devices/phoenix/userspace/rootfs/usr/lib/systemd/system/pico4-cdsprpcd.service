# The Compute DSP's root listener from PICO OS's vendor partition, in the tracker's root: without
# it the DSP's loader stalls on the tracker's first module (docs/xr.md#head-tracking).
[Unit]
Description=Compute DSP root listener (cdsprpcd)
ConditionPathExists=/usr/lib/pico4-stock-slam/vendor/bin/cdsprpcd
# PICO OS's FastRPC needs the stock kernel's ION and adsprpc nodes; on a mainline kernel the
# tracker waits for upstream FastRPC (docs/kernel-feasibility.md) and skips itself.
ConditionPathExists=/sys/class/kgsl
Requires=pico4-cdsp.service
After=pico4-cdsp.service

[Service]
ExecStart=/usr/libexec/pico4-poc/stock-slam --vendor /vendor/bin/cdsprpcd
Restart=on-failure
RestartSec=2
