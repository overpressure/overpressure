[Unit]
Description=Boot the audio DSP (ADSP)
ConditionPathExists=/usr/lib/firmware/adsp.mdt
# The stock kernel's subsystem interface, or a mainline kernel's remoteproc. The modules unit
# skips itself on mainline.
ConditionPathExists=|/sys/kernel/boot_adsp
ConditionPathExists=|/sys/class/remoteproc
Requires=pico4-audio-modules.service pico4-qrtr-ns.service
Wants=pico4-pd-mapper.service
After=pico4-audio-modules.service pico4-qrtr-ns.service pico4-pd-mapper.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4-poc/audio boot

[Install]
WantedBy=pico4-audio.target
