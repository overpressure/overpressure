# The stock kernel has no System V IPC: pico4-sysvsem, preloaded into every process, provides
# semaphores and message queues (docs/session.md#system-v-semaphores-and-message-queues).
# /etc/ld.so.preload links to /run/pico4-poc/ld.so.preload, which this unit writes on the stock
# kernel only (KGSL): a mainline kernel has System V IPC, and there the link points nowhere, which
# glibc takes for no preload.
[Unit]
Description=System V IPC library preloaded on the stock kernel
DefaultDependencies=no
ConditionPathExists=/sys/class/kgsl
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'mkdir -p /run/pico4-poc && echo /usr/lib/libpico4-sysvsem.so > /run/pico4-poc/ld.so.preload'

[Install]
WantedBy=sysinit.target
