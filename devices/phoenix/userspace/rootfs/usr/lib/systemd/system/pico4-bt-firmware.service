# PICO OS's bluetooth partition read-only at /mnt/vendor/bt_firmware: the QCA6390's Bluetooth
# firmware, which the image links to (docs/userspace.md). Before local-fs.target, as persist.
[Unit]
Description=PICO 4 Bluetooth firmware partition (read-only)
DefaultDependencies=no
After=pico4-storage-ro.service
Before=local-fs.target
ConditionPathExists=/dev/block/by-name/bluetooth

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4/bt-firmware

[Install]
WantedBy=local-fs.target
