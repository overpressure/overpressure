[Unit]
Description=FastRPC file server for the SLPI sensors process (sensor registry and config)
ConditionPathExists=/usr/share/qcom/pico4/sensors/config
# The stock kernel's subsystem interface, or a mainline kernel's remoteproc.
ConditionPathExists=|/sys/kernel/boot_slpi
ConditionPathExists=|/sys/class/remoteproc
Requires=pico4-slpi.service
# A mainline kernel's SoC values come from debugfs.
After=pico4-slpi.service pico4-pd-mapper.service sys-kernel-debug.mount

[Service]
# The FastRPC node and the root for the kernel that runs (the script says why).
ExecStart=/usr/libexec/pico4-poc/sensorspd
# When the SLPI restarts (subsystem restart, level RELATED) hexagonrpcd loses its FastRPC
# channel and exits successfully; the restarted sensors process needs it again, and the
# head IMU only comes back once it runs (docs/xr.md).
Restart=always
RestartSec=2

[Install]
WantedBy=pico4-sensors.target
