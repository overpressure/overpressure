[Unit]
Description=PICO 4 stage-2 log drive (journal and state on the USB mass-storage function)
# No ordering after multi-user.target: it must also report a boot that hangs.
DefaultDependencies=no
After=systemd-journald.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/pico4-poc/userspace-logdisk
