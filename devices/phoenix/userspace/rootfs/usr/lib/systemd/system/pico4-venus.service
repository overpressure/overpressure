# The video codec's restart level, early, before any process can open its nodes and so boot it
# (docs/session.md#steam-link).
[Unit]
Description=Video codec (Venus) restart level
DefaultDependencies=no
ConditionPathExists=/usr/lib/firmware/venus.mdt
# The stock kernel's subsystem restart levels only (KGSL).
ConditionPathExists=/sys/class/kgsl
After=systemd-modules-load.service
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4-poc/venus-level

[Install]
WantedBy=sysinit.target
