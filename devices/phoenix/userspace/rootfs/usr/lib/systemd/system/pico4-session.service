# The session of the Frame's user, steamos, without a display manager
# (docs/session.md): a logind session through PAM, whose user manager runs Valve's
# session target, gamescope-session.target unless /etc/pico4-poc/session.conf
# (PICO4_SESSION_TARGET) names another.
[Unit]
Description=PICO 4 user session (steamos)
# Valve's session needs the GPU, KGSL on the stock kernel or msm's render node on a mainline
# kernel: none in QEMU.
ConditionPathExists=|/dev/kgsl-3d0
ConditionPathExists=|/dev/dri/renderD128
# After the head IMU is listed: SteamVR's driver_monado probes it when SteamVR starts.
After=systemd-user-sessions.service systemd-logind.service pico4-sensors.target
# PICO OS's head tracker for SteamVR's driver_monado (docs/xr.md#head-tracking).
Wants=pico4-slamd.service
# PICO OS's CPU limits for VR while the session runs (docs/cooling.md#vr-cpu-limits).
Wants=pico4-vr-performance.service
After=pico4-vr-performance.service
# On a kernel with virtual terminals (a mainline kernel) the session takes VT 1 in getty's place,
# as sddm does on the Frame; the stock kernel has none.
Conflicts=getty@tty1.service
After=getty@tty1.service
# A session that ends by itself starts again, as sddm's Relogin=true does on the Frame: a
# SteamVR that ends without a stop being asked for ends it (steamvr-ended), as does a SteamVR
# that failed for good (pico4-steamvr-failed.service). After five starts in ten minutes the
# session stays stopped until the next boot or a deliberate start, which resets the count: a
# crash loop ends after about five controller radio resets.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=steamos
PAMName=pico4-session
EnvironmentFile=-/etc/pico4-poc/session.conf
# logind gives seat0's sessions a VT where the kernel has them (VT numbers 1-63) and refuses a VT
# number where it has none: pam_systemd takes it from the environment, which this file holds
# when the session starts.
ExecStartPre=+/bin/sh -c 'mkdir -p /run/pico4-poc; if [ -e /dev/tty0 ]; then echo XDG_VTNR=1; fi > /run/pico4-poc/session-vt.env'
EnvironmentFile=-/run/pico4-poc/session-vt.env
ExecStart=/usr/libexec/pico4-poc/session
Restart=always
RestartSec=5
# Restarts do not pass through the failed state.
RestartMode=direct
KillMode=mixed
# Valve's units stop one after another: gamescope gets 10 s, SteamVR 20 s. The default 15 s
# (system.conf.d) killed stops in which gamescope ignored SIGTERM.
TimeoutStopSec=45

[Install]
WantedBy=graphical.target
