[Unit]
Description=Protection-domain mapper (QMI service locator for the DSPs)
ConditionPathExists=/usr/lib/firmware/slpi.mdt
ConditionPathExists=/sys/kernel/boot_slpi
Requires=pico4-qrtr-ns.service
After=pico4-qrtr-ns.service

[Service]
ExecStart=/usr/bin/pd-mapper /usr/lib/firmware
Restart=on-failure
RestartSec=1

[Install]
WantedBy=pico4-sensors.target
