[Unit]
Description=PICO 4 head IMU through the Qualcomm Sensor Core
ConditionPathExists=/usr/lib/firmware/slpi.mdt
# The stock kernel's subsystem interface, or a mainline kernel's remoteproc.
ConditionPathExists=|/sys/kernel/boot_slpi
ConditionPathExists=|/sys/class/remoteproc
Wants=pico4-qrtr-ns.service pico4-slpi.service pico4-pd-mapper.service pico4-sensorspd.service
Wants=pico4-imu-ready.service
# Reached once the IMU is listed: units after the target can probe it.
After=pico4-imu-ready.service

[Install]
WantedBy=multi-user.target
