[Unit]
Description=Boot the sensor DSP (SLPI)
ConditionPathExists=/usr/lib/firmware/slpi.mdt
ConditionPathExists=/sys/kernel/boot_slpi
Requires=pico4-qrtr-ns.service
After=pico4-qrtr-ns.service systemd-udev-trigger.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pico4-poc/slpi-boot

[Install]
WantedBy=pico4-sensors.target
