# NetworkManager's Wi-Fi backend on the stock kernel: wpa_supplicant over the Frame's iwd, which
# needs crypto sockets the stock kernel lacks (99-zz-pico4-wifi-backend.conf).
[Unit]
Description=Wi-Fi backend for the stock kernel
DefaultDependencies=no
Before=NetworkManager.service
ConditionPathExists=/sys/class/kgsl

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mkdir -p /run/NetworkManager/conf.d
ExecStart=/bin/ln -sfn /usr/share/pico4-poc/99-zz-pico4-wifi-backend.conf /run/NetworkManager/conf.d/99-zz-pico4-wifi-backend.conf

[Install]
WantedBy=NetworkManager.service
