diff --git a/tests/test_downstream.c b/tests/test_downstream.c
new file mode 100755
index 0000000..6369fc3
--- /dev/null
+++ b/tests/test_downstream.c
@@ -0,0 +1,178 @@
+/*
+ * Tests for the downstream (adsprpc) FastRPC ioctl translation
+ *
+ * This file is part of sensh.
+ *
+ * Sensh is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+
+#include <libhexagonrpc/downstream.h>
+
+#define REMOTE_SCALARS_MAKE(method, in, out) \
+	((((uint32_t) (method) & 0x1f) << 24) | (((in) & 0xff) << 16) | (((out) & 0xff) << 8))
+
+/* Byte layout of the msm-4.19 structures on LP64 (aarch64). */
+struct ds_arg { uint64_t pv; uint64_t len; };
+struct ds_invoke { uint32_t handle; uint32_t sc; uint64_t pra; };
+struct ds_invoke_fd { struct ds_invoke inv; uint64_t fds; };
+struct ds_init_attrs {
+	uint32_t flags; uint32_t pad0; uint64_t file; uint32_t filelen;
+	int32_t filefd; uint64_t mem; uint32_t memlen; int32_t memfd;
+	int32_t attrs; uint32_t siglen;
+};
+struct ds_init {
+	uint32_t flags; uint32_t pad0; uint64_t file; uint32_t filelen;
+	int32_t filefd; uint64_t mem; uint32_t memlen; int32_t memfd;
+};
+struct ds_mmap { int32_t fd; uint32_t flags; uint64_t vaddrin; uint64_t size; uint64_t vaddrout; };
+
+static unsigned long calls[8];
+static int n_calls;
+static uint32_t getinfo_domain;
+static struct ds_init_attrs last_init;
+static struct ds_init last_static;
+static char last_static_name[16];
+static struct ds_invoke last_invoke;
+static struct ds_arg last_args[4];
+static int last_fds[4];
+static int used_fds;
+static struct ds_mmap last_mmap;
+
+static long fake_ioctl(int fd, unsigned long req, void *arg)
+{
+	(void) fd;
+	calls[n_calls++] = req;
+
+	if (req == _IOWR('R', 8, uint32_t)) {
+		getinfo_domain = *(uint32_t *) arg;
+		*(uint32_t *) arg = 1;
+	} else if (req == _IOWR('R', 10, struct ds_init_attrs)) {
+		memcpy(&last_init, arg, sizeof(last_init));
+	} else if (req == _IOWR('R', 6, struct ds_init)) {
+		memcpy(&last_static, arg, sizeof(last_static));
+		strncpy(last_static_name, (const char *) (uintptr_t) last_static.file,
+			sizeof(last_static_name) - 1);
+	} else if (req == _IOWR('R', 1, struct ds_invoke)) {
+		memcpy(&last_invoke, arg, sizeof(last_invoke));
+		memcpy(last_args, (void *) (uintptr_t) last_invoke.pra, sizeof(last_args));
+		used_fds = 0;
+	} else if (req == _IOWR('R', 4, struct ds_invoke_fd)) {
+		struct ds_invoke_fd *inv = arg;
+
+		memcpy(&last_invoke, &inv->inv, sizeof(last_invoke));
+		memcpy(last_args, (void *) (uintptr_t) last_invoke.pra, sizeof(last_args));
+		memcpy(last_fds, (void *) (uintptr_t) inv->fds, sizeof(last_fds));
+		used_fds = 1;
+	} else if (req == _IOWR('R', 2, struct ds_mmap)) {
+		memcpy(&last_mmap, arg, sizeof(last_mmap));
+		((struct ds_mmap *) arg)->vaddrout = 0x12345000;
+	} else {
+		return -1;
+	}
+
+	return 0;
+}
+
+int main(void)
+{
+	struct fastrpc_invoke_args args[3];
+	struct fastrpc_req_mmap req;
+	char a[4], b[8], c[16];
+	int ret;
+
+	/* The kernel ABI this translates to: sizes are part of the ioctl numbers. */
+	assert(sizeof(struct ds_invoke) == 16);
+	assert(sizeof(struct ds_init_attrs) == 48);
+	assert(sizeof(struct ds_init) == 40);
+	assert(sizeof(struct ds_mmap) == 32);
+
+	hexagonrpc_downstream_set_ioctl(fake_ioctl);
+
+	assert(hexagonrpc_downstream_domain("adsp") == 0);
+	assert(hexagonrpc_downstream_domain("sdsp") == 2);
+	assert(hexagonrpc_downstream_domain("cdsp") == 3);
+	assert(hexagonrpc_downstream_domain("") == -1);
+	assert(hexagonrpc_downstream_domain(NULL) == -1);
+
+	/* Attach: channel first, then the sensors process. */
+	assert(!hexagonrpc_is_downstream(7));
+	ret = hexagonrpc_downstream_attach(7, 2, true);
+	assert(ret == 0);
+	assert(n_calls == 2);
+	assert(calls[0] == _IOWR('R', 8, uint32_t));
+	assert(calls[1] == _IOWR('R', 10, struct ds_init_attrs));
+	assert(getinfo_domain == 2);
+	assert(last_init.flags == 3);
+	assert(last_init.filefd == -1 && last_init.memfd == -1);
+	assert(hexagonrpc_is_downstream(7));
+	assert(!hexagonrpc_is_downstream(8));
+
+	/* Invoke without descriptors: 24-byte upstream args become 16-byte ones. */
+	memset(args, 0, sizeof(args));
+	args[0].ptr = (uintptr_t) a; args[0].length = sizeof(a); args[0].fd = -1;
+	args[1].ptr = (uintptr_t) b; args[1].length = sizeof(b); args[1].fd = -1;
+	args[2].ptr = (uintptr_t) c; args[2].length = sizeof(c); args[2].fd = -1;
+	n_calls = 0;
+	ret = hexagonrpc_downstream_invoke(7, 3, REMOTE_SCALARS_MAKE(4, 2, 1), args);
+	assert(ret == 0);
+	assert(n_calls == 1 && calls[0] == _IOWR('R', 1, struct ds_invoke));
+	assert(!used_fds);
+	assert(last_invoke.handle == 3);
+	assert(last_invoke.sc == REMOTE_SCALARS_MAKE(4, 2, 1));
+	assert(last_args[0].pv == (uintptr_t) a && last_args[0].len == sizeof(a));
+	assert(last_args[1].pv == (uintptr_t) b && last_args[1].len == sizeof(b));
+	assert(last_args[2].pv == (uintptr_t) c && last_args[2].len == sizeof(c));
+
+	/* A buffer backed by a dma-buf needs the fd-carrying variant. */
+	args[1].fd = 42;
+	n_calls = 0;
+	ret = hexagonrpc_downstream_invoke(7, 3, REMOTE_SCALARS_MAKE(4, 2, 1), args);
+	assert(ret == 0);
+	assert(calls[0] == _IOWR('R', 4, struct ds_invoke_fd));
+	assert(used_fds);
+	assert(last_fds[0] == -1 && last_fds[1] == 42 && last_fds[2] == -1);
+
+	/* mmap keeps the field values and returns the DSP address. */
+	memset(&req, 0, sizeof(req));
+	req.fd = -1;
+	req.flags = 0x1000;
+	req.size = 0x200000;
+	n_calls = 0;
+	ret = hexagonrpc_downstream_mmap(7, &req);
+	assert(ret == 0);
+	assert(calls[0] == _IOWR('R', 2, struct ds_mmap));
+	assert(last_mmap.fd == -1 && last_mmap.flags == 0x1000 && last_mmap.size == 0x200000);
+	assert(req.vaddrout == 0x12345000);
+
+	/* A static process: channel first, then INIT by name with a 2 MiB heap. */
+	n_calls = 0;
+	ret = hexagonrpc_downstream_create_static(11, 0, "audiopd");
+	assert(ret == 0);
+	assert(n_calls == 2);
+	assert(calls[0] == _IOWR('R', 8, uint32_t));
+	assert(calls[1] == _IOWR('R', 6, struct ds_init));
+	assert(getinfo_domain == 0);
+	assert(last_static.flags == 2);
+	assert(!strcmp(last_static_name, "audiopd") && last_static.filelen == 8);
+	assert(last_static.filefd == 0 && last_static.mem == 0 && last_static.memfd == 0);
+	assert(last_static.memlen == 0x200000);
+	assert(hexagonrpc_is_downstream(11));
+
+	/* No invalid domains or names. */
+	assert(hexagonrpc_downstream_attach(9, -1, false) != 0);
+	assert(hexagonrpc_downstream_create_static(9, 0, "") != 0);
+	assert(hexagonrpc_downstream_create_static(9, -1, "audiopd") != 0);
+	assert(!hexagonrpc_is_downstream(9));
+
+	printf("downstream: ok\n");
+	return 0;
+}
