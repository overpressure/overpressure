 	return fd->ops->seek(fd, off, whence);
 }
 
+/* The current offset, or a negative error code. */
+off_t hexagonfs_tell(struct hexagonfs_fd **fds, int fileno)
+{
+	struct hexagonfs_fd *fd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	if (fd->ops->tell == NULL)
+		return -ENOSYS;
+
+	return fd->ops->tell(fd);
+}
