        '28bf078147cc2f3395d3f907d6d900c7976dbd9948a9513f1d7ef32a40b89fee55e243c9302d24eda62dc1f813857fa09ae79e6faf52881e463a163acb437380'
        SKIP)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP
            '10d8cd22e2b76306662763ddb5bce899130774df331030e2bcfd195113c38dc2')

prepare() {
  cd hostap
  local patch
  for patch in "${_patches[@]}"; do
    patch -Np1 < "../$patch"
  done
  # Arch takes this upstream fix of a null pointer dereference as well; it touches
  # driver_nl80211.c, which git needs unmodified, so this project's patch comes last.
  git cherry-pick -n 015f6a5a0cd1c8b0d40441b9fd9e4c8658bc9493
  patch -Np1 < ../sae-wpa-version-2.patch
  cp ../wpa_supplicant_config wpa_supplicant/.config
}

build() {
  make -C hostap/wpa_supplicant BINDIR=/usr/bin LIBDIR=/usr/lib
}

package() {
  cd hostap/wpa_supplicant
  make BINDIR=/usr/bin LIBDIR=/usr/lib DESTDIR="$pkgdir" install
  install -dm755 "$pkgdir/etc/wpa_supplicant"
  install -Dm644 dbus/fi.w1.wpa_supplicant1.service -t "$pkgdir/usr/share/dbus-1/system-services"
  install -Dm644 dbus/dbus-wpa_supplicant.conf "$pkgdir/usr/share/dbus-1/system.d/wpa_supplicant.conf"
  install -Dm644 systemd/*.service -t "$pkgdir/usr/lib/systemd/system"
  install -Dm644 ../README "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
