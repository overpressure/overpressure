# wpa_supplicant for the stock PICO 4 kernel (docs/userspace.md#wi-fi): the image's own 2.11
# (Arch's 2:2.11-3, its build configuration and patches fetched from Arch's packaging at a
# pinned commit) with one change of this project. wpa_supplicant 2.11 asks for WPA version 3
# when it connects with SAE (WPA3) and the kernel numbers nl80211 attributes up to
# NL80211_ATTR_SAE_PASSWORD. The PICO 4's Android 4.19 kernel does, but its cfg80211 accepts
# only WPA versions 1 and 2 in CONNECT, so every WPA3 connect failed with EINVAL before the
# Wi-Fi driver saw it; sae-wpa-version-2.patch asks for version 2. The man pages and
# eapol_test are left out.
pkgname=pico4-wpa-supplicant
pkgver=2.11
pkgrel=1
arch=(aarch64)
url="https://w1.fi/wpa_supplicant/"
license=(BSD-3-Clause)
depends=(glibc libdbus libnl openssl pcsclite readline)
makedepends=(git)
# The build names packages by version without epoch; the dependency is on Arch's 2:2.11.
provides=("wpa_supplicant=2:$pkgver")
conflicts=(wpa_supplicant)
_hostap=d945ddd368085f255e68328f2d3b020ceea359af # tag hostap_2_11
_arch=929dd6c3b1416b2c913da70e27f4c86a8acc6c12 # Arch's wpa_supplicant 2-2.11-3
_archraw="https://gitlab.archlinux.org/archlinux/packaging/packages/wpa_supplicant/-/raw/$_arch"
_patches=(0001-Enable-TLSv1.0-by-default.patch
          0002-Disable-Werror-for-eapol_test.patch
          0003-Allow-legacy-renegotiation-to-fix-PEAP-issues-with-s.patch
          0004-Tweak-D-Bus-systemd-service-activation-configuration.patch
          0005-Add-IgnoreOnIsolate-yes-to-keep-wpa-supplicant-runni.patch
          0006-Add-reload-support-to-the-systemd-unit-files.patch
          0007-nl80211-add-extra-ies-only-if-allowed-by-driver.patch)
source=("hostap::git+https://w1.fi/hostap.git#commit=$_hostap"
        "wpa_supplicant_config::$_archraw/wpa_supplicant_config"
        "${_patches[@]/#/$_archraw/}"
        sae-wpa-version-2.patch)
b2sums=(SKIP
        '9785af24e59e3d48dc3ab055cc6b9e5bbf081e801fbbfa70d532c2ad8f7f4e59c2679385c75aa02f856ec387cd5182640ff91d892aed9846c738da57e05574d9'
        '96b82aaa5315e931424150d47e52f70186e2eea3928a5c97792473b69e8f92463863e8044e073bf940d597a3620f63381bd6996a594c85977785cdce4038f768'
        'bd00e0f6c04db9c2dc274763b97dace4d886fb105b0a605bb15877ee84e4a93a7b95ab9a0242b4937c748c8e7991e3dddb795ac4c2b0e99be0f5e48098041b70'
        'aaa7604faf1fede451582c8b981579cc86724a66c783d8368d1c122e0c381b75842d83bd85a982c1d4461d65bc74e62d34768762d15b4005a24a17e1392a109a'
        '7175e7aab682370aef1b3358eaa839dcb009e12940aa2b9949c8c3254406341433e84af09d09ad670bf41f5201d979af02095c87a368b76465a952b1be9de049'
        '6472d571f18c3ee718315888b9c756c4579a4b411e8c6994002f9a79fb0a36fbebe8b3d419af0f9ea881dd1bc439d03dbe3c6d6661e670f16575197c31f0bd7a'
