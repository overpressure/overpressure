# System V semaphores and message queues for the stock PICO 4 kernel, which
# has no CONFIG_SYSVIPC (docs/session.md). SteamVR takes its named locks with
# semget/semop/semctl and refuses to start without them; gamescope sends
# MangoHud's mangoapp its frame timings through a message queue. A preloaded
# library (/etc/ld.so.preload, from the userspace overlay) implements them on
# shared memory; it is inert until a program calls them. The tests run here
# because build-userspace.sh uses --nocheck.
# Sources are this project's own files, copied in by build-userspace.sh.
pkgname=pico4-sysvsem
pkgver=2
pkgrel=1
arch=(aarch64)
url="https://man.archlinux.org/man/sysvipc.7"
license=(BSL-1.0)
depends=(glibc)
source=(pico4-sysvsem.c pico4-sysvmsg.c test_pico4_sysvsem.c test_pico4_sysvmsg.c)
sha256sums=(SKIP SKIP SKIP SKIP)

build() {
  ${CC:-cc} $CFLAGS -std=c11 -Wall -Wextra -Werror -fPIC -shared -fvisibility=hidden $LDFLAGS \
    -o libpico4-sysvsem.so pico4-sysvsem.c pico4-sysvmsg.c -lpthread
  for test in test_pico4_sysvsem test_pico4_sysvmsg; do
    ${CC:-cc} $CFLAGS -std=c11 -Wall -Wextra -Werror $LDFLAGS -o $test $test.c
    PICO4_SYSVSEM_TABLE="$srcdir/test-table" PICO4_SYSVMSG_TABLE="$srcdir/test-queues" \
      LD_PRELOAD="$srcdir/libpico4-sysvsem.so" ./$test
  done
}

package() {
  install -Dm755 libpico4-sysvsem.so -t "$pkgdir/usr/lib"
}
